<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.Back.BackParticipantFormController"
      spacing="16" prefWidth="500" prefHeight="440"
      style="-fx-background-color:#f8fafc;-fx-padding:28;">

    <Label fx:id="titleLabel" text="➕ Ajouter un participant"
           style="-fx-font-size:20;-fx-font-weight:bold;-fx-text-fill:#0f172a;"/>

    <Label fx:id="errorLabel" text=""
           style="-fx-text-fill:#dc2626;-fx-font-size:12;-fx-background-color:#fee2e2;-fx-padding:8 12;-fx-background-radius:6;"
           wrapText="true" maxWidth="Infinity"/>

    <HBox spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Nom *" style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#374151;"/>
            <TextField fx:id="nomField" promptText="Nom de famille"
                       style="-fx-background-radius:8;-fx-border-color:#d1d5db;-fx-border-radius:8;-fx-padding:9 12;"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Prénom *" style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#374151;"/>
            <TextField fx:id="prenomField" promptText="Prénom"
                       style="-fx-background-radius:8;-fx-border-color:#d1d5db;-fx-border-radius:8;-fx-padding:9 12;"/>
        </VBox>
    </HBox>

    <VBox spacing="4">
        <Label text="Email *" style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#374151;"/>
        <TextField fx:id="emailField" promptText="exemple@email.com"
                   style="-fx-background-radius:8;-fx-border-color:#d1d5db;-fx-border-radius:8;-fx-padding:9 12;"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Rôle *" style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#374151;"/>
        <ComboBox fx:id="roleCombo" maxWidth="Infinity"
                  style="-fx-background-radius:8;-fx-border-color:#d1d5db;"/>
    </VBox>

    <VBox spacing="4">
        <Label text="SMTP Email (optionnel)" style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#374151;"/>
        <TextField fx:id="smtpEmailField" promptText="email smtp pour envoi de mails"
                   style="-fx-background-radius:8;-fx-border-color:#d1d5db;-fx-border-radius:8;-fx-padding:9 12;"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Mot de passe app SMTP (optionnel)" style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#374151;"/>
        <TextField fx:id="smtpPasswordField" promptText="app password gmail"
                   style="-fx-background-radius:8;-fx-border-color:#d1d5db;-fx-border-radius:8;-fx-padding:9 12;"/>
    </VBox>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#handleCancel"
                style="-fx-background-color:#e2e8f0;-fx-text-fill:#374151;-fx-font-weight:600;-fx-background-radius:8;-fx-padding:10 20;"/>
        <Button text="💾 Enregistrer" onAction="#handleSave"
                style="-fx-background-color:#0FB5A9;-fx-text-fill:white;-fx-font-weight:700;-fx-background-radius:8;-fx-padding:10 20;"/>
    </HBox>
</VBox>
