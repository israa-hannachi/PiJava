<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.forum.back.BackForumMessagesController"
            style="-fx-background-color: #f8fafc;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0; -fx-padding: 15;">
            <Label text="NAJA7NI" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
            <Separator orientation="VERTICAL" />
            <Label text="Gestion Messages Forum" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #64748b;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="⬅️ Retour" onAction="#handleBack" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f8fafc;">
            <VBox spacing="20" style="-fx-padding: 25;">

                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                    </columnConstraints>

                    <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"
                          GridPane.columnIndex="0">
                        <Label text="Total Messages" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="totalMessagesLabel" text="—" style="-fx-text-fill: #0f172a; -fx-font-size: 20; -fx-font-weight: bold;" />
                    </VBox>

                    <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"
                          GridPane.columnIndex="1">
                        <Label text="Publiés" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="publieLabel" text="—" style="-fx-text-fill: #16a34a; -fx-font-size: 20; -fx-font-weight: bold;" />
                    </VBox>

                    <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"
                          GridPane.columnIndex="2">
                        <Label text="Modérés" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="modereLabel" text="—" style="-fx-text-fill: #f59e0b; -fx-font-size: 20; -fx-font-weight: bold;" />
                    </VBox>

                    <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"
                          GridPane.columnIndex="3">
                        <Label text="Top Contributeur" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="topContributorLabel" text="—" style="-fx-text-fill: #3b82f6; -fx-font-size: 16; -fx-font-weight: bold;" />
                    </VBox>
                </GridPane>

                <HBox spacing="10">
                    <TextField fx:id="searchField" promptText="🔍 Rechercher..." prefWidth="250"
                               onAction="#handleSearch" />
                    <ComboBox fx:id="filterEtat" prefWidth="120" />
                    <ComboBox fx:id="forumCombo" promptText="Tous forums" prefWidth="150" />
                    <Button text="Filtrer" onAction="#handleSearch" />
                    <Button text="Trier ID" onAction="#sortById" />
                    <Button text="Trier Date" onAction="#sortByDate" />
                    <Button text="Trier État" onAction="#sortByEtat" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="resultCountLabel" text="0 message(s)" />
                </HBox>

                <TableView fx:id="messageTable" prefHeight="300">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                        <TableColumn fx:id="colContenu" text="Contenu" prefWidth="250" />
                        <TableColumn fx:id="colForum" text="Forum" prefWidth="120" />
                        <TableColumn fx:id="colCreatedBy" text="Auteur" prefWidth="100" />
                        <TableColumn fx:id="colEtat" text="État" prefWidth="80" />
                        <TableColumn fx:id="colDate" text="Date" prefWidth="100" />
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="120" />
                    </columns>
                </TableView>

                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                    <Label text="Formulaire Message" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                    
                    <Label fx:id="errorLabel" visible="false" />
                    
                    <GridPane hgap="15" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="80" />
                            <ColumnConstraints prefWidth="400" />
                            <ColumnConstraints prefWidth="80" />
                            <ColumnConstraints prefWidth="150" />
                        </columnConstraints>
                        
                        <Label text="Contenu *" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <TextArea fx:id="contenuField" promptText="Contenu du message" prefRowCount="3" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="3" />
                        
                        <Label text="Auteur *" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                        <TextField fx:id="createdByField" promptText="Nom de l'auteur" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                        
                        <Label text="Forum *" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                        <ComboBox fx:id="forumFormCombo" promptText="Sélectionner..." GridPane.rowIndex="1" GridPane.columnIndex="3" />
                        
                        <Label text="État" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                        <ComboBox fx:id="etatCombo" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                    </GridPane>
                    
                    <HBox spacing="10">
                        <Button text="➕ Ajouter" onAction="#handleAdd" 
                                style="-fx-background-color: #0FB5A9; -fx-text-fill: white; -fx-font-weight: bold;" />
                        <Button text="✏️ Modifier" onAction="#handleUpdate"
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold;" />
                        <Button text="🗑️ Effacer" onAction="#handleClear"
                                style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold;" />
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
