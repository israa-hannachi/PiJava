<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.Back.BackGestionForumsController"
            prefHeight="900.0" prefWidth="1400.0" style="-fx-background-color: #f8fafc;">

    <!-- LEFT SIDEBAR NAVIGATION -->
    <left>
        <VBox id="sidebar" prefWidth="260" style="-fx-background-color: #1a202c; -fx-padding: 0;">
            <!-- Logo Section -->
            <VBox prefHeight="70" alignment="TOP_CENTER" style="-fx-background-color: #0f172a; -fx-padding: 15;">
                <Label text="NAJA7NI ADMIN" style="-fx-font-size:18; -fx-font-weight:bold; -fx-text-fill:white;"/>
            </VBox>

            <!-- Navigation Menu -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: #1a202c;" hbarPolicy="NEVER">
                <VBox spacing="5" style="-fx-padding: 10; -fx-background-color: #1a202c;">
                    <Label text="Navigation" style="-fx-text-fill: #94a3b8; -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 10 0 5 0;" />

                    <!-- Dashboard Menu -->
                    <Button text="🏠 Dashboard" onAction="#handleDashboard" maxWidth="1.7976931348623157E308"
                            style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />

                    <!-- Comptes Menu -->
                    <VBox spacing="0" style="-fx-background-radius: 8; -fx-background-color: #334155;">
                        <Button text="👤 Comptes" onAction="#toggleComptesMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                        <VBox fx:id="comptesSubmenu" spacing="0" style="-fx-background-color: #1a202c;" visible="false" managed="false">
                            <Button text="   Liste des comptes" maxWidth="1.7976931348623157E308"
                                    onAction="#handleListeComptes"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                        </VBox>
                    </VBox>

                    <!-- Cours Menu -->
                    <VBox spacing="0" style="-fx-background-radius: 8; -fx-background-color: #334155;">
                        <Button text="📚 Cours" onAction="#toggleCoursMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                        <VBox fx:id="coursSubmenu" spacing="0" style="-fx-background-color: #1a202c;" visible="false" managed="false">
                            <Button text="   📂 Catégories" onAction="#handleCategories" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                            <Button text="   📦 Modules" onAction="#handleModules" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                            <Button text="   📖 Cours" onAction="#handleCours" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                        </VBox>
                    </VBox>

                    <!-- Jeux Menu -->
                    <VBox spacing="0" style="-fx-background-radius: 8; -fx-background-color: #334155;">
                        <Button text="🎮 Jeux" onAction="#toggleJeuxMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                        <VBox fx:id="jeuxSubmenu" spacing="0" style="-fx-background-color: #1a202c;" visible="false" managed="false">
                            <Button text="   Liste des Jeux" onAction="#handleBackList" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                        </VBox>
                    </VBox>

                    <!-- Forums Menu -->
                    <VBox spacing="0" style="-fx-background-radius: 8; -fx-background-color: #334155;">
                        <Button text="💬 Forums" onAction="#toggleForumMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                        <VBox fx:id="forumSubmenu" spacing="0" style="-fx-background-color: #1a202c;" visible="true" managed="true">
                            <Button text="   📋 Liste des Forums" onAction="#handleForumsList" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #0FB5A9; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                        </VBox>
                    </VBox>

                    <!-- Events Menu -->
                    <VBox spacing="0" style="-fx-background-radius: 8; -fx-background-color: #334155;">
                        <Button text="📅 Events" onAction="#toggleEventsMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                        <VBox fx:id="eventsSubmenu" spacing="0" style="-fx-background-color: #1a202c;" visible="false" managed="false">
                            <Button text="   Liste des Events" onAction="#handleEventsList" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                            <Button text="   Calendrier" onAction="#handleEventsCalendrier" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                            <Button text="   Sponsors" onAction="#handleEventsSponsors" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                            <Button text="   Inscriptions" onAction="#handleEventsInscriptions" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                        </VBox>
                    </VBox>

                    <!-- Meet Menu -->
                    <VBox spacing="0" style="-fx-background-radius: 8; -fx-background-color: #334155;">
                        <Button text="📹 Meet" onAction="#toggleMeetMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                        <VBox fx:id="meetSubmenu" spacing="0" style="-fx-background-color: #1a202c;" visible="false" managed="false">
                            <Button text="   Liste des Meets" onAction="#handleMeet" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                        </VBox>
                    </VBox>

                    <!-- Mailing Menu -->
                    <VBox spacing="0" style="-fx-background-radius: 8; -fx-background-color: #334155;">
                        <Button text="✉️ Mailing" onAction="#toggleMailingMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                        <VBox fx:id="mailingSubmenu" spacing="0" style="-fx-background-color: #1a202c;" visible="false" managed="false">
                            <Button text="   Liste des Mailings" onAction="#handleMailing" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                        </VBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />
                    <Button text="🚪 Logout" onAction="#handleLogout" maxWidth="1.7976931348623157E308"
                            style="-fx-text-fill: #f87171; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: transparent; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                </VBox>
            </ScrollPane>
        </VBox>
    </left>

    <!-- TOP NAVBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0; -fx-padding: 15;">
            <Label text="NAJA7NI" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
            <Separator orientation="VERTICAL" />
            <Label text="Liste des Forums" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #64748b;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="adminNameLabel" text="👑 Admin" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #0FB5A9;" />
            <Button text="👤 Profile" onAction="#handleProfile" />
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: #f8fafc;">

            <!-- Stats Cards -->
            <HBox spacing="15">
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                    <Label text="Total Forums" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                    <Label fx:id="totalForumsLabel" text="0" style="-fx-text-fill: #0f172a; -fx-font-size: 24; -fx-font-weight: bold;" />
                </VBox>
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                    <Label text="Actifs" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                    <Label fx:id="activeForumsLabel" text="0" style="-fx-text-fill: #16a34a; -fx-font-size: 24; -fx-font-weight: bold;" />
                </VBox>
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                    <Label text="Inactifs" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                    <Label fx:id="inactiveForumsLabel" text="0" style="-fx-text-fill: #dc2626; -fx-font-size: 24; -fx-font-weight: bold;" />
                </VBox>
            </HBox>

            <!-- Filters Bar matching the photo -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                <TextField fx:id="searchField" promptText="Rechercher par état" prefWidth="200"
                           style="-fx-background-radius: 6; -fx-border-color: #e5e7eb; -fx-border-radius: 6;" />
                <TextField fx:id="searchCreatorField" promptText="Rechercher par créateur" prefWidth="200"
                           style="-fx-background-radius: 6; -fx-border-color: #e5e7eb; -fx-border-radius: 6;" />
                <ComboBox fx:id="sortByDateCombo" prefWidth="150"
                          style="-fx-background-radius: 6; -fx-border-color: #e5e7eb; -fx-border-radius: 6;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="APPLIQUER" onAction="#handleSearch"
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 20; -fx-cursor: hand;" />
            </HBox>

            <!-- Forums Table -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
                <TableView fx:id="forumsTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10;">
                    <columns>
                        <TableColumn fx:id="idColumn" text="Id" prefWidth="60" />
                        <TableColumn fx:id="titreColumn" text="Titre" prefWidth="350" />
                        <TableColumn fx:id="createdByColumn" text="Créateur" prefWidth="150" />
                        <TableColumn fx:id="dateColumn" text="Date" prefWidth="120" />
                        <TableColumn fx:id="etatColumn" text="État" prefWidth="100" />
                        <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="120" />
                    </columns>
                </TableView>
            </VBox>

            <!-- Result Count -->
            <HBox alignment="CENTER_RIGHT">
                <Label fx:id="resultCountLabel" text="0 forum(s)" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
            </HBox>

            <!-- Formulaire Section -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                <Label text="Gestion Forum" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />

                <Label fx:id="errorLabel" visible="false" />

                <GridPane hgap="15" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="100" />
                        <ColumnConstraints prefWidth="300" />
                        <ColumnConstraints prefWidth="100" />
                        <ColumnConstraints prefWidth="300" />
                    </columnConstraints>

                    <Label text="Titre *" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                    <TextField fx:id="titreField" promptText="Nom du forum" GridPane.rowIndex="0" GridPane.columnIndex="1"
                               style="-fx-background-radius: 6; -fx-border-color: #e5e7eb; -fx-border-radius: 6;" />

                    <Label text="Catégorie *" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;" />
                    <ComboBox fx:id="categorieCombo" promptText="Sélectionner..." GridPane.rowIndex="0" GridPane.columnIndex="3"
                              style="-fx-background-radius: 6; -fx-border-color: #e5e7eb; -fx-border-radius: 6;" />

                    <Label text="Description" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                    <TextArea fx:id="descriptionField" promptText="Description du forum" prefRowCount="2"
                              GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3"
                              style="-fx-background-radius: 6; -fx-border-color: #e5e7eb; -fx-border-radius: 6;" />

                    <Label text="Créé par *" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
                    <TextField fx:id="createdByField" promptText="Nom du créateur" GridPane.rowIndex="2" GridPane.columnIndex="1"
                               style="-fx-background-radius: 6; -fx-border-color: #e5e7eb; -fx-border-radius: 6;" />

                    <Label text="État" GridPane.rowIndex="2" GridPane.columnIndex="2" style="-fx-font-weight: bold;" />
                    <ComboBox fx:id="etatCombo" GridPane.rowIndex="2" GridPane.columnIndex="3"
                              style="-fx-background-radius: 6; -fx-border-color: #e5e7eb; -fx-border-radius: 6;" />
                </GridPane>

                <HBox spacing="10">
                    <Button text="➕ Ajouter" onAction="#handleAdd"
                            style="-fx-background-color: #0FB5A9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" />
                    <Button text="✏️ Modifier" onAction="#handleUpdate"
                            style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" />
                    <Button text="🗑️ Effacer" onAction="#handleClear"
                            style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" />
                </HBox>
            </VBox>

            <!-- Pagination -->
            <HBox alignment="CENTER" spacing="5" style="-fx-padding: 10;">
                <Button text="‹" style="-fx-background-color: #e5e7eb; -fx-background-radius: 50; -fx-min-width: 35; -fx-min-height: 35; -fx-cursor: hand;" />
                <Button text="1" style="-fx-background-color: #0FB5A9; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 35; -fx-min-height: 35; -fx-cursor: hand;" />
                <Button text="2" style="-fx-background-color: #e5e7eb; -fx-background-radius: 50; -fx-min-width: 35; -fx-min-height: 35; -fx-cursor: hand;" />
                <Button text="›" style="-fx-background-color: #e5e7eb; -fx-background-radius: 50; -fx-min-width: 35; -fx-min-height: 35; -fx-cursor: hand;" />
            </HBox>

        </VBox>
    </center>
</BorderPane>
