<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.front.FrontRegisterController"
      prefWidth="1280" prefHeight="800" style="-fx-background-color: #FFFFFF;">

    <VBox prefWidth="580" alignment="CENTER" spacing="18"
          style="-fx-background-color: rgba(15,181,169,0.10);">
        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <Label text="Welcome to our largest community" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #2D3748;"/>
        <Label text="Let's learn something new today!" style="-fx-font-size: 16; -fx-text-fill: #4A5568;"/>
        <Region prefHeight="220" prefWidth="380" style="-fx-background-color: #E6FFFD; -fx-background-radius: 18;"/>
        <Label text="4k+ Students joined us, now it's your turn." style="-fx-font-size: 14; -fx-text-fill: #4A5568;"/>
    </VBox>

    <ScrollPane fitToWidth="true" prefWidth="700" style="-fx-background: #FFFFFF;">
        <content>
            <VBox spacing="12" prefWidth="620">
                <padding>
                    <Insets top="35" right="70" bottom="35" left="70"/>
                </padding>

                <Label text="Sign up for your naja7ni account!" style="-fx-font-size: 28; -fx-font-weight: bold;"/>
                <Label text="Nice to see you! Please Sign up with your account." style="-fx-font-size: 15; -fx-text-fill: #718096;"/>

                <HBox spacing="10">
                    <VBox HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="First Name"/>
                        <TextField fx:id="firstNameField" promptText="First Name"
                                   style="-fx-background-color: #F7FAFC; -fx-background-radius: 10; -fx-padding: 11;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="6">
                        <Label text="Last Name"/>
                        <TextField fx:id="lastNameField" promptText="Last Name"
                                   style="-fx-background-color: #F7FAFC; -fx-background-radius: 10; -fx-padding: 11;"/>
                    </VBox>
                </HBox>

                <Label text="Email address *"/>
                <TextField fx:id="emailField" promptText="E-mail"
                           style="-fx-background-color: #F7FAFC; -fx-background-radius: 10; -fx-padding: 11;"/>

                <Label text="Role"/>
                <ComboBox fx:id="roleCombo" promptText="Select your role"
                          style="-fx-background-color: #F7FAFC; -fx-background-radius: 10;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Student"/>
                            <String fx:value="Enseignant"/>
                        </FXCollections>
                    </items>
                </ComboBox>

                <Label text="Password *"/>
                <PasswordField fx:id="passwordField" promptText="*********"
                               style="-fx-background-color: #F7FAFC; -fx-background-radius: 10; -fx-padding: 11;"/>

                <Label text="Confirm Password *"/>
                <PasswordField fx:id="confirmPasswordField" promptText="*********"
                               style="-fx-background-color: #F7FAFC; -fx-background-radius: 10; -fx-padding: 11;"/>



                <CheckBox fx:id="termsCheck" text="By signing up, you agree to the terms of service"/>

                <Button text="Sign Up" maxWidth="1.7976931348623157E308" onAction="#handleRegister"
                        style="-fx-background-color: #0FB5A9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12;"/>

                <HBox alignment="CENTER" spacing="8">
                    <Separator prefWidth="130"/>
                    <Label text="Or" style="-fx-text-fill: #718096;"/>
                    <Separator prefWidth="130"/>
                </HBox>

                <HBox spacing="10">
                    <Button text="Signup with Google" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #EA4335; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 14;"/>
                    <Button text="Signup with Facebook" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #1877F2; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 14;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="Already have an account?"/>
                    <Hyperlink text="Sign in here" style="-fx-text-fill: #04B6D5;" onAction="#handleSignInLink"/>
                </HBox>
            </VBox>
        </content>
    </ScrollPane>
</HBox>

