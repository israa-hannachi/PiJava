<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.front.EventFrontController"
            prefWidth="1440.0" prefHeight="980.0"
            style="-fx-background-color: #FFFFFF; -fx-font-family: 'Segoe UI';"
            stylesheets="@/tn/esprit/css/front-home.css">

    <left>
        <VBox prefWidth="120.0" spacing="8.0"
              style="-fx-background-color:#F7FFFE; -fx-border-color:rgba(15,181,169,0.10); -fx-border-width:0 1 0 0;">
            <padding><Insets top="14.0" right="8.0" bottom="14.0" left="8.0"/></padding>

            <ImageView fitHeight="62.0" preserveRatio="true" pickOnBounds="true">
                <image><Image url="@/assets/images/logo.png"/></image>
            </ImageView>

            <Button text="🏠 Accueil" onAction="#handleAccueil" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>
            <Button text="👤 Profil" maxWidth="1.7976931348623157E308" onAction="#handleProfile"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>
            <Button text="📚 Cours" maxWidth="1.7976931348623157E308" onAction="#handleCours"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>
            <Button text="🎥 Meet" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>
            <Button text="🎮 Jeux" onAction="#handleGameList" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>
            <Button text="📅 Events" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color:rgba(15,181,169,0.14); -fx-text-fill:#0FB5A9; -fx-font-weight:700; -fx-background-radius:10;"/>
            <Button text="💬 Forums" maxWidth="1.7976931348623157E308" onAction="#handleForums"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>

            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <top>
        <HBox spacing="12.0" alignment="CENTER_LEFT"
              style="-fx-background-color:#FFFFFF; -fx-border-color:rgba(15,181,169,0.12); -fx-border-width:0 0 1 0;">
            <padding><Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/></padding>

            <Label text="Naja7ni" style="-fx-font-size:24px; -fx-font-weight:800; -fx-text-fill:#0FB5A9;" />

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="searchBar" promptText="Rechercher des événements..." prefWidth="420.0"
                       style="-fx-background-color:#F7FFFE; -fx-background-radius:12; -fx-border-color:transparent; -fx-padding:10 14;" />

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="adminButton" text="⚙ Back Office" onAction="#handleBackOffice"
                    visible="false" managed="false"
                    style="-fx-background-color:#1a202c; -fx-text-fill:#f87171; -fx-font-weight:700; -fx-background-radius:8; -fx-padding:8 14;" />
            <Button fx:id="profileButton" text="Profile" onAction="#handleProfile"
                    style="-fx-background-color:linear-gradient(to bottom right, #0FB5A9, #04B6D5); -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:999;" />
        </HBox>
    </top>

    <center>
        <AnchorPane style="-fx-background-color: #F0FFFE;">
            <children>
                <!-- Bloc réservation à gauche -->
                <VBox layoutX="25.0" layoutY="25.0" prefWidth="350.0" spacing="15.0" 
                      style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 10);">
                    
                    <Label text="🎟️ Réservation" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #1e293b;" />
                    
                    <!-- Sélection Preview Area -->
                    <VBox fx:id="selectedEventPreview" spacing="10" 
                          style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                        <Label text="Aucun événement sélectionné" style="-fx-text-fill: #64748b; -fx-font-style: italic;" />
                    </VBox>

                    <VBox spacing="12">
                        <VBox spacing="5">
                            <Label text="Nom Complet" style="-fx-font-weight: 700; -fx-text-fill: #475569;" />
                            <TextField fx:id="visitorName" promptText="Ex: Jean Dupont" styleClass="modern-textfield" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Email Professionnel" style="-fx-font-weight: 700; -fx-text-fill: #475569;" />
                            <TextField fx:id="visitorEmail" promptText="exemple@domain.com" styleClass="modern-textfield" />
                        </VBox>
                        <HBox spacing="10">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Tickets" style="-fx-font-weight: 700; -fx-text-fill: #475569;" />
                                <TextField fx:id="nbrTickets" promptText="0" styleClass="modern-textfield" />
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Téléphone" style="-fx-font-weight: 700; -fx-text-fill: #475569;" />
                                <TextField fx:id="numTel" promptText="XXXXXXXX" styleClass="modern-textfield" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <Button onAction="#reserver" maxWidth="1.7976931348623157E308" 
                            style="-fx-background-color: linear-gradient(to right, #0FB5A9, #0891b2); -fx-text-fill: white; -fx-font-weight: 800; -fx-padding: 14; -fx-background-radius: 12; -fx-cursor: hand;" 
                            text="Confirmer la Réservation" />
                    
                    <Label fx:id="feedbackLabel" style="-fx-font-size: 13px; -fx-font-weight: 500;" wrapText="true" />
                    
                    <Separator style="-fx-opacity: 0.5;" />
                    
                    <Label style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #1e293b;" text="🤝 Partenaires Officiels" />
                    <FlowPane fx:id="sponsorContainer" hgap="8.0" prefWrapLength="280.0" vgap="8.0" />
                    
                    <Button onAction="#openWebPageCit" maxWidth="1.7976931348623157E308" 
                            style="-fx-background-color: #f5f3ff; -fx-text-fill: #7c3aed; -fx-font-weight: 700; -fx-background-radius: 10; -fx-border-color: #ddd6fe; -fx-border-radius: 10;" 
                            text="📅 Ajouter au Calendrier">
                    </Button>
                </VBox>

                <!-- Zone principale : Events -->
                <VBox layoutX="400.0" layoutY="25.0" prefWidth="990.0" spacing="20">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox spacing="5">
                            <Label text="🎉 Explorez nos événements" style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #0f172a;" />
                            <Label text="Ne manquez pas les opportunités d'apprendre avec nos experts." style="-fx-font-size: 16px; -fx-text-fill: #64748b;" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#voirTickets" style="-fx-background-color: white; -fx-border-color: #0FB5A9; -fx-border-radius: 20; -fx-background-radius: 20; -fx-text-fill: #0FB5A9; -fx-font-weight: bold; -fx-padding: 8 20;" text="🎫 Mes Tickets" />
                    </HBox>

                    <!-- Section Recommandations (Collapsible) -->
                    <VBox fx:id="forYouBox" managed="false" spacing="15" 
                          style="-fx-background-color: linear-gradient(to right, #ffffff, #f0f9ff); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: #0FB5A9; -fx-border-width: 1; -fx-border-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(15,181,169,0.1), 15, 0, 0, 5);" 
                          visible="false">
                        <Label fx:id="labelForYou" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #0FB5A9;" text="✨ Recommandations personnalisées" />
                        <FlowPane fx:id="recommendedEventContainer" hgap="20.0" prefWrapLength="930.0" vgap="20.0" />
                    </VBox>

                    <!-- Events Loader & Pagination -->
                    <VBox spacing="30" VBox.vgrow="ALWAYS">
                        <FlowPane fx:id="eventContainer" hgap="25.0" prefWrapLength="950.0" vgap="25.0" />
                        
                        <HBox alignment="CENTER" style="-fx-padding: 20 0;">
                            <Pagination fx:id="pagination" maxPageIndicatorCount="5" pageCount="1" />
                        </HBox>
                    </VBox>
                </VBox>
            </children>
        </AnchorPane>
    </center>

</BorderPane>