<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootBox" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.ChatbotController"
      style="-fx-background-color: #f8fafc;">

    <!-- Header -->
    <StackPane fx:id="headerBox" prefHeight="70" style="-fx-background-color: white; -fx-padding: 0 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
        
        <!-- Center: Title perfectly centered over the full width -->
        <Label fx:id="titleLabel" text="Assistant IA" StackPane.alignment="CENTER"
               style="-fx-text-fill: linear-gradient(to right, #0FB5A9, #8B5CF6); -fx-font-size: 26; -fx-font-weight: 900; -fx-effect: dropshadow(gaussian, rgba(15,181,169,0.3), 8, 0, 0, 3); -fx-border-color: linear-gradient(to right, #0FB5A9, #8B5CF6); -fx-border-width: 3; -fx-border-radius: 12; -fx-padding: 8 25; -fx-background-color: rgba(15, 181, 169, 0.05); -fx-background-radius: 12;"/>
               
        <!-- Left and Right Controls -->
        <BorderPane>
            <left>
                <Button fx:id="backButton" text="← Retour" onAction="#handleBack" BorderPane.alignment="CENTER_LEFT"
                        style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-size: 14; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </left>
            <right>
                <HBox alignment="CENTER_RIGHT" spacing="15" BorderPane.alignment="CENTER_RIGHT">
                    <Button fx:id="themeToggleButton" text="🌙" onAction="#toggleTheme"
                            style="-fx-background-color: transparent; -fx-font-size: 20; -fx-cursor: hand; -fx-padding: 0 10 0 0;"/>
                    <Label fx:id="globeIcon" text="🌐" style="-fx-font-size: 20;"/>
                    <ComboBox fx:id="languageSelector" promptText="Langue" 
                              style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-font-size: 14; -fx-padding: 2;"/>
                </HBox>
            </right>
        </BorderPane>
    </StackPane>

    <!-- Messages Area -->
    <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" 
               VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-width: 0;">
        <VBox alignment="TOP_CENTER">
            <VBox fx:id="messagesBox" spacing="15" maxWidth="800" style="-fx-padding: 30 20;">
                <!-- Messages will be added dynamically -->
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- Input Area -->
    <VBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20;">
        <HBox alignment="CENTER" spacing="15" maxWidth="800" style="-fx-background-color: #f8f9fa; -fx-border-color: #e2e8f0; -fx-border-radius: 24; -fx-padding: 5 15; -fx-background-radius: 24;">
            <TextField fx:id="messageInput" promptText="Posez votre question à l'IA..." 
                       HBox.hgrow="ALWAYS" prefHeight="50"
                       style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 15;"/>
            <Button fx:id="micButton" text="🎤" onAction="#handleVoiceInput" prefWidth="40" prefHeight="40"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-size: 18; -fx-cursor: hand; -fx-background-radius: 20;"/>
            <Button fx:id="sendButton" text="Envoyer" prefWidth="90" prefHeight="40"
                    style="-fx-background-color: #0FB5A9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand; -fx-font-size: 14;"/>
        </HBox>
        <Label text="L'IA peut faire des erreurs. Vérifiez les informations importantes." style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-padding: 10 0 0 0;"/>
    </VBox>

</VBox> 
