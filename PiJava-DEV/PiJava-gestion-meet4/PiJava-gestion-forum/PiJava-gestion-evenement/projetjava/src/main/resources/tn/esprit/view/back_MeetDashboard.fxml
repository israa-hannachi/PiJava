<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.Back.AdminMeetDashboardController">

    <!-- LEFT SIDEBAR NAVIGATION -->
    <left>
        <VBox id="sidebar" prefWidth="260" style="-fx-background-color: #1a202c; -fx-padding: 0;">

            <!-- Logo Section -->
            <VBox prefHeight="70" alignment="TOP_CENTER" style="-fx-background-color: #0f172a; -fx-padding: 15;">
                <Label text="NAJA7NI ADMIN" style="-fx-font-size:18; -fx-font-weight:bold; -fx-text-fill:white;"/>
            </VBox>

            <!-- Navigation Menu -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: #1a202c;">
                <VBox spacing="5" style="-fx-padding: 10; -fx-background-color: #1a202c;">

                    <Label text="Navigation" style="-fx-text-fill: #94a3b8; -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 10 0 5 0;" />

                    <!-- Dashboard Menu -->
                    <Button text="🏠 Dashboard" onAction="#handleDashboard" maxWidth="1.7976931348623157E308"
                            style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: transparent; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />

                    <!-- Meet Menu -->
                    <VBox spacing="0" style="-fx-background-radius: 8; -fx-background-color: #334155;">
                        <Button text="📹 Meet" onAction="#toggleMeetMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                        <VBox fx:id="meetSubmenu" spacing="0" style="-fx-background-color: #1a202c;" visible="true" managed="true">
                            <Button text="   Dashboard Meet" maxWidth="1.7976931348623157E308"
                                    style="-fx-text-fill: #94a3b8; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent; -fx-font-weight: bold;" />
                            <Button text="   👥 Participants" maxWidth="1.7976931348623157E308"
                                    onAction="#handleParticipants"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                            <Button text="   📋 Réunions" maxWidth="1.7976931348623157E308"
                                    onAction="#handleMeetList"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                        </VBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <!-- Logout Button -->
                    <Button text="🚪 Logout" onAction="#handleLogout" maxWidth="1.7976931348623157E308"
                            style="-fx-text-fill: #f87171; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: transparent; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                </VBox>
            </ScrollPane>
        </VBox>
    </left>

    <!-- TOP NAVBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0; -fx-padding: 15;">
            <Label text="NAJA7NI" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
            <Separator orientation="VERTICAL" />
            <Label text="Dashboard Meet / Analytics" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #64748b;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="adminNameLabel" text="Admin"
                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #64748b;" />
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f8fafc;">
            <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: #f8fafc;">

                <!-- Page Header with Title & Actions -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="Dashboard Statistiques Meet" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <HBox spacing="10">
                            <Label text="Admin >" style="-fx-text-fill: #64748b; -fx-font-size: 13;" />
                            <Label text="Meet >" style="-fx-text-fill: #64748b; -fx-font-size: 13;" />
                            <Label text="Analytics" style="-fx-text-fill: #475569; -fx-font-size: 13; -fx-font-weight: bold;" />
                        </HBox>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="exportCsvBtn" text="Export CSV" onAction="#exportToCsv"
                            style="-fx-background-color: #475569; -fx-text-fill: white; -fx-font-size: 13; -fx-padding: 10 20; -fx-background-radius: 6;" />
                </HBox>

                <!-- Filters Card -->
                <VBox spacing="15" style="-fx-border-color: #e2e8f0; -fx-background-color: white; -fx-background-radius: 12; -fx-border-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                    <Label text="Filtres" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <VBox spacing="5">
                            <Label text="Période" style="-fx-text-fill: #64748b; -fx-font-size: 11;" />
                            <ComboBox fx:id="periodCombo" prefWidth="150" style="-fx-background-color: #f1f5f9; -fx-background-radius: 6;" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Date début" style="-fx-text-fill: #64748b; -fx-font-size: 11;" />
                            <DatePicker fx:id="fromDate" style="-fx-background-color: #f1f5f9;" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Date fin" style="-fx-text-fill: #64748b; -fx-font-size: 11;" />
                            <DatePicker fx:id="toDate" style="-fx-background-color: #f1f5f9;" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Enseignant" style="-fx-text-fill: #64748b; -fx-font-size: 11;" />
                            <ComboBox fx:id="teacherCombo" prefWidth="180" style="-fx-background-color: #f1f5f9; -fx-background-radius: 6;" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="applyFilterBtn" text="Appliquer" onAction="#loadDashboardData"
                                style="-fx-background-color: #334155; -fx-text-fill: white; -fx-font-size: 13; -fx-padding: 10 20; -fx-background-radius: 6;" />
                    </HBox>
                </VBox>

                <!-- KPI Cards Grid -->
                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="20" />
                        <ColumnConstraints percentWidth="20" />
                    </columnConstraints>

                    <!-- Card 1: Total Réunions -->
                    <VBox style="-fx-border-color: #e2e8f0; -fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);" GridPane.columnIndex="0">
                        <Label text="Total Réunions" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label fx:id="kpiTotalMeets" text="—" style="-fx-text-fill: #1e293b; -fx-font-size: 28; -fx-font-weight: bold;" />
                            <Label fx:id="kpiTrendMeets" text="+0%" style="-fx-text-fill: #64748b; -fx-font-size: 11; -fx-padding: 2 6; -fx-background-color: #f1f5f9; -fx-background-radius: 4;" />
                        </HBox>
                        <Label text="vs période précédente" style="-fx-text-fill: #94a3b8; -fx-font-size: 10;" />
                    </VBox>

                    <!-- Card 2: À venir -->
                    <VBox style="-fx-border-color: #e2e8f0; -fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);" GridPane.columnIndex="1">
                        <Label text="A venir" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="kpiUpcoming" text="—" style="-fx-text-fill: #475569; -fx-font-size: 28; -fx-font-weight: bold;" />
                        <ProgressBar progress="0.6" maxWidth="1.7976931348623157E308" style="-fx-accent: #64748b;" />
                    </VBox>

                    <!-- Card 3: En cours -->
                    <VBox style="-fx-border-color: #e2e8f0; -fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);" GridPane.columnIndex="2">
                        <Label text="En cours" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="kpiCurrent" text="—" style="-fx-text-fill: #475569; -fx-font-size: 28; -fx-font-weight: bold;" />
                        <ProgressBar progress="0.3" maxWidth="1.7976931348623157E308" style="-fx-accent: #475569;" />
                    </VBox>

                    <!-- Card 4: Terminées -->
                    <VBox style="-fx-border-color: #e2e8f0; -fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);" GridPane.columnIndex="3">
                        <Label text="Terminees" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="kpiCompleted" text="—" style="-fx-text-fill: #475569; -fx-font-size: 28; -fx-font-weight: bold;" />
                        <ProgressBar progress="0.8" maxWidth="1.7976931348623157E308" style="-fx-accent: #475569;" />
                    </VBox>

                    <!-- Card 5: Participants -->
                    <VBox style="-fx-border-color: #e2e8f0; -fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);" GridPane.columnIndex="4">
                        <Label text="Participants" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Label fx:id="kpiParticipants" text="—" style="-fx-text-fill: #1e293b; -fx-font-size: 28; -fx-font-weight: bold;" />
                            <Label text="(" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" />
                            <Label fx:id="kpiAvgParticipants" text="—" style="-fx-text-fill: #475569; -fx-font-size: 12;" />
                            <Label text="moy/réunion)" style="-fx-text-fill: #94a3b8; -fx-font-size: 10;" />
                        </HBox>
                        <ProgressBar progress="0.5" maxWidth="1.7976931348623157E308" style="-fx-accent: #64748b;" />
                    </VBox>
                </GridPane>

                <!-- Second Row KPIs -->
                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33" />
                        <ColumnConstraints percentWidth="33.33" />
                        <ColumnConstraints percentWidth="33.33" />
                    </columnConstraints>

                    <!-- Durée totale -->
                    <VBox style="-fx-border-color: #e2e8f0; -fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);" GridPane.columnIndex="0">
                        <Label text="Duree Totale" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label fx:id="kpiTotalHours" text="—" style="-fx-text-fill: #475569; -fx-font-size: 24; -fx-font-weight: bold;" />
                        </HBox>
                        <Label text="heures de réunions" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" />
                    </VBox>

                    <!-- Durée moyenne -->
                    <VBox style="-fx-border-color: #e2e8f0; -fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);" GridPane.columnIndex="1">
                        <Label text="Duree Moyenne" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="kpiAvgDuration" text="—" style="-fx-text-fill: #475569; -fx-font-size: 24; -fx-font-weight: bold;" />
                        <Label text="par réunion" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" />
                    </VBox>

                    <!-- Prochaine réunion -->
                    <VBox style="-fx-border-color: #e2e8f0; -fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);" GridPane.columnIndex="2">
                        <Label text="Prochaine Reunion" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="kpiNextMeet" text="—" wrapText="true" style="-fx-text-fill: #475569; -fx-font-size: 13; -fx-font-weight: bold;" />
                    </VBox>
                </GridPane>

                <!-- Charts Section -->
                <HBox spacing="20">
                    <!-- Daily Chart (Area) -->
                    <VBox spacing="10" style="-fx-border-color: #e2e8f0; -fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);" HBox.hgrow="ALWAYS">
                        <Label text="Reunions par jour" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <AreaChart fx:id="dailyChart" prefHeight="250" VBox.vgrow="ALWAYS">
                            <xAxis>
                                <CategoryAxis label="Date" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Nombre" />
                            </yAxis>
                        </AreaChart>
                    </VBox>

                    <!-- Status Chart (Pie) -->
                    <VBox spacing="10" style="-fx-border-color: #e2e8f0; -fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);" prefWidth="350">
                        <Label text="Repartition par statut" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <PieChart fx:id="statusChart" prefHeight="250" />
                    </VBox>
                </HBox>

                <!-- Bottom Row: Hourly Chart + Top Teachers -->
                <HBox spacing="20">
                    <!-- Hourly Chart (Bar) -->
                    <VBox spacing="10" style="-fx-border-color: #e2e8f0; -fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);" HBox.hgrow="ALWAYS">
                        <Label text="Reunions par heure (0-23h)" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <BarChart fx:id="hourlyChart" prefHeight="200" VBox.vgrow="ALWAYS">
                            <xAxis>
                                <CategoryAxis label="Heure" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Nombre" />
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <!-- Top Teachers Table -->
                    <VBox spacing="10" style="-fx-border-color: #e2e8f0; -fx-background-color: white; -fx-background-radius: 6; -fx-border-radius: 6; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);" prefWidth="350">
                        <Label text="Top Enseignants" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <TableView fx:id="topTeachersTable" prefHeight="200">
                            <columns>
                                <TableColumn fx:id="colTeacherName" text="Enseignant" prefWidth="230" />
                                <TableColumn fx:id="colTeacherMeets" text="Réunions" prefWidth="80" />
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>

                <!-- Footer Info -->
                <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20 0;">
                    <Label text="Cliquez sur 'Appliquer' pour actualiser les données. Exportez en CSV pour une analyse externe." style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" />
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
