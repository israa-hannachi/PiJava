<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>


<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.forum.back.BackForumCategoriesController"
            style="-fx-background-color: #f8fafc;">

    <top>
        <HBox fx:id="topBar" alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0; -fx-padding: 15;">
            <Label text="NAJA7NI" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
            <Separator orientation="VERTICAL" />
            <Label text="Gestion Catégories Forum" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #64748b;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="⬅️ Retour" onAction="#handleBack"
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #f8fafc;">
            <VBox spacing="20" style="-fx-padding: 25;">

                <!-- LIST CONTAINER -->
                <VBox fx:id="listContainer" spacing="20" VBox.vgrow="ALWAYS">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="🏠 Retour Dashboard" onAction="#handleBack"
                                style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 20; -fx-cursor: hand;" />
                        <Button text="➕ Ajouter une catégorie" onAction="#showCreateForm"
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 20; -fx-cursor: hand;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="searchField" promptText="🔍 Rechercher..." prefWidth="300" prefHeight="40"
                                   onAction="#handleSearch" style="-fx-background-radius: 6; -fx-border-color: #e2e8f0; -fx-border-radius: 6;" />
                        <Button text="Rechercher" onAction="#handleSearch" prefHeight="40"
                                style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-cursor: hand;" />
                        <Button text="Trier par Titre" onAction="#sortByTitre" prefHeight="40"
                                style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-cursor: hand;" />
                    </HBox>

                    <TableView fx:id="categorieTable" VBox.vgrow="ALWAYS" prefHeight="500" style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colTitre" text="Titre" prefWidth="200" />
                            <TableColumn fx:id="colDescription" text="Description" prefWidth="400" />
                            <TableColumn fx:id="colIcone" text="Icône" prefWidth="150" />
                            <TableColumn fx:id="colActions" text="Actions" prefWidth="150" />
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT">
                        <Label fx:id="resultCountLabel" text="0 catégorie(s)" style="-fx-text-fill: #64748b; -fx-font-size: 13;" />
                    </HBox>
                </VBox>

                <!-- FORM CONTAINER - Enlarged for "toute la page" -->
                <!-- FORM CONTAINER - Modern Design -->
                <AnchorPane fx:id="formContainer" visible="false" managed="false" 
                            prefWidth="960" prefHeight="650"
                            style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #fffbf0, #fff7ed, #fef9f0); -fx-background-radius: 20;">

                    <!-- Decorative background blobs -->
                    <Circle radius="100" fill="#fde68a33" stroke="transparent"
                             AnchorPane.topAnchor="-50" AnchorPane.rightAnchor="-30"/>
                    <Circle radius="80" fill="#fed7aa33" stroke="transparent"
                             AnchorPane.bottomAnchor="-30" AnchorPane.leftAnchor="20"/>
                    <Circle radius="40" fill="#fca5a533" stroke="transparent"
                             AnchorPane.topAnchor="200" AnchorPane.rightAnchor="10"/>

                    <!-- Main card -->
                    <VBox spacing="0"
                          AnchorPane.topAnchor="36" AnchorPane.bottomAnchor="36"
                          AnchorPane.leftAnchor="52" AnchorPane.rightAnchor="52"
                          style="-fx-background-color: rgba(255,255,255,0.85);
                                 -fx-background-radius: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(245,158,11,0.12), 30, 0, 0, 8);
                                 -fx-padding: 34 38 28 38;">

                        <!-- ═══ HEADER ═══ -->
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <!-- Icon badge -->
                            <StackPane prefWidth="50" prefHeight="50"
                                       style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #f59e0b, #ef4444);
                                              -fx-background-radius: 14;
                                              -fx-effect: dropshadow(gaussian, rgba(245,158,11,0.40), 18, 0, 0, 5);">
                                <Label text="🗂️" style="-fx-font-size: 22;"/>
                            </StackPane>

                            <VBox spacing="4">
                                <Label text="Formulaire Catégorie"
                                       style="-fx-font-family: 'Sora';
                                              -fx-font-size: 26;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #1c0a00;"/>
                                <Label text="Gérez les catégories de discussion pour organiser votre forum."
                                       style="-fx-font-family: 'DM Sans';
                                              -fx-font-size: 13;
                                              -fx-text-fill: #92400e;"/>
                            </VBox>
                        </HBox>

                        <!-- Dot accent row -->
                        <HBox spacing="4" style="-fx-padding: 12 0 4 64;">
                            <Circle radius="4" fill="#f59e0b"/>
                            <Circle radius="4" fill="#fb923c"/>
                            <Circle radius="4" fill="#ef4444"/>
                            <Rectangle width="28" height="8" arcWidth="6" arcHeight="6" fill="#fde68a"/>
                        </HBox>

                        <!-- Gradient separator -->
                        <Pane prefHeight="2" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #fde68a, #fed7aa, transparent); -fx-padding: 0 0 14 0;"/>
                        
                        <!-- Error Label (added for controller compatibility) -->
                        <Label fx:id="errorLabel" visible="false" style="-fx-text-fill: #ef4444; -fx-font-family: 'DM Sans'; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>

                        <!-- Section tag -->
                        <HBox style="-fx-padding: 10 0 18 0;">
                            <Label text="✦  Détails de la catégorie"
                                   style="-fx-font-family: 'DM Sans';
                                          -fx-font-size: 11;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #b45309;
                                          -fx-background-color: #fff7ed;
                                          -fx-border-color: #fed7aa;
                                          -fx-border-radius: 20;
                                          -fx-background-radius: 20;
                                          -fx-border-width: 1;
                                          -fx-padding: 4 12;"/>
                        </HBox>

                        <!-- ═══ FIELDS ═══ -->
                        <HBox spacing="0" style="-fx-padding: 0 0 0 0;">
                            <!-- Vertical accent bar -->
                            <Pane prefWidth="3" style="-fx-background-color: linear-gradient(from 0% 0% to 0% 100%, #fbbf24, #fb923c); -fx-background-radius: 2;"/>

                            <VBox spacing="0" HBox.hgrow="ALWAYS" style="-fx-padding: 0 0 0 16;">
                                <!-- Titre de la catégorie -->
                                <HBox spacing="0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 14 0;">
                                    <HBox minWidth="160" alignment="CENTER_LEFT" spacing="6">
                                        <Label text="✏️" style="-fx-font-size: 13;"/>
                                        <Label text="Titre de la catégorie"
                                               style="-fx-font-family: 'DM Sans';
                                                      -fx-font-size: 13;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #78350f;"/>
                                        <Label text="*" style="-fx-text-fill: #ef4444; -fx-font-size: 15;"/>
                                    </HBox>
                                    <TextField fx:id="titreField" promptText="Ex: Développement Web"
                                               HBox.hgrow="ALWAYS"
                                               style="-fx-font-family: 'DM Sans';
                                                      -fx-font-size: 13;
                                                      -fx-background-color: white;
                                                      -fx-border-color: #f59e0b;
                                                      -fx-border-radius: 10;
                                                      -fx-background-radius: 10;
                                                      -fx-border-width: 1.5;
                                                      -fx-padding: 10 14;
                                                      -fx-effect: dropshadow(gaussian, rgba(245,158,11,0.15), 8, 0, 0, 2);"/>
                                </HBox>

                                <!-- Description détaillée -->
                                <HBox spacing="0" alignment="TOP_LEFT" style="-fx-padding: 0 0 14 0;">
                                    <HBox minWidth="160" alignment="TOP_LEFT" spacing="6" style="-fx-padding: 10 0 0 0;">
                                        <Label text="📄" style="-fx-font-size: 13;"/>
                                        <Label text="Description détaillée"
                                               style="-fx-font-family: 'DM Sans';
                                                      -fx-font-size: 13;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #78350f;"/>
                                    </HBox>
                                    <TextArea fx:id="descriptionField" promptText="Décrivez l'usage de cette catégorie..."
                                              prefHeight="90" wrapText="true"
                                              HBox.hgrow="ALWAYS"
                                              style="-fx-font-family: 'DM Sans';
                                                     -fx-font-size: 13;
                                                     -fx-background-color: white;
                                                     -fx-border-color: #fde68a;
                                                     -fx-border-radius: 10;
                                                     -fx-background-radius: 10;
                                                     -fx-border-width: 1.5;
                                                     -fx-padding: 10 14;
                                                     -fx-effect: dropshadow(gaussian, rgba(245,158,11,0.10), 6, 0, 0, 1);"/>
                                </HBox>

                                <!-- Icône (URL) -->
                                <HBox spacing="0" alignment="CENTER_LEFT">
                                    <HBox minWidth="160" alignment="CENTER_LEFT" spacing="6">
                                        <Label text="🖼️" style="-fx-font-size: 13;"/>
                                        <Label text="Icône (URL)"
                                               style="-fx-font-family: 'DM Sans';
                                                      -fx-font-size: 13;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: #78350f;"/>
                                    </HBox>
                                    <TextField fx:id="iconeField" promptText="Ex: category.png"
                                               HBox.hgrow="ALWAYS"
                                               style="-fx-font-family: 'DM Sans';
                                                      -fx-font-size: 13;
                                                      -fx-background-color: white;
                                                      -fx-border-color: #fde68a;
                                                      -fx-border-radius: 10;
                                                      -fx-background-radius: 10;
                                                      -fx-border-width: 1.5;
                                                      -fx-padding: 10 14;
                                                      -fx-effect: dropshadow(gaussian, rgba(245,158,11,0.10), 6, 0, 0, 1);"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <Region VBox.vgrow="ALWAYS"/>
                        <Pane prefHeight="1.5" style="-fx-background-color: #fde68a; -fx-padding: 0;"/>

                        <!-- ═══ ACTION BUTTONS ═══ -->
                        <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 20 0 0 0;">
                            <Button text="⬅ Retour" onAction="#handleBack"
                                    style="-fx-font-family: 'DM Sans'; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-color: white; -fx-border-color: #d6d3d1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-text-fill: #57534e; -fx-padding: 10 18; -fx-cursor: hand;"/>

                            <Region HBox.hgrow="ALWAYS" />

                            <Button text="✕  Annuler" onAction="#showList"
                                    style="-fx-font-family: 'DM Sans'; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-color: #fff5f5; -fx-border-color: #fca5a5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-text-fill: #dc2626; -fx-padding: 10 18; -fx-cursor: hand;"/>

                            <Button text="🗑  Effacer" onAction="#handleClear"
                                    style="-fx-font-family: 'DM Sans'; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-color: #f9f7f5; -fx-border-color: #d6d3d1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-text-fill: #57534e; -fx-padding: 10 18; -fx-cursor: hand;"/>

                            <Button fx:id="addBtn" text="+  Ajouter" onAction="#handleAdd"
                                    style="-fx-font-family: 'DM Sans'; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #f59e0b, #ef4444); -fx-background-radius: 10; -fx-border-radius: 10; -fx-text-fill: white; -fx-padding: 10 24; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(245,158,11,0.45), 16, 0, 0, 4);"/>

                            <Button fx:id="updateBtn" text="✏️ Modifier" onAction="#handleUpdate"
                                    style="-fx-font-family: 'DM Sans'; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-color: #3b82f6; -fx-background-radius: 10; -fx-border-radius: 10; -fx-text-fill: white; -fx-padding: 10 24; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.45), 16, 0, 0, 4);"/>
                        </HBox>
                    </VBox>
                </AnchorPane>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
