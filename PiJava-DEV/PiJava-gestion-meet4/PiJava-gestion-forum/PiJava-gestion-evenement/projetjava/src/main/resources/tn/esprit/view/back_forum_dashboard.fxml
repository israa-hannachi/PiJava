<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.Back.BackForumsDashboardController"
      spacing="0" prefWidth="1100" prefHeight="680"
      style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #f0fdf9, #ecfdf5, #f7fffe);">

    <!-- ═══ TOP NAV BAR ═══ -->
    <HBox alignment="CENTER_LEFT" prefHeight="58" spacing="0"
          style="-fx-background-color: white;
                 -fx-border-color: transparent transparent #d1fae5 transparent;
                 -fx-border-width: 0 0 1.5 0;
                 -fx-padding: 0 28;">

        <!-- Brand -->
        <Label text="NAJA7NI"
               style="-fx-font-family: 'Cabinet Grotesk';
                      -fx-font-size: 20;
                      -fx-font-weight: bold;
                      -fx-text-fill: #000000;"/>

        <Pane prefWidth="12"/>
        <Rectangle width="1.5" height="22" fill="#d1fae5"/>
        <Pane prefWidth="12"/>

        <Label text="Dashboard Forums"
               style="-fx-font-family: 'Inter';
                      -fx-font-size: 13;
                      -fx-font-weight: 500;
                      -fx-text-fill: #000000;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Dashboard button -->
        <Button text="⌂  Dashboard" onAction="#handleDashboard"
                style="-fx-font-family: 'Inter';
                       -fx-font-size: 12;
                       -fx-font-weight: bold;
                       -fx-background-color: #ecfdf5;
                       -fx-border-color: #6ee7b7;
                       -fx-border-radius: 8;
                       -fx-background-radius: 8;
                       -fx-border-width: 1.5;
                       -fx-text-fill: #065f46;
                       -fx-padding: 6 14;
                       -fx-cursor: hand;"/>

        <Pane prefWidth="8"/>

        <!-- Logout button -->
        <Button text="⏻  Logout" onAction="#handleLogout"
                style="-fx-font-family: 'Inter';
                       -fx-font-size: 12;
                       -fx-font-weight: bold;
                       -fx-background-color: #fff5f5;
                       -fx-border-color: #fca5a5;
                       -fx-border-radius: 8;
                       -fx-background-radius: 8;
                       -fx-border-width: 1.5;
                       -fx-text-fill: #dc2626;
                       -fx-padding: 6 14;
                       -fx-cursor: hand;"/>
    </HBox>

    <!-- ═══ BODY ═══ -->
    <VBox spacing="0" VBox.vgrow="ALWAYS"
          style="-fx-padding: 28 28 24 28;">

        <!-- Page Title -->
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 4 0;">
            <Label text="Dashboard Forum"
                   style="-fx-font-family: 'Cabinet Grotesk';
                          -fx-font-size: 26;
                          -fx-font-weight: bold;
                          -fx-text-fill: #000000;"/>
            <Label text="LIVE"
                   style="-fx-font-family: 'Inter';
                          -fx-font-size: 11;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;
                          -fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #10b981, #059669);
                          -fx-background-radius: 20;
                          -fx-padding: 3 10;"/>
        </HBox>
        <Label text="Vue d'ensemble de votre espace de discussion Naja7ni"
               style="-fx-font-family: 'Inter';
                      -fx-font-size: 13;
                      -fx-text-fill: #000000;
                      -fx-padding: 0 0 20 0;"/>

        <!-- ═══ STAT CARDS ═══ -->
        <HBox spacing="14" style="-fx-padding: 0 0 22 0;">

            <!-- Catégories -->
            <VBox spacing="6" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #ecfdf5, #d1fae5);
                         -fx-border-color: #6ee7b7;
                         -fx-border-width: 1.5;
                         -fx-border-radius: 14;
                         -fx-background-radius: 14;
                         -fx-padding: 18 20 20 20;
                         -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.10), 12, 0, 0, 3);">
                <Label text="🗂️" style="-fx-font-size: 16;"/>
                <Label text="CATÉGORIES"
                       style="-fx-font-family: 'Inter'; -fx-font-size: 11; -fx-font-weight: bold;
                              -fx-text-fill: #065f46; -fx-letter-spacing: 0.6;"/>
                <Label fx:id="totalCategoriesLabel" text="35"
                       style="-fx-font-family: 'Cabinet Grotesk'; -fx-font-size: 40;
                              -fx-font-weight: bold; -fx-text-fill: #047857;"/>
                <Pane prefHeight="3"
                      style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #10b981, #34d399);
                             -fx-background-radius: 2;"/>
            </VBox>

            <!-- Forums -->
            <VBox spacing="6" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #eff6ff, #dbeafe);
                         -fx-border-color: #93c5fd;
                         -fx-border-width: 1.5;
                         -fx-border-radius: 14;
                         -fx-background-radius: 14;
                         -fx-padding: 18 20 20 20;
                         -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.10), 12, 0, 0, 3);">
                <Label text="💬" style="-fx-font-size: 16;"/>
                <Label text="FORUMS"
                       style="-fx-font-family: 'Inter'; -fx-font-size: 11; -fx-font-weight: bold;
                              -fx-text-fill: #1e40af; -fx-letter-spacing: 0.6;"/>
                <Label fx:id="totalForumsLabel" text="14"
                       style="-fx-font-family: 'Cabinet Grotesk'; -fx-font-size: 40;
                              -fx-font-weight: bold; -fx-text-fill: #1d4ed8;"/>
                <Pane prefHeight="3"
                      style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #3b82f6, #60a5fa);
                             -fx-background-radius: 2;"/>
            </VBox>

            <!-- Messages -->
            <VBox spacing="6" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #fff7ed, #ffedd5);
                         -fx-border-color: #fdba74;
                         -fx-border-width: 1.5;
                         -fx-border-radius: 14;
                         -fx-background-radius: 14;
                         -fx-padding: 18 20 20 20;
                         -fx-effect: dropshadow(gaussian, rgba(249,115,22,0.10), 12, 0, 0, 3);">
                <Label text="✉️" style="-fx-font-size: 16;"/>
                <Label text="MESSAGES"
                       style="-fx-font-family: 'Inter'; -fx-font-size: 11; -fx-font-weight: bold;
                              -fx-text-fill: #9a3412; -fx-letter-spacing: 0.6;"/>
                <Label fx:id="totalMessagesLabel" text="68"
                       style="-fx-font-family: 'Cabinet Grotesk'; -fx-font-size: 40;
                              -fx-font-weight: bold; -fx-text-fill: #c2410c;"/>
                <Pane prefHeight="3"
                      style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #f97316, #fb923c);
                             -fx-background-radius: 2;"/>
            </VBox>

            <!-- Forums Actifs -->
            <VBox spacing="6" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #fdf4ff, #fae8ff);
                         -fx-border-color: #d8b4fe;
                         -fx-border-width: 1.5;
                         -fx-border-radius: 14;
                         -fx-background-radius: 14;
                         -fx-padding: 18 20 20 20;
                         -fx-effect: dropshadow(gaussian, rgba(139,92,246,0.10), 12, 0, 0, 3);">
                <Label text="✅" style="-fx-font-size: 16;"/>
                <Label text="FORUMS ACTIFS"
                       style="-fx-font-family: 'Inter'; -fx-font-size: 11; -fx-font-weight: bold;
                              -fx-text-fill: #6b21a8; -fx-letter-spacing: 0.6;"/>
                <Label fx:id="activeForumsLabel" text="9"
                       style="-fx-font-family: 'Cabinet Grotesk'; -fx-font-size: 40;
                              -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
                <Pane prefHeight="3"
                      style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #8b5cf6, #a78bfa);
                             -fx-background-radius: 2;"/>
            </VBox>

        </HBox>

        <!-- Section label -->
        <Label text="ACTIONS RAPIDES"
               style="-fx-font-family: 'Inter'; -fx-font-size: 11; -fx-font-weight: bold;
                      -fx-text-fill: #6b7280; -fx-letter-spacing: 0.8; -fx-padding: 0 0 10 0;"/>

        <!-- ═══ ROW 1 BUTTONS ═══ -->
        <HBox spacing="10" style="-fx-padding: 0 0 0 0;">
            <Button text="+  Créer un nouveau forum" onAction="#handleCreateForum"
                    style="-fx-font-family: 'Inter'; -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #10b981, #059669);
                           -fx-background-radius: 10; -fx-text-fill: white; -fx-padding: 10 18;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.30), 12, 0, 0, 3);"/>

            <Button text="🗂  Ajouter une catégorie" onAction="#handleAddCategory"
                    style="-fx-font-family: 'Inter'; -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #3b82f6, #2563eb);
                           -fx-background-radius: 10; -fx-text-fill: white; -fx-padding: 10 18;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.30), 12, 0, 0, 3);"/>

            <Button text="📊  Statistiques" onAction="#handleStatistics"
                    style="-fx-font-family: 'Inter'; -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #f59e0b, #d97706);
                           -fx-background-radius: 10; -fx-text-fill: white; -fx-padding: 10 18;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(245,158,11,0.30), 12, 0, 0, 3);"/>

            <Button text="📜  Rapport résumé" onAction="#handleSummaryReport"
                    style="-fx-font-family: 'Inter'; -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #a855f7, #9333ea);
                           -fx-background-radius: 10; -fx-text-fill: white; -fx-padding: 10 18;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(168,85,247,0.30), 12, 0, 0, 3);"/>

            <Button text="🔍  Clustering des discussions" onAction="#handleClustering"
                    style="-fx-font-family: 'Inter'; -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #8b5cf6, #7c3aed);
                           -fx-background-radius: 10; -fx-text-fill: white; -fx-padding: 10 18;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(139,92,246,0.30), 12, 0, 0, 3);"/>

            <Button text="🌐  Go to Front" onAction="#handleGoToFront"
                    style="-fx-font-family: 'Inter'; -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #374151, #1f2937);
                           -fx-background-radius: 10; -fx-text-fill: white; -fx-padding: 10 18;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(55,65,81,0.30), 12, 0, 0, 3);"/>
        </HBox>

        <!-- Divider -->
        <Pane prefHeight="1" style="-fx-background-color: #d1fae5; -fx-padding: 0;">
            <VBox.margin><Insets top="16" bottom="14"/></VBox.margin>
        </Pane>

        <!-- Section label 2 -->
        <Label text="GESTION"
               style="-fx-font-family: 'Inter'; -fx-font-size: 11; -fx-font-weight: bold;
                      -fx-text-fill: #6b7280; -fx-letter-spacing: 0.8; -fx-padding: 0 0 10 0;"/>

        <!-- ═══ ROW 2 BUTTONS ═══ -->
        <HBox spacing="10">
            <Button text="🗂  Gérer Catégories" onAction="#handleManageCategories"
                    style="-fx-font-family: 'Inter'; -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #0d9488, #0f766e);
                           -fx-background-radius: 10; -fx-text-fill: white; -fx-padding: 10 18;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(13,148,136,0.30), 12, 0, 0, 3);"/>

            <Button text="💬  Gérer Forums" onAction="#handleManageForums"
                    style="-fx-font-family: 'Inter'; -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #6366f1, #4f46e5);
                           -fx-background-radius: 10; -fx-text-fill: white; -fx-padding: 10 18;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.30), 12, 0, 0, 3);"/>

            <Button text="✉️  Gérer Messages" onAction="#handleManageMessages"
                    style="-fx-font-family: 'Inter'; -fx-font-size: 13; -fx-font-weight: bold;
                           -fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #ec4899, #db2777);
                           -fx-background-radius: 10; -fx-text-fill: white; -fx-padding: 10 18;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(236,72,153,0.30), 12, 0, 0, 3);"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS"/>

    </VBox>
</VBox>
