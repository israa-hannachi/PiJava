<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:id="rootStackPane" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="tn.esprit.controllers.front.WhiteboardController"
           style="-fx-background-color: #f8fafc;">

    <VBox spacing="15" alignment="CENTER">
        <StackPane.margin>
            <Insets top="15" bottom="15" left="15" right="15" />
        </StackPane.margin>

        <!-- Zone de dessin (Viewport) -->
        <StackPane fx:id="drawingArea" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #d1d5db; -fx-border-width: 0.5; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <Group fx:id="drawGroup">
                <Canvas fx:id="bgCanvas" width="890" height="350" />
                <Canvas fx:id="canvas" width="890" height="350" />
                <Pane fx:id="overlayPane" prefWidth="890" prefHeight="350"
                      pickOnBounds="true"
                      style="-fx-background-color: transparent;" />
            </Group>
        </StackPane>

        <!-- Barre d'outils principale flottante -->
        <HBox fx:id="toolbar" alignment="CENTER" maxWidth="-Infinity" maxHeight="-Infinity" pickOnBounds="false"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 8 12; -fx-spacing: 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 5, 0, 0, 2); -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 0.5;">
            
            <!-- Groupe 1: Sélection / Main -->
            <HBox alignment="CENTER" spacing="2" style="-fx-padding: 0 6;">
                <Button fx:id="selectBtn" onAction="#onSelectTool"
                        style="-fx-background-color: transparent; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
                <Button fx:id="panBtn" onAction="#onPanTool"
                        style="-fx-background-color: transparent; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
            </HBox>

            <Region style="-fx-pref-width: 1; -fx-background-color: #e2e8f0; -fx-min-height: 24; -fx-max-height: 24;" />

            <!-- Groupe 2: Dessin -->
            <HBox alignment="CENTER" spacing="2" style="-fx-padding: 0 6;">
                <Button fx:id="penBtn" onAction="#onPenTool"
                        style="-fx-background-color: #e3f0ff; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
                <Button fx:id="markerBtn" onAction="#onMarkerTool"
                        style="-fx-background-color: transparent; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
                <Button fx:id="eraserBtn" onAction="#onEraserTool"
                        style="-fx-background-color: transparent; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
            </HBox>

            <Region style="-fx-pref-width: 1; -fx-background-color: #e2e8f0; -fx-min-height: 24; -fx-max-height: 24;" />

            <!-- Groupe 3: Formes -->
            <HBox alignment="CENTER" spacing="2" style="-fx-padding: 0 6;">
                <Button fx:id="rectBtn" onAction="#onRectTool"
                        style="-fx-background-color: transparent; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
                <Button fx:id="circleBtn" onAction="#onCircleTool"
                        style="-fx-background-color: transparent; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
                <Button fx:id="lineBtn" onAction="#onLineTool"
                        style="-fx-background-color: transparent; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
                <Button fx:id="arrowBtn" onAction="#onArrowTool"
                        style="-fx-background-color: transparent; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
            </HBox>

            <Region style="-fx-pref-width: 1; -fx-background-color: #e2e8f0; -fx-min-height: 24; -fx-max-height: 24;" />

            <!-- Groupe 4: Texte / Note -->
            <HBox alignment="CENTER" spacing="2" style="-fx-padding: 0 6;">
                <Button fx:id="textBtn" onAction="#onTextTool"
                        style="-fx-background-color: transparent; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
                <Button fx:id="noteBtn" onAction="#onNoteTool"
                        style="-fx-background-color: transparent; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
            </HBox>

            <Region style="-fx-pref-width: 1; -fx-background-color: #e2e8f0; -fx-min-height: 24; -fx-max-height: 24;" />

            <!-- Palette de couleurs -->
            <HBox alignment="CENTER" spacing="4" style="-fx-padding: 0 6;">
                <Button fx:id="colorBlack" onAction="#onColorBlack"
                        style="-fx-background-color: #1a1a1a; -fx-background-radius: 50%; -fx-min-width: 18; -fx-min-height: 18; -fx-cursor: hand; -fx-border-color: #1a1a1a; -fx-border-radius: 50%; -fx-border-width: 2;" />
                <Button fx:id="colorRed" onAction="#onColorRed"
                        style="-fx-background-color: #e74c3c; -fx-background-radius: 50%; -fx-min-width: 18; -fx-min-height: 18; -fx-cursor: hand; -fx-border-color: transparent; -fx-border-radius: 50%; -fx-border-width: 2;" />
                <Button fx:id="colorOrange" onAction="#onColorOrange"
                        style="-fx-background-color: #f39c12; -fx-background-radius: 50%; -fx-min-width: 18; -fx-min-height: 18; -fx-cursor: hand; -fx-border-color: transparent; -fx-border-radius: 50%; -fx-border-width: 2;" />
                <Button fx:id="colorGreen" onAction="#onColorGreen"
                        style="-fx-background-color: #2ecc71; -fx-background-radius: 50%; -fx-min-width: 18; -fx-min-height: 18; -fx-cursor: hand; -fx-border-color: transparent; -fx-border-radius: 50%; -fx-border-width: 2;" />
                <Button fx:id="colorBlue" onAction="#onColorBlue"
                        style="-fx-background-color: #3498db; -fx-background-radius: 50%; -fx-min-width: 18; -fx-min-height: 18; -fx-cursor: hand; -fx-border-color: transparent; -fx-border-radius: 50%; -fx-border-width: 2;" />
                <Button fx:id="colorPurple" onAction="#onColorPurple"
                        style="-fx-background-color: #9b59b6; -fx-background-radius: 50%; -fx-min-width: 18; -fx-min-height: 18; -fx-cursor: hand; -fx-border-color: transparent; -fx-border-radius: 50%; -fx-border-width: 2;" />
                <Button fx:id="colorWhite" onAction="#onColorWhite"
                        style="-fx-background-color: #ffffff; -fx-background-radius: 50%; -fx-min-width: 18; -fx-min-height: 18; -fx-cursor: hand; -fx-border-color: transparent; -fx-border-radius: 50%; -fx-border-width: 2;" />
                <ColorPicker fx:id="customColorPicker" onAction="#onCustomColor"
                             style="-fx-color-label-visible: false; -fx-pref-width: 22; -fx-pref-height: 22; -fx-background-color: transparent; -fx-padding: 0;" />
            </HBox>

            <Region style="-fx-pref-width: 1; -fx-background-color: #e2e8f0; -fx-min-height: 24; -fx-max-height: 24;" />

            <!-- Slider taille du trait -->
            <HBox alignment="CENTER" spacing="6" style="-fx-padding: 0 6;">
                <Slider fx:id="sizeSlider" min="1" max="40" value="4"
                        prefWidth="70"
                        style="-fx-pref-height: 16; -fx-cursor: hand;" />
            </HBox>

            <Region style="-fx-pref-width: 1; -fx-background-color: #e2e8f0; -fx-min-height: 24; -fx-max-height: 24;" />

            <!-- Groupe Actions: Undo / Redo / Clear -->
            <HBox alignment="CENTER" spacing="2" style="-fx-padding: 0 6;">
                <Button fx:id="undoBtn" onAction="#performUndo"
                        style="-fx-background-color: transparent; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
                <Button fx:id="redoBtn" onAction="#performRedo"
                        style="-fx-background-color: transparent; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
                <Button fx:id="clearBtn" onAction="#onClearAll"
                        style="-fx-background-color: transparent; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
            </HBox>

            <Region style="-fx-pref-width: 1; -fx-background-color: #e2e8f0; -fx-min-height: 24; -fx-max-height: 24;" />

            <!-- Groupe Download -->
            <HBox alignment="CENTER" spacing="2" style="-fx-padding: 0 6;">
                <Button fx:id="downloadBtn" onAction="#onDownload"
                        style="-fx-background-color: transparent; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
                <Button fx:id="moreBtn" onAction="#showMoreMenu"
                        style="-fx-background-color: transparent; -fx-background-radius: 6; -fx-min-width: 32; -fx-min-height: 32; -fx-cursor: hand; -fx-padding: 7;" />
            </HBox>
        </HBox>

        <!-- Ligne du bas: Zoom, Pages, Publier -->
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 0 10;">
            <!-- Zoom -->
            <HBox fx:id="zoomBar" alignment="CENTER" spacing="10">
                <Button fx:id="zoomOutBtn" text="−" onAction="#onZoomOut"
                        style="-fx-background-color: white; -fx-background-radius: 20; -fx-min-width: 30; -fx-min-height: 30; -fx-text-fill: #64748b; -fx-font-size: 16px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" />
                <Label fx:id="zoomLabel" text="100%"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-padding: 0 5;" />
                <Button fx:id="zoomInBtn" text="+" onAction="#onZoomIn"
                        style="-fx-background-color: white; -fx-background-radius: 20; -fx-min-width: 30; -fx-min-height: 30; -fx-text-fill: #64748b; -fx-font-size: 16px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Bouton Publier et Onglets de pages ensemble au centre/droite -->
            <HBox alignment="CENTER" spacing="15">
                <HBox fx:id="pageTabs" alignment="CENTER_LEFT" spacing="8" style="-fx-pref-height: 40;">
                    <Button fx:id="page1Tab" text="Page 1" onAction="#onSelectPage1"
                            style="-fx-background-color: white; -fx-background-radius: 10; -fx-text-fill: #1a5fb4; -fx-font-size: 12px; -fx-padding: 8 16; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-border-color: #1a5fb4; -fx-border-width: 0 0 2 0; -fx-border-radius: 0 0 10 10;" />
                    <Button fx:id="page2Tab" text="Page 2" onAction="#onSelectPage2"
                            style="-fx-background-color: white; -fx-background-radius: 10; -fx-text-fill: #64748b; -fx-font-size: 12px; -fx-padding: 8 16; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" />
                    <Button fx:id="addPageBtn" text="+" onAction="#onAddPage"
                            style="-fx-background-color: white; -fx-background-radius: 20; -fx-min-width: 34; -fx-min-height: 34; -fx-text-fill: #64748b; -fx-font-size: 18px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" />
                </HBox>

                <!-- Bouton Publier -->
                <Button fx:id="publishBtn" text="Publier"
                        style="-fx-background-color: #1a5fb4; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 24; -fx-background-radius: 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(26,95,180,0.3), 10, 0, 0, 4);"
                        onAction="#onPublish">
                </Button>
            </HBox>
        </HBox>
    </VBox>
</StackPane>