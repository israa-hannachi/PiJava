<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.front.FrontCoursParcoursController"
            prefWidth="1440.0" prefHeight="980.0"
            style="-fx-background-color:#FFFFFF; -fx-font-family:'Segoe UI';">

    <!-- ═══════════════════════════════════════════════════════════ SIDEBAR -->
    <left>
        <VBox prefWidth="110.0" spacing="8.0"
              style="-fx-background-color:#F7FFFE; -fx-border-color:rgba(15,181,169,0.10); -fx-border-width:0 1 0 0;">
            <padding><Insets top="14.0" right="8.0" bottom="14.0" left="8.0"/></padding>
            <ImageView fitHeight="56.0" preserveRatio="true" pickOnBounds="true">
                <image><Image url="@/assets/images/logo.png"/></image>
            </ImageView>
            <Button text="🏠 Accueil" maxWidth="Infinity" onAction="#handleHome"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10; -fx-font-size:11;"/>
            <Button text="📚 Cours" maxWidth="Infinity" onAction="#handleCoursCategories"
                    style="-fx-background-color:rgba(15,181,169,0.14); -fx-text-fill:#0FB5A9; -fx-font-weight:700; -fx-background-radius:10; -fx-font-size:11;"/>
            <Button text="← Liste" maxWidth="Infinity" onAction="#handleRetourListe"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10; -fx-font-size:11;"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════════════════ TOP BAR -->
    <top>
        <HBox spacing="12.0" alignment="CENTER_LEFT"
              style="-fx-background-color:#FFFFFF; -fx-border-color:rgba(15,181,169,0.12); -fx-border-width:0 0 1 0;">
            <padding><Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/></padding>

            <!-- Breadcrumb -->
            <Button text="← Retour aux cours" onAction="#handleRetourListe"
                    style="-fx-background-color:transparent; -fx-text-fill:#0FB5A9; -fx-font-weight:700; -fx-cursor:hand; -fx-padding:0; -fx-font-size:13;"/>
            <Label text="›" style="-fx-text-fill:#94a3b8;"/>
            <Label fx:id="moduleLabel" text="Module › Catégorie"
                   style="-fx-text-fill:#64748b; -fx-font-size:12;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Progression globale -->
            <Label fx:id="progressLabel" text="Cours 1 / N"
                   style="-fx-text-fill:#64748b; -fx-font-size:12; -fx-font-weight:700;"/>
            <ProgressBar fx:id="progressBar" prefWidth="160.0" prefHeight="10.0" progress="0.0"
                         style="-fx-accent:#0FB5A9; -fx-background-radius:99; -fx-background-color:#e2e8f0;"/>
        </HBox>
    </top>

    <!-- ═══════════════════════════════════════════════════════════ MAIN -->
    <center>
        <HBox spacing="0.0" style="-fx-background-color:#F0FFFE;">

            <!-- ─── Sommaire latéral ─────────────────────────────────────── -->
            <VBox prefWidth="230.0"
                  style="-fx-background-color:white; -fx-border-color:#e2e8f0; -fx-border-width:0 1 0 0;">
                <padding><Insets top="16.0" right="0.0" bottom="16.0" left="0.0"/></padding>

                <Label text="Sommaire"
                       style="-fx-font-weight:800; -fx-font-size:13; -fx-text-fill:#1f2937; -fx-padding:0 12 8 12;"/>

                <ScrollPane fx:id="navScrollPane" fitToWidth="true" prefHeight="880.0"
                            style="-fx-background-color:transparent; -fx-background:transparent;">
                    <VBox fx:id="courseNavContainer" spacing="2.0"/>
                </ScrollPane>
            </VBox>

            <!-- ─── Contenu cours ────────────────────────────────────────── -->
            <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS"
                        style="-fx-background-color:#F0FFFE; -fx-background:transparent;">
                <VBox spacing="20.0">
                    <padding><Insets top="24.0" right="28.0" bottom="24.0" left="28.0"/></padding>

                    <!-- Titre + badge ordre + durée -->
                    <VBox spacing="8.0"
                          style="-fx-background-color:linear-gradient(to right, #0FB5A9, #04B6D5); -fx-background-radius:18; -fx-padding:22;">
                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                            <Label fx:id="ordreLabel" text="#1"
                                   style="-fx-background-color:rgba(255,255,255,0.25); -fx-text-fill:white; -fx-font-weight:800; -fx-background-radius:8; -fx-padding:4 12; -fx-font-size:13;"/>
                            <Label fx:id="dureeLabel" text="⏱ — min"
                                   style="-fx-text-fill:rgba(255,255,255,0.85); -fx-font-size:12;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <!-- Bouton favori -->
                            <Button fx:id="favBtn" text="☆ Ajouter aux favoris" onAction="#handleFavori"
                                    style="-fx-background-color:white; -fx-text-fill:#64748b; -fx-border-color:#e2e8f0; -fx-border-radius:8; -fx-background-radius:8; -fx-padding:7 16; -fx-cursor:hand;"/>
                        </HBox>
                        <Label fx:id="titreCoursLabel" text="Titre du cours"
                               style="-fx-font-size:26px; -fx-font-weight:800; -fx-text-fill:white; -fx-wrap-text:true;"/>
                        <Label fx:id="descriptionLabel" text=""
                               style="-fx-font-size:13px; -fx-text-fill:rgba(255,255,255,0.90); -fx-wrap-text:true;"/>
                    </VBox>

                    <!-- Section PDF -->
                    <HBox fx:id="pdfSection"
                          alignment="CENTER_LEFT"
                          visible="false"
                          managed="false"
                          style="-fx-background-color:white; -fx-background-radius:12; -fx-padding:14 18; -fx-border-color:#dbeafe; -fx-border-radius:12;">
                        <spacing>10.0</spacing>
                        <Label text="📄" style="-fx-font-size:22px;"/>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="Fichier PDF disponible"
                                   style="-fx-font-weight:700; -fx-text-fill:#1e40af; -fx-font-size:13;"/>
                            <Label fx:id="pdfUrlLabel" text=""
                                   style="-fx-text-fill:#3b82f6; -fx-font-size:11;"/>
                        </VBox>
                        <Button fx:id="voirPdfBtn" text="📄 Ouvrir le PDF" onAction="#handleVoirPdf"
                                style="-fx-background-color:#2563eb; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:8; -fx-padding:8 16; -fx-cursor:hand;"/>
                    </HBox>

                    <!-- Contenu HTML -->
                    <VBox spacing="8.0"
                          style="-fx-background-color:white; -fx-background-radius:14; -fx-padding:20; -fx-border-color:#e5e7eb; -fx-border-radius:14;">
                        <Label text="Contenu du cours"
                               style="-fx-font-weight:800; -fx-font-size:15; -fx-text-fill:#1f2937;"/>
                        <WebView fx:id="contenuWebView" prefHeight="420.0" prefWidth="800.0"/>
                    </VBox>

                    <!-- Navigation Précédent / Suivant -->
                    <HBox spacing="12.0"
                          style="-fx-background-color:white; -fx-background-radius:14; -fx-padding:16; -fx-border-color:#e5e7eb; -fx-border-radius:14;">
                        <Button fx:id="prevBtn" text="← Précédent" onAction="#handlePrev"
                                prefWidth="220.0"
                                style="-fx-background-color:#f8fafc; -fx-text-fill:#374151; -fx-font-weight:700; -fx-background-radius:10; -fx-padding:12 20; -fx-border-color:#e2e8f0; -fx-border-radius:10; -fx-cursor:hand; -fx-font-size:13;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="nextBtn" text="Suivant →" onAction="#handleNext"
                                prefWidth="280.0"
                                style="-fx-background-color:#0FB5A9; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10; -fx-padding:12 20; -fx-cursor:hand; -fx-font-size:13;"/>
                    </HBox>

                </VBox>
            </ScrollPane>
        </HBox>
    </center>

</BorderPane>
