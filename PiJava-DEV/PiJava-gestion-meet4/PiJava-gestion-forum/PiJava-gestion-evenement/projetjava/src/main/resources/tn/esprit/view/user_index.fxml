<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.front.UserIndexController"
            style="-fx-background-color: #f8fafc;">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color: #1e293b;">
            <padding><Insets top="0" right="0" bottom="0" left="0"/></padding>

            <Label text="NAJA7NI ADMIN" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 20 20 10 20;" />
            <Label text="Navigation" style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-padding: 0 20 8 20;" />

            <Button text="🏠 Dashboard" onAction="#handleBackAdmin" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;" />
            <Button text="👤 Comptes" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: #334155; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;" />
            <Button text="📚 Cours" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;" />
            <Button text="🎮 Jeux" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;" />
            <Button text="💬 Forums" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;" />
            <Button text="📅 Events" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;" />
            <Button text="📹 Meet" maxWidth="1.7976931348623157E308" onAction="#handleMeets"
                    style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;" />

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="🚪 Logout" onAction="#handleLogout" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color: transparent; -fx-text-fill: #f87171; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;" />
        </VBox>
    </left>

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0; -fx-padding: 12 20;">
            <Label text="👥 Gestion des Comptes" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" promptText="🔍 Rechercher un utilisateur..."
                       prefWidth="280"
                       style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 8 12;"
                       onAction="#handleSearch"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="14" style="-fx-padding: 20; -fx-background-color: #f8fafc;">

            <!-- Breadcrumb -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Dashboard" style="-fx-text-fill: #64748b; -fx-font-size: 13;" />
                <Label text="›" style="-fx-text-fill: #94a3b8;" />
                <Label text="Comptes" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 13;" />
            </HBox>

            <!-- Stats Strip -->
            <HBox spacing="12">
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 12 20;" HBox.hgrow="ALWAYS">
                    <Label text="Total Utilisateurs" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
                    <Label fx:id="totalLabel" text="—" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </VBox>
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 12 20;" HBox.hgrow="ALWAYS">
                    <Label text="Admins" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
                    <Label fx:id="adminCountLabel" text="—" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                </VBox>
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 12 20;" HBox.hgrow="ALWAYS">
                    <Label text="Étudiants" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
                    <Label fx:id="studentCountLabel" text="—" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                </VBox>
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 12 20;" HBox.hgrow="ALWAYS">
                    <Label text="Enseignants" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
                    <Label fx:id="teacherCountLabel" text="—" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #0FB5A9;"/>
                </VBox>
            </HBox>

            <!-- Table -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                <TableView fx:id="usersTable" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-border-color: transparent;">
                    <columns>

                        <TableColumn fx:id="idColumn"           text="ID"             prefWidth="60" />
                        <TableColumn fx:id="nomColumn"          text="Nom"            prefWidth="130" />
                        <TableColumn fx:id="prenomColumn"       text="Prénom"         prefWidth="130" />
                        <TableColumn fx:id="emailColumn"        text="Email"          prefWidth="220" />
                        <TableColumn fx:id="roleColumn"         text="Rôle"           prefWidth="110" />
                        <TableColumn fx:id="statutColumn"       text="Statut"         prefWidth="100" />
                        <TableColumn fx:id="dateCreationColumn" text="Date Création"  prefWidth="160" />
                        <TableColumn fx:id="actionsColumn"      text="Actions"        prefWidth="160" />
                    </columns>
                    <placeholder>
                        <Label text="Aucun utilisateur trouvé." style="-fx-text-fill: #94a3b8; -fx-font-size: 14;"/>
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </center>
</BorderPane>

