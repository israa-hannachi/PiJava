### --- JAVA & MAVEN --- ###
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
bin/
*.class
*.war
*.ear
*.zip
*.tar.gz
*.rar

### --- FICHIERS SENSIBLES & APIs (CORRIGÉ) --- ###
# On bloque tous les fichiers de secrets et de configuration
.env
.env.*
*.env
*.properties
*.xml
*.json
*.yml
*.yaml

# Exceptions : On autorise uniquement les fichiers de config indispensables au build
!pom.xml
!**/src/main/resources/*.properties.example
!**/src/main/resources/log4j2.properties
!**/src/main/resources/logback.xml

