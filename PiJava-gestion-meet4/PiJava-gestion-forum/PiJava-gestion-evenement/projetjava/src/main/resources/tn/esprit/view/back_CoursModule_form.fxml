<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.Back.BackCoursModuleFormController"
            prefWidth="1280" prefHeight="820" minWidth="1180" minHeight="760"
            stylesheets="@cours-ui.css"
            styleClass="cours-root"
            style="-fx-background-color: #f8fafc;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              styleClass="form-header">
            <Button text="← Retour" onAction="#handleRetour"
                    styleClass="btn-back"/>
            <Label fx:id="titleLabel" text="Ajouter un Module"
                   styleClass="form-page-title" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" vbarPolicy="ALWAYS" hbarPolicy="NEVER" pannable="true" styleClass="page-scroll">
            <VBox spacing="20" style="-fx-padding: 30; -fx-max-width: 620; -fx-alignment: TOP_CENTER;">
                <VBox spacing="16" styleClass="form-card">

                    <!-- Titre -->
                    <VBox spacing="6">
                        <Label text="Titre *" styleClass="field-label"/>
                        <TextField fx:id="titreField" promptText="Titre du module"
                                   styleClass="field-control"/>
                        <Label fx:id="titreError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 11;" visible="false" managed="false"/>
                    </VBox>

                    <!-- Description -->
                    <VBox spacing="6">
                        <Label text="Description" styleClass="field-label"/>
                        <TextArea fx:id="descriptionField" promptText="Description du module (optionnel)" prefRowCount="3"
                                  styleClass="field-control"/>
                    </VBox>

                    <!-- Durée + Niveau -->
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Durée (heures) *" styleClass="field-label"/>
                            <TextField fx:id="dureeField" promptText="ex: 24"
                                       styleClass="field-control"/>
                            <Label fx:id="dureeError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 11;" visible="false" managed="false"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Niveau *" styleClass="field-label"/>
                            <ComboBox fx:id="niveauCombo" prefWidth="1e6"
                                      styleClass="field-control"/>
                            <Label fx:id="niveauError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 11;" visible="false" managed="false"/>
                        </VBox>
                    </HBox>

                    <!-- Catégorie + Actif -->
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Catégorie *" styleClass="field-label"/>
                            <ComboBox fx:id="categorieCombo" prefWidth="1e6"
                                      styleClass="field-control"/>
                            <Label fx:id="categorieError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 11;" visible="false" managed="false"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Statut *" styleClass="field-label"/>
                            <ComboBox fx:id="actifCombo" prefWidth="1e6"
                                      styleClass="field-control"/>
                        </VBox>
                    </HBox>

                    <!-- Buttons -->
                    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                        <Button text="Annuler" onAction="#handleRetour"
                                styleClass="btn-secondary"/>
                        <Button fx:id="submitBtn" text="Enregistrer" onAction="#handleSubmit"
                                styleClass="btn-primary"/>
                    </HBox>

                    <Label fx:id="globalMessage" text="" wrapText="true"
                           style="-fx-font-size: 12;" visible="false" managed="false"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
