<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.front.FrontUserDashboardController"
            prefWidth="1200.0" prefHeight="880.0"
            style="-fx-background-color: #FFFFFF; -fx-font-family: 'Segoe UI';">



    <left>
        <VBox prefWidth="120.0" spacing="8.0"
              style="-fx-background-color:#F7FFFE; -fx-border-color:rgba(15,181,169,0.10); -fx-border-width:0 1 0 0;">
            <padding><Insets top="14.0" right="8.0" bottom="14.0" left="8.0"/></padding>

            <ImageView fitHeight="62.0" preserveRatio="true" pickOnBounds="true">
                <image><Image url="@/assets/images/logo.png"/></image>
            </ImageView>

            <Button text="🏠 Accueil" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color:rgba(15,181,169,0.14); -fx-text-fill:#0FB5A9; -fx-font-weight:700; -fx-background-radius:10;"/>
            <Button text="👤 Profil" maxWidth="1.7976931348623157E308" onAction="#handleProfile"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>
            <!-- ★ COURS button now wired to handleCours -->
            <Button text="📚 Cours" maxWidth="1.7976931348623157E308" onAction="#handleCours"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>
            <Button text="🎥 Meet" maxWidth="1.7976931348623157E308" onAction="#handleMeet"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>
            <Button text="🎮 Jeux" onAction="#handleGameList" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>
            <Button text="📅 Events" onAction="#handleEvents" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>
            <Button text="💬 Forums" maxWidth="1.7976931348623157E308" onAction="#handleForums"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>

            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <top>
        <HBox spacing="12.0" alignment="CENTER_LEFT"
              style="-fx-background-color:#FFFFFF; -fx-border-color:rgba(15,181,169,0.12); -fx-border-width:0 0 1 0;">
            <padding><Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/></padding>

            <Label text="Naja7ni" style="-fx-font-size:24px; -fx-font-weight:800; -fx-text-fill:#0FB5A9;" />

            <Region HBox.hgrow="ALWAYS"/>

            <TextField promptText="Rechercher des cours, modules..." prefWidth="420.0"
                       style="-fx-background-color:#F7FFFE; -fx-background-radius:12; -fx-border-color:transparent; -fx-padding:10 14;" />

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="adminButton" text="⚙ Back Office" onAction="#handleBackOffice"
                    visible="false" managed="false"
                    style="-fx-background-color:#1a202c; -fx-text-fill:#f87171; -fx-font-weight:700; -fx-background-radius:8; -fx-padding:8 14;" />
            <Button fx:id="profileButton" text="Profile" onAction="#handleProfile"
                    style="-fx-background-color:linear-gradient(to bottom right, #0FB5A9, #04B6D5); -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:999;" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background:#F0FFFE;">
            <content>
                <VBox spacing="22.0" style="-fx-background-color:#F0FFFE;">
                    <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>

                    <VBox spacing="8.0"
                          style="-fx-background-color:linear-gradient(to right, #0FB5A9, #04B6D5); -fx-background-radius:18; -fx-padding:22;">
                        <Label fx:id="welcomeLabel" text="Bienvenue sur Naja7ni! 👋"
                               style="-fx-font-size:30px; -fx-font-weight:800; -fx-text-fill:white;" />
                        <Label text="Continuez votre parcours d'apprentissage aujourd'hui"
                               style="-fx-font-size:15px; -fx-text-fill:rgba(255,255,255,0.92);" />
                    </VBox>

                    <GridPane hgap="14.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25.0"/>
                            <ColumnConstraints percentWidth="25.0"/>
                            <ColumnConstraints percentWidth="25.0"/>
                            <ColumnConstraints percentWidth="25.0"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0" spacing="8.0"
                              style="-fx-background-color:#ffffff; -fx-background-radius:12; -fx-padding:16; -fx-border-color:rgba(15,181,169,0.15); -fx-border-radius:12;">
                            <Label text="12" style="-fx-font-size:34px; -fx-font-weight:800; -fx-text-fill:#1f2937;"/>
                            <Label text="Cours en cours" style="-fx-text-fill:#64748b;"/>
                        </VBox>

                        <VBox GridPane.columnIndex="1" spacing="8.0"
                              style="-fx-background-color:#ffffff; -fx-background-radius:12; -fx-padding:16; -fx-border-color:rgba(15,181,169,0.15); -fx-border-radius:12;">
                            <Label text="8" style="-fx-font-size:34px; -fx-font-weight:800; -fx-text-fill:#1f2937;"/>
                            <Label text="Certificats obtenus" style="-fx-text-fill:#64748b;"/>
                        </VBox>

                        <VBox GridPane.columnIndex="2" spacing="8.0"
                              style="-fx-background-color:#ffffff; -fx-background-radius:12; -fx-padding:16; -fx-border-color:rgba(15,181,169,0.15); -fx-border-radius:12;">
                            <Label text="1,240" style="-fx-font-size:34px; -fx-font-weight:800; -fx-text-fill:#1f2937;"/>
                            <Label text="Points XP" style="-fx-text-fill:#64748b;"/>
                        </VBox>

                        <VBox GridPane.columnIndex="3" spacing="8.0"
                              style="-fx-background-color:#ffffff; -fx-background-radius:12; -fx-padding:16; -fx-border-color:rgba(15,181,169,0.15); -fx-border-radius:12;">
                            <Label text="48h" style="-fx-font-size:34px; -fx-font-weight:800; -fx-text-fill:#1f2937;"/>
                            <Label text="Temps d'étude" style="-fx-text-fill:#64748b;"/>
                        </VBox>
                    </GridPane>

                    <!-- Quick access to modules -->
                    <HBox spacing="14.0">
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:white; -fx-background-radius:14; -fx-padding:20; -fx-border-color:rgba(15,181,169,0.15); -fx-border-radius:14;">
                            <Label text="📚 Catalogue de Cours" style="-fx-font-size:18px; -fx-font-weight:800; -fx-text-fill:#1f2937;"/>
                            <Label text="Explorez toutes les catégories, modules et cours disponibles."
                                   style="-fx-text-fill:#64748b; -fx-wrap-text:true;"/>
                            <Button text="Parcourir les cours →" onAction="#handleCours"
                                    style="-fx-background-color:#0FB5A9; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:8; -fx-padding:8 16;"/>
                        </VBox>

                        <VBox spacing="10.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:white; -fx-background-radius:14; -fx-padding:20; -fx-border-color:rgba(15,181,169,0.15); -fx-border-radius:14;">
                            <Label text="📹 Réunions Meet" style="-fx-font-size:18px; -fx-font-weight:800; -fx-text-fill:#1f2937;"/>
                            <Label text="Rejoignez des sessions en direct avec vos enseignants et collègues."
                                   style="-fx-text-fill:#64748b; -fx-wrap-text:true;"/>
                            <Button text="Rejoindre Meet →" onAction="#handleMeet"
                                    style="-fx-background-color:#0FB5A9; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:8; -fx-padding:8 16;"/>
                        </VBox>

                        <VBox spacing="10.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:white; -fx-background-radius:14; -fx-padding:20; -fx-border-color:rgba(15,181,169,0.15); -fx-border-radius:14;">
                            <Label text="🎮 Jeux Éducatifs" style="-fx-font-size:18px; -fx-font-weight:800; -fx-text-fill:#1f2937;"/>
                            <Label text="Testez vos connaissances avec des quiz et jeux interactifs."
                                   style="-fx-text-fill:#64748b; -fx-wrap-text:true;"/>
                            <Button text="Jouer maintenant →" onAction="#handleGameList"
                                    style="-fx-background-color:#7c3aed; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:8; -fx-padding:8 16;"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="12.0">
                        <Label text="Cours Récents" style="-fx-font-size:28px; -fx-font-weight:800; -fx-text-fill:#0f172a;"/>
                        <HBox spacing="14.0">
                            <VBox prefWidth="360.0" spacing="8.0"
                                  style="-fx-background-color:#ffffff; -fx-background-radius:12; -fx-border-color:#e5e7eb; -fx-border-radius:12; -fx-padding:12;">
                                <Label text="Développement" style="-fx-background-color:#dbeafe; -fx-text-fill:#1d4ed8; -fx-background-radius:8; -fx-padding:2 8;"/>
                                <Label text="Développement Web Complet" style="-fx-font-size:16px; -fx-font-weight:700;"/>
                                <HBox><Label text="Progression"/><Region HBox.hgrow="ALWAYS"/><Label text="65%" style="-fx-font-weight:700; -fx-text-fill:#0FB5A9;"/></HBox>
                                <ProgressBar progress="0.65" maxWidth="1.7976931348623157E308"/>
                            </VBox>
                            <VBox prefWidth="360.0" spacing="8.0"
                                  style="-fx-background-color:#ffffff; -fx-background-radius:12; -fx-border-color:#e5e7eb; -fx-border-radius:12; -fx-padding:12;">
                                <Label text="Design" style="-fx-background-color:#f3e8ff; -fx-text-fill:#7e22ce; -fx-background-radius:8; -fx-padding:2 8;"/>
                                <Label text="Design UX/UI" style="-fx-font-size:16px; -fx-font-weight:700;"/>
                                <HBox><Label text="Progression"/><Region HBox.hgrow="ALWAYS"/><Label text="40%" style="-fx-font-weight:700; -fx-text-fill:#0FB5A9;"/></HBox>
                                <ProgressBar progress="0.40" maxWidth="1.7976931348623157E308"/>
                            </VBox>
                            <VBox prefWidth="360.0" spacing="8.0"
                                  style="-fx-background-color:#ffffff; -fx-background-radius:12; -fx-border-color:#e5e7eb; -fx-border-radius:12; -fx-padding:12;">
                                <Label text="Marketing" style="-fx-background-color:#dcfce7; -fx-text-fill:#166534; -fx-background-radius:8; -fx-padding:2 8;"/>
                                <Label text="Marketing Digital" style="-fx-font-size:16px; -fx-font-weight:700;"/>
                                <HBox><Label text="Progression"/><Region HBox.hgrow="ALWAYS"/><Label text="85%" style="-fx-font-weight:700; -fx-text-fill:#0FB5A9;"/></HBox>
                                <ProgressBar progress="0.85" maxWidth="1.7976931348623157E308"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <GridPane hgap="14.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0"/>
                            <ColumnConstraints percentWidth="50.0"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0" spacing="12.0"
                              style="-fx-background-color:#ffffff; -fx-background-radius:12; -fx-border-color:#e5e7eb; -fx-border-radius:12; -fx-padding:14;">
                            <Label text="Badges Récents" style="-fx-font-size:20px; -fx-font-weight:700;"/>
                            <HBox spacing="12.0">
                                <Label text="🏆" style="-fx-font-size:32px;"/>
                                <Label text="⭐" style="-fx-font-size:32px;"/>
                                <Label text="🎯" style="-fx-font-size:32px;"/>
                                <Label text="🔥" style="-fx-font-size:32px;"/>
                            </HBox>
                        </VBox>

                        <VBox GridPane.columnIndex="1" spacing="10.0"
                              style="-fx-background-color:#ffffff; -fx-background-radius:12; -fx-border-color:#e5e7eb; -fx-border-radius:12; -fx-padding:14;">
                            <Label text="Classement" style="-fx-font-size:20px; -fx-font-weight:700;"/>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="#1" style="-fx-font-weight:800; -fx-text-fill:#64748b;"/>
                                <Label text="  Sarah K." style="-fx-font-weight:700;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="3,240 pts" style="-fx-font-weight:800; -fx-text-fill:#0FB5A9;"/>
                            </HBox>
                            <Separator/>
                            <HBox alignment="CENTER_LEFT" style="-fx-background-color:rgba(15,181,169,0.10); -fx-background-radius:8; -fx-padding:8;">
                                <Label text="#12  Vous" style="-fx-font-weight:800; -fx-text-fill:#0FB5A9;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="1,240 pts" style="-fx-font-weight:800; -fx-text-fill:#0FB5A9;"/>
                            </HBox>
                        </VBox>
                    </GridPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
