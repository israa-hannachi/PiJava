<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.Back.BackCoursFormController"
            prefWidth="1280" prefHeight="820" minWidth="1180" minHeight="760"
            stylesheets="@cours-ui.css"
            styleClass="cours-root"
            style="-fx-background-color: #f8fafc;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              styleClass="form-header">
            <Button text="← Retour" onAction="#handleRetour"
                    styleClass="btn-back"/>
            <Label fx:id="titleLabel" text="Ajouter un Cours"
                   styleClass="form-page-title"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" vbarPolicy="ALWAYS" hbarPolicy="NEVER" pannable="true" styleClass="page-scroll">
            <VBox spacing="20" style="-fx-padding: 30; -fx-max-width: 720; -fx-alignment: TOP_CENTER;">
                <VBox spacing="16" styleClass="form-card">

                    <!-- ── Titre ────────────────────────────────────────────────── -->
                    <VBox spacing="6">
                        <Label text="Titre *" styleClass="field-label"/>
                        <TextField fx:id="titreField" promptText="Titre du cours"
                                   styleClass="field-control"/>
                        <Label fx:id="titreError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 11;" visible="false" managed="false"/>
                    </VBox>

                    <!-- ── Description ──────────────────────────────────────────── -->
                    <VBox spacing="6">
                        <Label text="Description" styleClass="field-label"/>
                        <TextArea fx:id="descriptionField" promptText="Description du cours" prefRowCount="3"
                                  styleClass="field-control"/>
                    </VBox>

                    <!-- ── Durée + Ordre ─────────────────────────────────────────── -->
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Durée (minutes) *" styleClass="field-label"/>
                            <TextField fx:id="dureeField" promptText="ex: 45"
                                       styleClass="field-control"/>
                            <Label fx:id="dureeError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 11;" visible="false" managed="false"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Ordre *" styleClass="field-label"/>
                            <TextField fx:id="ordreField" promptText="ex: 1"
                                       styleClass="field-control"/>
                            <Label fx:id="ordreError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 11;" visible="false" managed="false"/>
                        </VBox>
                    </HBox>

                    <!-- ── Module + Statut + Visible ────────────────────────────── -->
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Module *" styleClass="field-label"/>
                            <ComboBox fx:id="moduleCombo" prefWidth="1e6"
                                      styleClass="field-control"/>
                            <Label fx:id="moduleError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 11;" visible="false" managed="false"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Statut" styleClass="field-label"/>
                            <ComboBox fx:id="actifCombo" prefWidth="1e6"
                                      styleClass="field-control"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Visible" styleClass="field-label"/>
                            <ComboBox fx:id="visibleCombo" prefWidth="1e6"
                                      styleClass="field-control"/>
                        </VBox>
                    </HBox>

                    <!-- ── Contenu texte riche (TinyMCE) ────────────────────────── -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Contenu du Cours (Éditeur Riche) *" styleClass="field-label"/>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="generateAiBtn" text="✨ Générer Résumé IA" onAction="#handleGenerateSummary"
                                    styleClass="btn-ai"/>
                        </HBox>
                        <javafx.scene.web.WebView fx:id="contenuWebView" prefHeight="400"
                                                  styleClass="editor-frame"/>
                        <Label fx:id="contenuError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 11;" visible="false" managed="false"/>


                    <!-- ── Résumé IA ────────────────────────────────────────────── -->
                    <VBox spacing="6">
                        <Label text="Résumé IA" styleClass="field-label"/>
                        <TextArea fx:id="resumeAiField" promptText="Le résumé généré par l'IA apparaîtra ici..."
                                  prefRowCount="4" wrapText="true"
                                  styleClass="ai-textarea"/>
                        <Label fx:id="aiStatusLabel" text="" style="-fx-text-fill: #7c3aed; -fx-font-size: 11;" visible="false" managed="false"/>
                    </VBox>

                    <!-- ── Fichier PDF ──────────────────────────────────────────── -->
                    <VBox spacing="6"
                          styleClass="pdf-panel">

                        <Label text="📄 Fichier PDF (contenu)"
                               styleClass="field-label"/>

                        <!-- Sélection locale -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="fichierField" promptText="Aucun fichier sélectionné"
                                       HBox.hgrow="ALWAYS" editable="false"
                                       styleClass="field-control"/>
                            <Button text="📂 Parcourir…" onAction="#handleChoisirPdf"
                                    styleClass="btn-soft"/>
                            <Button fx:id="voirPdfBtn" text="👁 Voir" onAction="#handleVoirPdf"
                                    visible="false" managed="false"
                                    styleClass="btn-info"/>
                        </HBox>

                        <!-- Upload Cloudinary -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="uploadCloudBtn" text="☁️ Uploader sur Cloudinary"
                                    onAction="#handleUploadCloud"
                                    visible="false" managed="false"
                                    styleClass="btn-primary"/>
                            <Label text="Recommandé pour accès multi-appareils"
                                   style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
                        </HBox>

                        <!-- Barre progression upload -->
                        <VBox fx:id="uploadProgressBox" spacing="6" visible="false" managed="false"
                              style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #bfdbfe; -fx-border-radius: 8;">
                            <Label fx:id="uploadStatusLabel" text="Upload en cours…"
                                   style="-fx-text-fill: #1d4ed8; -fx-font-size: 12; -fx-font-weight: bold;"/>
                            <ProgressBar fx:id="uploadProgressBar" prefWidth="1e6" prefHeight="10"
                                         style="-fx-accent: #0FB5A9;"/>
                        </VBox>

                        <Label text="Formats acceptés : PDF uniquement (max 10 MB)"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"/>
                        <Label fx:id="pdfError" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 11;" visible="false" managed="false"/>
                    </VBox>

                    <!-- ── Boutons ─────────────────────────────────────────────── -->
                    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                        <Button text="Annuler" onAction="#handleRetour"
                                styleClass="btn-secondary"/>
                        <Button fx:id="submitBtn" text="Enregistrer" onAction="#handleSubmit"
                                styleClass="btn-primary"/>
                    </HBox>

                    <Label fx:id="globalMessage" text="" wrapText="true"
                           style="-fx-font-size: 12;" visible="false" managed="false"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
