<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.front.FrontCoursListController"
            prefWidth="1280" prefHeight="820" minWidth="1180" minHeight="760"
            stylesheets="@cours-ui.css"
            styleClass="cours-root">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="140.0" spacing="6.0" styleClass="sidebar-modern">
            <padding><Insets top="16.0" right="10.0" bottom="16.0" left="10.0"/></padding>
            <ImageView fitHeight="56.0" preserveRatio="true" pickOnBounds="true">
                <image><Image url="@/assets/images/logo.png"/></image>
            </ImageView>
            <Region prefHeight="8"/>
            <Button text="🏠 Accueil" maxWidth="Infinity" onAction="#handleHome"
                    styleClass="sidebar-btn"/>
            <Button text="👤 Profil" maxWidth="Infinity" onAction="#handleProfile"
                    styleClass="sidebar-btn"/>
            <Button text="📚 Cours" maxWidth="Infinity" onAction="#handleCoursCategories"
                    styleClass="sidebar-btn-active"/>
            <Button text="🎮 Jeux" maxWidth="Infinity" onAction="#handleJeux"
                    styleClass="sidebar-btn"/>
            <Button text="📅 Events" maxWidth="1.7976931348623157E308" onAction="#handleEvents"
                    styleClass="sidebar-btn"/>
            <Button text="💬 Forums" maxWidth="Infinity"
                    styleClass="sidebar-btn"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪 Logout" maxWidth="Infinity" onAction="#handleLogout"
                    styleClass="sidebar-logout-btn"/>
        </VBox>
    </left>

    <!-- TOP BAR -->
    <top>
        <HBox spacing="14.0" alignment="CENTER_LEFT" styleClass="glass-header">
            <padding><Insets top="12.0" right="24.0" bottom="12.0" left="24.0"/></padding>
            <!-- Back button -->
            <Button text="← Retour" onAction="#handleBack" styleClass="btn-back"/>
            <Label text="Naja7ni" style="-fx-font-size:26px; -fx-font-weight:800; -fx-text-fill:#0FB5A9;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="🔍 Rechercher un cours..." prefWidth="300.0"
                       styleClass="search-field"
                       onKeyReleased="#handleSearch"/>
            <ComboBox fx:id="filterVisible" promptText="Visibilité" prefWidth="130.0"
                      styleClass="filter-combo" onAction="#handleFilterVisible"/>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Export PDF -->
            <Button fx:id="exportPdfBtn" text="📥 Export PDF" onAction="#handleExportPdf"
                    style="-fx-background-color: linear-gradient(to bottom, #7c3aed, #6d28d9); -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10; -fx-padding:8 16; -fx-effect: dropshadow(gaussian, rgba(124,58,237,0.25), 6, 0, 0, 2);"/>
            <!-- Prof only -->
            <Button fx:id="addCoursBtn" text="➕ Nouveau cours" onAction="#handleAddCours"
                    visible="false" managed="false" styleClass="btn-primary"/>
            <Button fx:id="profileButton" text="Profile" onAction="#handleProfile" styleClass="btn-profile"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" vbarPolicy="ALWAYS" hbarPolicy="NEVER" pannable="true" styleClass="page-scroll">
            <VBox spacing="22.0" style="-fx-background-color:transparent;">
                <padding><Insets top="28.0" right="32.0" bottom="28.0" left="32.0"/></padding>

                <!-- Breadcrumb -->
                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Button text="← Catégories" onAction="#handleCoursCategories"
                            style="-fx-background-color:transparent; -fx-text-fill:#0FB5A9; -fx-font-weight:700; -fx-cursor:hand; -fx-padding:0;"/>
                    <Label text="›" style="-fx-text-fill:#94a3b8;"/>
                    <Button fx:id="backToModulesBtn" text="Modules" onAction="#handleBackToModules"
                            style="-fx-background-color:transparent; -fx-text-fill:#0FB5A9; -fx-font-weight:700; -fx-cursor:hand; -fx-padding:0;"/>
                    <Label text="›" style="-fx-text-fill:#94a3b8;"/>
                    <Label fx:id="breadcrumbLabel" text="Cours"
                           style="-fx-text-fill:#1f2937; -fx-font-weight:700;"/>
                </HBox>

                <!-- Module banner with 3D glow -->
                <VBox spacing="6.0" styleClass="banner-gradient">
                    <HBox alignment="CENTER_LEFT" spacing="16.0">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label fx:id="moduleNomLabel" text="📖 Cours"
                                   style="-fx-font-size:28px; -fx-font-weight:800; -fx-text-fill:white;"/>
                            <Label fx:id="moduleNiveauLabel" text=""
                                   style="-fx-font-size:13px; -fx-text-fill:rgba(255,255,255,0.92);"/>
                        </VBox>
                        <!-- Prof badge -->
                        <Label fx:id="profBadge" text="👨‍🏫 Enseignant — Gestion activée"
                               visible="false" managed="false"
                               style="-fx-background-color:rgba(255,255,255,0.22); -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10; -fx-padding:6 16; -fx-font-size:12;"/>
                    </HBox>

                    <!-- Learning path buttons -->
                    <HBox spacing="12.0" style="-fx-padding:10 0 0 0;">
                        <Button fx:id="parcoursBtn" text="🚀 Start Learning Path"
                                onAction="#handleDemarrerParcours"
                                visible="true" managed="true"
                                style="-fx-background-color:white; -fx-text-fill:#0FB5A9; -fx-font-weight:800; -fx-background-radius:12; -fx-padding:10 24; -fx-cursor:hand; -fx-font-size:13; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 6, 0, 0, 2);"/>
                        <Button fx:id="parcoursInteractiveBtn" text="🎯 Interactive Path (Drag &amp; Drop)"
                                onAction="#handleParcoursInteractive"
                                visible="true" managed="true"
                                style="-fx-background-color: linear-gradient(to bottom, #10b981, #059669); -fx-text-fill:white; -fx-font-weight:800; -fx-background-radius:12; -fx-padding:10 24; -fx-cursor:hand; -fx-font-size:13; -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.30), 8, 0, 0, 3);"/>
                    </HBox>
                </VBox>

                <!-- Stats with 3D cards -->
                <HBox spacing="16.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="stat-card">
                        <Label fx:id="totalCoursLabel" text="—"
                               style="-fx-font-size:30px; -fx-font-weight:800; -fx-text-fill:#1f2937;"/>
                        <Label text="Cours" style="-fx-text-fill:#64748b; -fx-font-size:13px;"/>
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="stat-card">
                        <Label fx:id="withPdfLabel" text="—"
                               style="-fx-font-size:30px; -fx-font-weight:800; -fx-text-fill:#2563eb;"/>
                        <Label text="Avec PDF" style="-fx-text-fill:#64748b; -fx-font-size:13px;"/>
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="stat-card">
                        <Label fx:id="totalDureeLabel" text="—"
                               style="-fx-font-size:30px; -fx-font-weight:800; -fx-text-fill:#7c3aed;"/>
                        <Label text="Minutes au total" style="-fx-text-fill:#64748b; -fx-font-size:13px;"/>
                    </VBox>
                </HBox>

                <!-- Tabs -->
                <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
                         style="-fx-tab-min-width:160; -fx-font-size:13;">

                    <!-- Cours Tab -->
                    <Tab text="📚 Cours">
                        <VBox spacing="16.0">
                            <padding><Insets top="18.0"/></padding>

                            <!-- Sort bar -->
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="Trier:" style="-fx-text-fill:#64748b; -fx-font-size:13px; -fx-font-weight:600;"/>
                                <Button text="Titre A→Z" onAction="#sortAZ" styleClass="sort-pill"/>
                                <Button text="Titre Z→A" onAction="#sortZA" styleClass="sort-pill"/>
                                <Button text="Ordre ↑" onAction="#sortByOrdreAsc" styleClass="sort-pill"/>
                                <Button text="Ordre ↓" onAction="#sortByOrdreDesc" styleClass="sort-pill"/>
                                <Button text="Durée ↑" onAction="#sortByDureeAsc" styleClass="sort-pill"/>
                                <Button text="Durée ↓" onAction="#sortByDureeDesc" styleClass="sort-pill"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="countLabel" text="" style="-fx-text-fill:#94a3b8; -fx-font-size:12px;"/>
                            </HBox>

                            <!-- Course cards -->
                            <FlowPane fx:id="coursContainer" hgap="18.0" vgap="18.0" prefWrapLength="900"/>

                            <!-- Empty state -->
                            <VBox fx:id="emptyState" alignment="CENTER" spacing="12.0"
                                  visible="false" managed="false" styleClass="empty-state">
                                <Label text="📖" style="-fx-font-size:52px;"/>
                                <Label text="Aucun cours dans ce module"
                                       style="-fx-font-size:18px; -fx-font-weight:700; -fx-text-fill:#64748b;"/>
                            </VBox>
                        </VBox>
                    </Tab>

                    <!-- Favorites Tab -->
                    <Tab text="⭐ Mes Favoris">
                        <VBox spacing="16.0">
                            <padding><Insets top="18.0"/></padding>

                            <HBox spacing="12.0" alignment="CENTER_LEFT">
                                <TextField fx:id="favSearchField" promptText="🔍 Rechercher dans les favoris..." prefWidth="320.0"
                                           styleClass="search-field"
                                           onKeyReleased="#handleFavSearch"/>
                                <Button text="➕ Ajouter des favoris" onAction="#handleAddFavoris" styleClass="btn-primary"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="favCountBadge" text="0 favori(s)"
                                       style="-fx-background-color:linear-gradient(to right, #fef9c3, #fde68a); -fx-text-fill:#92400e; -fx-background-radius:20; -fx-padding:5 14; -fx-font-weight:700; -fx-font-size:12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 1);"/>
                            </HBox>

                            <!-- Favorite cards -->
                            <FlowPane fx:id="favorisContainer" hgap="18.0" vgap="18.0" prefWrapLength="900"/>

                            <!-- Empty favorites -->
                            <VBox fx:id="emptyFavState" alignment="CENTER" spacing="12.0"
                                  visible="false" managed="false" styleClass="empty-state">
                                <Label text="☆" style="-fx-font-size:52px; -fx-text-fill:#94a3b8;"/>
                                <Label text="Aucun cours en favori"
                                       style="-fx-font-size:18px; -fx-font-weight:700; -fx-text-fill:#64748b;"/>
                                <Label text="Cliquez sur ☆ dans une carte pour ajouter un cours à vos favoris."
                                       style="-fx-text-fill:#94a3b8; -fx-font-size:13;"/>
                            </VBox>
                        </VBox>
                    </Tab>

                </TabPane>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
