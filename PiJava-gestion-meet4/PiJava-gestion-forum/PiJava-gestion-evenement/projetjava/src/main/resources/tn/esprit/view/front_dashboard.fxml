            <Button fx:id="btnSignIn" text="Sign In" styleClass="btn-dark" onAction="#handleSignIn"/>
            <Button fx:id="btnSignUp" text="Sign up" styleClass="btn-primary" onAction="#handleSignUp"/>

            <!-- Menu shown when logged in -->
