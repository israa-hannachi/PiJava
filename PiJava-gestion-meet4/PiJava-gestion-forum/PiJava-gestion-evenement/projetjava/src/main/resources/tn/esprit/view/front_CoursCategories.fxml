<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.front.FrontCoursCategorieController"
            prefWidth="1280" prefHeight="820" minWidth="1180" minHeight="760"
            stylesheets="@cours-ui.css"
            styleClass="cours-root">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="140.0" spacing="6.0" styleClass="sidebar-modern">
            <padding><Insets top="16.0" right="10.0" bottom="16.0" left="10.0"/></padding>

            <ImageView fitHeight="56.0" preserveRatio="true" pickOnBounds="true">
                <image><Image url="@/assets/images/logo.png"/></image>
            </ImageView>

            <Region prefHeight="8"/>

            <Button text="🏠 Accueil" onAction="#handleHome" maxWidth="1.7976931348623157E308"
                    styleClass="sidebar-btn"/>
            <Button text="👤 Profil" maxWidth="1.7976931348623157E308" onAction="#handleProfile"
                    styleClass="sidebar-btn"/>
            <Button text="📚 Cours" maxWidth="1.7976931348623157E308"
                    styleClass="sidebar-btn-active"/>
            <Button text="📹 Meet" maxWidth="1.7976931348623157E308"
                    styleClass="sidebar-btn"/>
            <Button text="🎮 Jeux" onAction="#handleJeux" maxWidth="1.7976931348623157E308"
                    styleClass="sidebar-btn"/>
            <Button text="📅 Events" maxWidth="1.7976931348623157E308" onAction="#handleEvents"
                    styleClass="sidebar-btn"/>
            <Button text="💬 Forums" maxWidth="1.7976931348623157E308" onAction="#handleForums"
                    styleClass="sidebar-btn"/>

            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <!-- TOP BAR -->
    <top>
        <HBox spacing="14.0" alignment="CENTER_LEFT" styleClass="glass-header">
            <padding><Insets top="12.0" right="24.0" bottom="12.0" left="24.0"/></padding>
            <Label text="Naja7ni" style="-fx-font-size:26px; -fx-font-weight:800; -fx-text-fill:#0FB5A9;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="🔍 Rechercher une catégorie..." prefWidth="380.0"
                       styleClass="search-field"
                       onKeyReleased="#handleSearch"/>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Role badge -->
            <Label fx:id="roleBadge" text="" visible="false" managed="false"/>
            <!-- Back button -->
            <Button text="← Retour" onAction="#handleBack" styleClass="btn-back"/>
            <Button fx:id="profileButton" text="Profile" onAction="#handleProfile" styleClass="btn-profile"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" vbarPolicy="ALWAYS" hbarPolicy="NEVER" pannable="true" styleClass="page-scroll">
            <VBox spacing="22.0" style="-fx-background-color:transparent;">
                <padding><Insets top="28.0" right="32.0" bottom="28.0" left="32.0"/></padding>

                <!-- Header banner with 3D effect -->
                <VBox spacing="8.0" styleClass="banner-gradient">
                    <Label text="📂 Catégories de Cours"
                           style="-fx-font-size:30px; -fx-font-weight:800; -fx-text-fill:white;"/>
                    <Label text="Choisissez une catégorie pour explorer les modules disponibles"
                           style="-fx-font-size:14px; -fx-text-fill:rgba(255,255,255,0.92);"/>
                </VBox>

                <!-- Stats row with 3D cards -->
                <HBox spacing="16.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="stat-card">
                        <Label fx:id="totalCatLabel" text="—" style="-fx-font-size:32px; -fx-font-weight:800; -fx-text-fill:#1f2937;"/>
                        <Label text="Catégories" style="-fx-text-fill:#64748b; -fx-font-size:13px;"/>
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="stat-card">
                        <Label fx:id="totalModLabel" text="—" style="-fx-font-size:32px; -fx-font-weight:800; -fx-text-fill:#0FB5A9;"/>
                        <Label text="Modules" style="-fx-text-fill:#64748b; -fx-font-size:13px;"/>
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS" styleClass="stat-card">
                        <Label fx:id="totalCoursLabel" text="—" style="-fx-font-size:32px; -fx-font-weight:800; -fx-text-fill:#2563eb;"/>
                        <Label text="Cours" style="-fx-text-fill:#64748b; -fx-font-size:13px;"/>
                    </VBox>
                </HBox>

                <!-- Sort bar -->
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Trier:" style="-fx-text-fill:#64748b; -fx-font-size:13px; -fx-font-weight:600;"/>
                    <Button text="Nom A→Z" onAction="#sortAZ" styleClass="sort-pill"/>
                    <Button text="Nom Z→A" onAction="#sortZA" styleClass="sort-pill"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="countLabel" text="" style="-fx-text-fill:#94a3b8; -fx-font-size:12px;"/>
                </HBox>

                <!-- Cards grid -->
                <FlowPane fx:id="categoriesContainer" hgap="18.0" vgap="18.0" prefWrapLength="900"/>

                <!-- Empty state -->
                <VBox fx:id="emptyState" alignment="CENTER" spacing="12.0" visible="false" managed="false"
                      styleClass="empty-state">
                    <Label text="😕" style="-fx-font-size:52px;"/>
                    <Label text="Aucune catégorie trouvée" style="-fx-font-size:18px; -fx-font-weight:700; -fx-text-fill:#64748b;"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
