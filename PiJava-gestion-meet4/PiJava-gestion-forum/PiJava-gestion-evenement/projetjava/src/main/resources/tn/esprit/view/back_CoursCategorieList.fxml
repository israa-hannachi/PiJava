<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.Back.BackCoursCategorieController"
            prefWidth="1280" prefHeight="820" minWidth="1180" minHeight="760"
            stylesheets="@cours-ui.css"
            styleClass="cours-root">

    <!-- SIDEBAR (hidden when loaded into admin dashboard contentArea) -->
    <left>
        <VBox prefWidth="230" styleClass="admin-sidebar">
            <Label text="NAJA7NI ADMIN" styleClass="admin-brand" />
            <Label text="Navigation" styleClass="admin-kicker" />
            <Button text="🏠 Dashboard" maxWidth="Infinity" onAction="#handleDashboard"
                    styleClass="admin-nav-btn" />
            <Button text="📚 Cours" maxWidth="Infinity"
                    styleClass="admin-nav-group" />
            <Button text="   📂 Catégories" maxWidth="Infinity" onAction="#handleCategories"
                    styleClass="admin-subnav-active" />
            <Button text="   📦 Modules" maxWidth="Infinity" onAction="#handleModules"
                    styleClass="admin-subnav-btn" />
            <Button text="   📖 Cours" maxWidth="Infinity" onAction="#handleCours"
                    styleClass="admin-subnav-btn" />
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪 Logout" maxWidth="Infinity" onAction="#handleLogout"
                    styleClass="admin-logout-btn" />
        </VBox>
    </left>

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              styleClass="screen-header">
            <Label text="📂 Gestion des Catégories" styleClass="screen-title" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" promptText="🔍 Rechercher..."
                       prefWidth="260"
                       styleClass="search-field"
                       onKeyReleased="#handleSearch"/>
            <ComboBox fx:id="filterActif" promptText="Statut" prefWidth="120"
                      styleClass="filter-combo" onAction="#handleFilterActif"/>
            <Button text="➕ Ajouter" onAction="#handleAddCategorie"
                    styleClass="btn-primary"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" vbarPolicy="ALWAYS" hbarPolicy="NEVER" pannable="true" styleClass="page-scroll">
            <VBox spacing="16" styleClass="content-shell">

            <!-- Breadcrumb -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Dashboard" style="-fx-text-fill: #64748b; -fx-font-size: 13;" />
                <Label text="›" style="-fx-text-fill: #94a3b8;" />
                <Label text="Cours" style="-fx-text-fill: #64748b; -fx-font-size: 13;" />
                <Label text="›" style="-fx-text-fill: #94a3b8;" />
                <Label text="Catégories" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 13;" />
            </HBox>

            <!-- Stats Strip with 3D -->
            <HBox spacing="14">
                <VBox spacing="4" HBox.hgrow="ALWAYS"
                      styleClass="stat-card-accent">
                    <Label text="Total Catégories" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
                    <Label fx:id="totalCatLabel" text="—" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS"
                      styleClass="stat-card-accent">
                    <Label text="Actives" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
                    <Label fx:id="activeCatLabel" text="—" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS"
                      styleClass="stat-card-accent">
                    <Label text="Inactives" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
                    <Label fx:id="inactiveCatLabel" text="—" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                </VBox>
            </HBox>

            <!-- Sort bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Trier par:" style="-fx-text-fill: #64748b; -fx-font-size: 12; -fx-font-weight:600;"/>
                <Button text="Nom ↕" onAction="#sortByNom"
                        styleClass="sort-pill"/>
                <Button text="Date ↕" onAction="#sortByDate"
                        styleClass="sort-pill"/>
                <Button text="Statut ↕" onAction="#sortByStatut"
                        styleClass="sort-pill"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="resultCountLabel" text="" style="-fx-text-fill: #64748b; -fx-font-size: 12;"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="categorieTable" VBox.vgrow="ALWAYS"
                       styleClass="table-card">
                <columns>
                    <TableColumn fx:id="colNom" text="Nom" prefWidth="220"/>
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="350"/>
                    <TableColumn fx:id="colDateCreation" text="Date Création" prefWidth="150"/>
                    <TableColumn fx:id="colActif" text="Statut" prefWidth="100"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="200"/>
                </columns>
            </TableView>

            <!-- Error label -->
            <Label fx:id="errorLabel" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 12;" visible="false" managed="false"/>

        </VBox>
    
        </ScrollPane>
    </center>

</BorderPane>
