<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.front.FrontLoginController"
      prefWidth="1200" prefHeight="760" style="-fx-background-color: #FFFFFF;">

    <VBox prefWidth="600" alignment="CENTER" spacing="18"
          style="-fx-background-color: rgba(15,181,169,0.10);">
        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <Label text="Welcome to our largest community" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #2D3748;"/>
        <Label text="Let's learn something new today!" style="-fx-font-size: 16; -fx-text-fill: #4A5568;"/>
        <Region prefHeight="220" prefWidth="380" style="-fx-background-color: #E6FFFD; -fx-background-radius: 18;"/>
        <Label text="4k+ Students joined us, now it's your turn." style="-fx-font-size: 14; -fx-text-fill: #4A5568;"/>
    </VBox>

    <VBox prefWidth="600" alignment="CENTER_LEFT" spacing="12">
        <padding>
            <Insets top="40" right="80" bottom="40" left="80"/>
        </padding>

        <Label text="👋" style="-fx-font-size: 34;"/>
        <Label text="Login to naja7ni!" style="-fx-font-size: 30; -fx-font-weight: bold;"/>
        <Label text="Nice to see you! Please log in with your account." style="-fx-font-size: 15; -fx-text-fill: #718096;"/>

        <Label text="Email address *" style="-fx-font-weight: 600;"/>
        <TextField fx:id="emailField" promptText="E-mail"
                   style="-fx-background-color: #F7FAFC; -fx-background-radius: 10; -fx-padding: 12;"/>

        <Label text="Password *" style="-fx-font-weight: 600;"/>
        <PasswordField fx:id="passwordField" promptText="password"
                       style="-fx-background-color: #F7FAFC; -fx-background-radius: 10; -fx-padding: 12;"/>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <CheckBox fx:id="rememberCheck" text="Remember me"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Hyperlink text="Forgot password?" style="-fx-text-fill: #04B6D5;" onAction="#handleForgotPassword"/>
        </HBox>

        <Button text="Login" maxWidth="1.7976931348623157E308" onAction="#handleLogin"
                style="-fx-background-color: #0FB5A9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12;"/>

        <HBox alignment="CENTER" spacing="8">
            <Separator prefWidth="120"/>
            <Label text="Or" style="-fx-text-fill: #718096;"/>
            <Separator prefWidth="120"/>
        </HBox>

        <HBox spacing="10">
            <Button text="Login with Google" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #EA4335; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 14;"/>
            <Button text="Login with Face ID" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #1F2937; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 14;"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="6">
            <Label text="Don't have an account?"/>
            <Hyperlink text="Signup here" style="-fx-text-fill: #04B6D5;" onAction="#handleSignup"/>
        </HBox>
    </VBox>
</HBox>

