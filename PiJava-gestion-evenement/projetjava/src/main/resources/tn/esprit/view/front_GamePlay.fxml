<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.front.FrontGamePlayController"
            prefWidth="1440.0" prefHeight="980.0"
            style="-fx-background-color:#FFFFFF; -fx-font-family:'Segoe UI';">

    <!-- Sidebar (identique à front_GameList) -->
    <left>
        <VBox prefWidth="120.0" spacing="8.0"
              style="-fx-background-color:#F7FFFE; -fx-border-color:rgba(15,181,169,0.10); -fx-border-width:0 1 0 0;">
            <padding><Insets top="14.0" right="8.0" bottom="14.0" left="8.0"/></padding>

            <ImageView fitHeight="62.0" preserveRatio="true" pickOnBounds="true">
                <image>
                    <Image url="@/assets/images/logo.png"/>
                </image>
            </ImageView>

            <Button onAction="#handleAccueil" text="🏠 Accueil" maxWidth="Infinity"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-font-weight:700;"/>
            <Button onAction="#handleProfile" text="👤 Profil" maxWidth="Infinity"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b;"/>
            <Button onAction="#handleCours" text="📚 Cours" maxWidth="Infinity"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b;"/>
            <Button text="🧭 Parcours" maxWidth="Infinity"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b;"/>
            <Button text="🎥 Meet" maxWidth="Infinity"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b;"/>
            <Button onAction="#handleGameList" text="🎮 Jeux" maxWidth="Infinity"
                    style="-fx-background-color:rgba(15,181,169,0.14); -fx-text-fill:#0FB5A9; -fx-font-weight:700;"/>
            <Button onAction="#handleEvents" text="📅 Events" maxWidth="Infinity"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b;"/>
            <Button text="💬 Forums" maxWidth="Infinity" onAction="#handleForums"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b;"/>

            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <!-- Top bar (identique à front_GameList mais avec retour) -->
    <top>
        <HBox spacing="12.0" alignment="CENTER_LEFT"
              style="-fx-background-color:#FFFFFF; -fx-border-color:rgba(15,181,169,0.12); -fx-border-width:0 0 1 0;">
            <padding><Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/></padding>
            <Label fx:id="gameTitleLabel" text="🎮 Jouer : [Titre du jeu]"
                   style="-fx-font-size:24px; -fx-font-weight:800; -fx-text-fill:#0FB5A9;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="↩ Retour" onAction="#handleBack"
                    style="-fx-background-color:#e5e7eb; -fx-text-fill:#1f2937; -fx-font-weight:700; -fx-background-radius:8;"/>
        </HBox>
    </top>

    <!-- Centre : contenu du jeu -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background:#F0FFFE;">
            <content>
                <VBox spacing="20.0" style="-fx-padding:20;">

                    <!-- Timer -->
                    <Label fx:id="timerLabel" text="⏰ Temps restant : --"
                           style="-fx-font-size:18px; -fx-font-weight:700; -fx-text-fill:#dc2626;"/>

                    <!-- Scores -->
                    <HBox spacing="20.0">
                        <VBox style="-fx-background-color:#0FB5A9; -fx-background-radius:12; -fx-padding:16;" HBox.hgrow="ALWAYS">
                            <Label text="Dernier score" style="-fx-text-fill:white;"/>
                            <Label fx:id="lastScoreLabel" text="--" style="-fx-font-size:22px; -fx-font-weight:700; -fx-text-fill:white;"/>
                        </VBox>
                        <VBox style="-fx-background-color:#7e22ce; -fx-background-radius:12; -fx-padding:16;" HBox.hgrow="ALWAYS">
                            <Label text="Moyenne des scores" style="-fx-text-fill:white;"/>
                            <Label fx:id="avgScoreLabel" text="--" style="-fx-font-size:22px; -fx-font-weight:700; -fx-text-fill:white;"/>
                        </VBox>
                        <VBox style="-fx-background-color:#f59e0b; -fx-background-radius:12; -fx-padding:16;" HBox.hgrow="ALWAYS">
                            <Label text="Tentatives" style="-fx-text-fill:white;"/>
                            <Label fx:id="attemptLabel" text="--" style="-fx-font-size:22px; -fx-font-weight:700; -fx-text-fill:white;"/>
                        </VBox>
                    </HBox>

                    <!-- Progression -->
                    <VBox style="-fx-background-color:#22c55e; -fx-background-radius:12; -fx-padding:16;">
                        <Label text="🎯 Progression de l'étudiant" style="-fx-font-size:18px; -fx-font-weight:700; -fx-text-fill:white;"/>
                        <ProgressBar fx:id="progressBar" progress="0.0" prefWidth="400"/>
                        <Label fx:id="badgeLabel" text="" style="-fx-font-size:16px; -fx-font-weight:700; -fx-text-fill:white;"/>
                    </VBox>

                    <!-- Questions -->
                    <VBox fx:id="questionsContainer" spacing="16.0"/>

                    <!-- Bouton Valider -->
                    <Button text="🚀 Valider mes réponses" onAction="#handleSubmit"
                            style="-fx-background-color:#0FB5A9; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:8; -fx-padding:10 20;"/>

                    <!-- Bouton Calculatrice -->
                    <Button text="🧮 Calculatrice" onAction="#openCalculator"
                            style="-fx-background-color:#64748b; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:8; -fx-padding:8 16;"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
