<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.Back.BackCoursCategorieController"
            style="-fx-background-color: #f8fafc;">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color: #1e293b;">
            <Label text="NAJA7NI ADMIN" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 20 20 10 20;" />
            <Label text="Navigation" style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-padding: 0 20 8 20;" />
            <Button text="🏠 Dashboard" maxWidth="Infinity" onAction="#handleDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;" />
            <Button text="📚 Cours" maxWidth="Infinity"
                    style="-fx-background-color: #334155; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;" />
            <Button text="   📂 Catégories" maxWidth="Infinity" onAction="#handleCategories"
                    style="-fx-background-color: #0FB5A9; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 8 30;" />
            <Button text="   📦 Modules" maxWidth="Infinity" onAction="#handleModules"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-alignment: CENTER_LEFT; -fx-padding: 8 30;" />
            <Button text="   📖 Cours" maxWidth="Infinity" onAction="#handleCours"
                    style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-alignment: CENTER_LEFT; -fx-padding: 8 30;" />
            <Button text="🎮 Jeux" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;" />
            <Button text="💬 Forums" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;" />
            <Button text="📅 Events" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;" />
            <Button text="📹 Meet" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;" />
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪 Logout" maxWidth="Infinity" onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-text-fill: #f87171; -fx-alignment: CENTER_LEFT; -fx-padding: 10 20;" />
        </VBox>
    </left>

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0; -fx-padding: 12 20;">
            <Label text="📂 Gestion des Catégories" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="searchField" promptText="🔍 Rechercher une catégorie..."
                       prefWidth="280"
                       style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 8 12;"
                       onKeyReleased="#handleSearch"/>
            <ComboBox fx:id="filterActif" promptText="Statut" prefWidth="120"
                      style="-fx-background-radius: 8; -fx-border-color: #e2e8f0;" onAction="#handleFilterActif"/>
            <Button text="➕ Ajouter" onAction="#handleAddCategorie"
                    style="-fx-background-color:#0FB5A9; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:8; -fx-padding:8 16;"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="14" style="-fx-padding: 20; -fx-background-color: #f8fafc;">

            <!-- Breadcrumb -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Dashboard" style="-fx-text-fill: #64748b; -fx-font-size: 13;" />
                <Label text="›" style="-fx-text-fill: #94a3b8;" />
                <Label text="Cours" style="-fx-text-fill: #64748b; -fx-font-size: 13;" />
                <Label text="›" style="-fx-text-fill: #94a3b8;" />
                <Label text="Catégories" style="-fx-text-fill: #0f172a; -fx-font-weight: bold; -fx-font-size: 13;" />
            </HBox>

            <!-- Stats Strip -->
            <HBox spacing="12">
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 12 20;" HBox.hgrow="ALWAYS">
                    <Label text="Total Catégories" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
                    <Label fx:id="totalCatLabel" text="—" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                </VBox>
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 12 20;" HBox.hgrow="ALWAYS">
                    <Label text="Actives" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
                    <Label fx:id="activeCatLabel" text="—" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                </VBox>
                <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 12 20;" HBox.hgrow="ALWAYS">
                    <Label text="Inactives" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
                    <Label fx:id="inactiveCatLabel" text="—" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                </VBox>
            </HBox>

            <!-- Sort bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Trier par:" style="-fx-text-fill: #64748b; -fx-font-size: 12;"/>
                <Button text="Nom ↕" onAction="#sortByNom"
                        style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-padding: 5 12; -fx-font-size: 12;"/>
                <Button text="Date ↕" onAction="#sortByDate"
                        style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-padding: 5 12; -fx-font-size: 12;"/>
                <Button text="Statut ↕" onAction="#sortByStatut"
                        style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-padding: 5 12; -fx-font-size: 12;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="resultCountLabel" text="" style="-fx-text-fill: #64748b; -fx-font-size: 12;"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="categorieTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colNom" text="Nom" prefWidth="180"/>
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="300"/>
                    <TableColumn fx:id="colDateCreation" text="Date Création" prefWidth="160"/>
                    <TableColumn fx:id="colActif" text="Statut" prefWidth="90"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="160"/>
                </columns>
            </TableView>

            <!-- Error label -->
            <Label fx:id="errorLabel" text="" style="-fx-text-fill: #dc2626; -fx-font-size: 12;" visible="false" managed="false"/>

        </VBox>
    </center>

</BorderPane>
