# ============================================================
# FICHIER EXEMPLE - Copiez ce fichier en .env
# et remplissez vos propres clés API
# NE JAMAIS committer .env avec de vraies clés !
# ============================================================

# ── IA / API ────────────────────────────────────────────
# Clé Groq gratuite : https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Base de données ──────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/pidev_db
DB_USER=root
DB_PASSWORD=your_db_password_here

# ── Application ──────────────────────────────────────────
APP_NAME=Naja7ni
