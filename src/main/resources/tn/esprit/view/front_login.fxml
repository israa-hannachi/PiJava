<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.controllers.front.FrontLoginController"
           prefWidth="1200" prefHeight="760" style="-fx-background-color: #F3F4F6; -fx-font-family: 'Segoe UI';">

    <HBox alignment="CENTER" maxWidth="1000" maxHeight="600" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
        <!-- Left Side: Hero Section -->
        <VBox prefWidth="500" alignment="CENTER" spacing="25"
              style="-fx-background-color: linear-gradient(to bottom right, #0FB5A9, #04B6D5); -fx-background-radius: 20 0 0 20;">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <ImageView fitWidth="350" preserveRatio="true" pickOnBounds="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);">
                <image><Image url="@/assets/images/logo.png"/></image>
            </ImageView>
            <Label text="Welcome to our largest community" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white; -fx-wrap-text: true; -fx-alignment: center;"/>
            <Label text="Let's learn something new today!" style="-fx-font-size: 16; -fx-text-fill: rgba(255,255,255,0.9); -fx-wrap-text: true; -fx-alignment: center;"/>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <VBox spacing="10" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 15; -fx-padding: 20;">
                <Label text="🌟 4k+ Students joined us" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Now it's your turn to start the journey." style="-fx-font-size: 14; -fx-text-fill: rgba(255,255,255,0.8);"/>
            </VBox>
        </VBox>

        <!-- Right Side: Login Form -->
        <VBox prefWidth="500" alignment="CENTER_LEFT" spacing="15">
            <padding>
                <Insets top="50" right="60" bottom="50" left="60"/>
            </padding>

            <VBox spacing="5">
                <Label text="Welcome Back 👋" style="-fx-font-size: 28; -fx-font-weight: 800; -fx-text-fill: #1F2937;"/>
                <Label text="Please enter your details to sign in." style="-fx-font-size: 15; -fx-text-fill: #6B7280;"/>
            </VBox>

            <Region prefHeight="10"/>

            <VBox spacing="8">
                <Label text="Email address" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                <TextField fx:id="emailField" promptText="Enter your email"
                           style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15; -fx-font-size: 14;"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Password" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                <PasswordField fx:id="passwordField" promptText="••••••••"
                               style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15; -fx-font-size: 14;"/>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <CheckBox fx:id="rememberCheck" text="Remember me" style="-fx-text-fill: #4B5563;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Forgot password?" style="-fx-text-fill: #0FB5A9; -fx-font-weight: 600;" onAction="#handleForgotPassword"/>
            </HBox>

            <Region prefHeight="10"/>

            <Button text="Sign In" maxWidth="1.7976931348623157E308" onAction="#handleLogin"
                    style="-fx-background-color: #0FB5A9; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;"/>

            <HBox alignment="CENTER" spacing="10">
                <Separator HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;"/>
                <Label text="or continue with" style="-fx-text-fill: #6B7280; -fx-font-size: 13;"/>
                <Separator HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;"/>
            </HBox>

            <HBox spacing="15">
                <Button text="Google" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" onAction="#handleGoogleLogin"
                        style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #374151; -fx-font-weight: 600; -fx-padding: 10; -fx-cursor: hand;"/>
                <Button text="Face ID" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308" onAction="#handleFaceLogin"
                        style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #374151; -fx-font-weight: 600; -fx-padding: 10; -fx-cursor: hand;"/>
            </HBox>

            <Region prefHeight="10"/>

            <HBox alignment="CENTER" spacing="5">
                <Label text="Don't have an account?" style="-fx-text-fill: #4B5563;"/>
                <Hyperlink text="Sign up for free" style="-fx-text-fill: #0FB5A9; -fx-font-weight: bold;" onAction="#handleSignup"/>
            </HBox>
        </VBox>
    </HBox>
</StackPane>
