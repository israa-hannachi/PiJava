<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.front.FrontUserDashboardController"
            prefWidth="1200.0" prefHeight="880.0"
            style="-fx-background-color: #F3F4F6; -fx-font-family: 'Segoe UI';">

    <left>
        <VBox prefWidth="250.0" spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 2, 0);">
            <padding><Insets top="20.0" right="15.0" bottom="20.0" left="15.0"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <ImageView fitWidth="180.0" preserveRatio="true" pickOnBounds="true">
                    <image><Image url="@/assets/images/logo.png"/></image>
                </ImageView>
            </HBox>
            
            <Region prefHeight="20"/>

            <Button text="🏠 Accueil" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT"
                    style="-fx-background-color: linear-gradient(to right, rgba(15,181,169,0.1), rgba(15,181,169,0.05)); -fx-text-fill:#0FB5A9; -fx-font-weight:700; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-border-color: #0FB5A9; -fx-border-width: 0 0 0 4; -fx-border-radius: 10;"/>
            <Button text="👤 Profil" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleProfile"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>
            <Button text="📚 Cours" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleCours"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>
            <Button text="🎥 Meet" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleMeets"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>
            <Button text="🎮 Jeux" onAction="#handleGameList" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>
            <Button text="📅 Events" onAction="#handleEvents" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>
            <Button text="💬 Forums" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleForums"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>
            
            <VBox spacing="10" style="-fx-background-color: linear-gradient(to bottom right, #0FB5A9, #04B6D5); -fx-background-radius: 15; -fx-padding: 20;">
                <Label text="Need Help?" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 16;"/>
                <Label text="Check our docs or contact support." style="-fx-text-fill: rgba(255,255,255,0.9); -fx-wrap-text: true;"/>
                <Button text="Support" style="-fx-background-color: white; -fx-text-fill: #0FB5A9; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox spacing="15.0" alignment="CENTER_LEFT"
              style="-fx-background-color:#FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
            <padding><Insets top="15.0" right="30.0" bottom="15.0" left="30.0"/></padding>

            <Label text="Dashboard" style="-fx-font-size:22px; -fx-font-weight:700; -fx-text-fill:#1F2937;" />

            <Region HBox.hgrow="ALWAYS"/>

            <TextField promptText="Rechercher des cours, modules..." prefWidth="350.0"
                       style="-fx-background-color:#F3F4F6; -fx-background-radius:20; -fx-border-color:transparent; -fx-padding:10 20; -fx-font-size: 14;" />

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="adminButton" text="⚙ Back Office" onAction="#handleBackOffice"
                    visible="false" managed="false"
                    style="-fx-background-color:#1F2937; -fx-text-fill:#F87171; -fx-font-weight:700; -fx-background-radius:8; -fx-padding:8 14; -fx-cursor: hand;" />
                <HBox spacing="15.0" alignment="CENTER_RIGHT">
                <StackPane>
                    <Button fx:id="notificationsButton" text="🔔" onAction="#handleNotifications"
                        style="-fx-background-color:#F3F4F6; -fx-background-radius:50; -fx-padding:10; -fx-font-size:16px; -fx-cursor: hand;" />
                    <Label fx:id="notificationBadge" text="3" visible="false" managed="false"
                       StackPane.alignment="TOP_RIGHT"
                       style="-fx-background-color:#EF4444; -fx-text-fill:white; -fx-font-size:10px; -fx-font-weight:800; -fx-background-radius:999; -fx-padding:2 6; -fx-translate-x:6; -fx-translate-y:-6;" />
                </StackPane>

                <Button fx:id="profileButton" text="Profile" onAction="#handleProfile"
                    style="-fx-background-color:linear-gradient(to bottom right, #0FB5A9, #04B6D5); -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:20; -fx-padding: 8 20; -fx-font-size: 14; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(15,181,169,0.3), 10, 0, 0, 4);" />
                </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #F3F4F6; -fx-background-color: transparent; -fx-border-color: transparent;">
            <content>
                <VBox spacing="25.0" style="-fx-background-color:#F3F4F6;">
                    <padding><Insets top="30.0" right="40.0" bottom="40.0" left="40.0"/></padding>

                    <!-- Welcome Banner -->
                    <VBox spacing="10.0"
                          style="-fx-background-color:linear-gradient(to right, #0FB5A9, #04B6D5); -fx-background-radius:20; -fx-padding:30; -fx-effect: dropshadow(three-pass-box, rgba(15,181,169,0.3), 15, 0, 0, 5);">
                        <Label fx:id="welcomeLabel" text="Bienvenue sur Naja7ni! 👋"
                               style="-fx-font-size:32px; -fx-font-weight:800; -fx-text-fill:white;" />
                        <Label text="Continuez votre parcours d'apprentissage aujourd'hui"
                               style="-fx-font-size:16px; -fx-text-fill:rgba(255,255,255,0.9);" />
                    </VBox>

                    <!-- Stats Cards -->
                    <GridPane hgap="20.0" vgap="20.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25.0"/>
                            <ColumnConstraints percentWidth="25.0"/>
                            <ColumnConstraints percentWidth="25.0"/>
                            <ColumnConstraints percentWidth="25.0"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0" spacing="10.0"
                              style="-fx-background-color:#ffffff; -fx-background-radius:15; -fx-padding:20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="5">
                                    <Label text="Cours en cours" style="-fx-text-fill:#6B7280; -fx-font-weight: 600;"/>
                                    <Label text="12" style="-fx-font-size:32px; -fx-font-weight:800; -fx-text-fill:#1F2937;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="📚" style="-fx-font-size: 30; -fx-background-color: #E0F2FE; -fx-padding: 10; -fx-background-radius: 12;"/>
                            </HBox>
                        </VBox>

                        <VBox GridPane.columnIndex="1" spacing="10.0"
                              style="-fx-background-color:#ffffff; -fx-background-radius:15; -fx-padding:20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="5">
                                    <Label text="Certificats obtenus" style="-fx-text-fill:#6B7280; -fx-font-weight: 600;"/>
                                    <Label text="8" style="-fx-font-size:32px; -fx-font-weight:800; -fx-text-fill:#1F2937;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="🎓" style="-fx-font-size: 30; -fx-background-color: #FEF3C7; -fx-padding: 10; -fx-background-radius: 12;"/>
                            </HBox>
                        </VBox>

                        <VBox GridPane.columnIndex="2" spacing="10.0"
                              style="-fx-background-color:#ffffff; -fx-background-radius:15; -fx-padding:20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="5">
                                    <Label text="Points XP" style="-fx-text-fill:#6B7280; -fx-font-weight: 600;"/>
                                    <Label text="1,240" style="-fx-font-size:32px; -fx-font-weight:800; -fx-text-fill:#1F2937;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="⭐" style="-fx-font-size: 30; -fx-background-color: #FEF08A; -fx-padding: 10; -fx-background-radius: 12;"/>
                            </HBox>
                        </VBox>

                        <VBox GridPane.columnIndex="3" spacing="10.0"
                              style="-fx-background-color:#ffffff; -fx-background-radius:15; -fx-padding:20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="5">
                                    <Label text="Temps d'étude" style="-fx-text-fill:#6B7280; -fx-font-weight: 600;"/>
                                    <Label text="48h" style="-fx-font-size:32px; -fx-font-weight:800; -fx-text-fill:#1F2937;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="⏱" style="-fx-font-size: 30; -fx-background-color: #E9D5FF; -fx-padding: 10; -fx-background-radius: 12;"/>
                            </HBox>
                        </VBox>
                    </GridPane>

                    <!-- Quick access to modules -->
                    <HBox spacing="20.0">
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:white; -fx-background-radius:15; -fx-padding:25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <Label text="📚 Catalogue de Cours" style="-fx-font-size:20px; -fx-font-weight:800; -fx-text-fill:#1F2937;"/>
                            <Label text="Explorez toutes les catégories, modules et cours disponibles."
                                   style="-fx-text-fill:#6B7280; -fx-wrap-text:true; -fx-font-size: 14;"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <Button text="Parcourir les cours →" onAction="#handleCours"
                                    style="-fx-background-color:#0FB5A9; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:8; -fx-padding:10 20; -fx-cursor: hand;"/>
                        </VBox>

                        <VBox spacing="15.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:white; -fx-background-radius:15; -fx-padding:25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <Label text="📹 Réunions Meet" style="-fx-font-size:20px; -fx-font-weight:800; -fx-text-fill:#1F2937;"/>
                            <Label text="Rejoignez des sessions en direct avec vos enseignants et collègues."
                                   style="-fx-text-fill:#6B7280; -fx-wrap-text:true; -fx-font-size: 14;"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <Button text="Rejoindre Meet →" onAction="#handleMeets"
                                    style="-fx-background-color:#0EA5E9; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:8; -fx-padding:10 20; -fx-cursor: hand;"/>
                        </VBox>

                        <VBox spacing="15.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:white; -fx-background-radius:15; -fx-padding:25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <Label text="🎮 Jeux Éducatifs" style="-fx-font-size:20px; -fx-font-weight:800; -fx-text-fill:#1F2937;"/>
                            <Label text="Testez vos connaissances avec des quiz et jeux interactifs."
                                   style="-fx-text-fill:#6B7280; -fx-wrap-text:true; -fx-font-size: 14;"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <Button text="Jouer maintenant →" onAction="#handleGameList"
                                    style="-fx-background-color:#8B5CF6; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:8; -fx-padding:10 20; -fx-cursor: hand;"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="15.0">
                        <Label text="Cours Récents" style="-fx-font-size:24px; -fx-font-weight:800; -fx-text-fill:#111827;"/>
                        <HBox spacing="20.0">
                            <VBox prefWidth="380.0" spacing="12.0"
                                  style="-fx-background-color:#ffffff; -fx-background-radius:15; -fx-padding:20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                                <Label text="Développement" style="-fx-background-color:#DBEAFE; -fx-text-fill:#1D4ED8; -fx-background-radius:6; -fx-padding:4 10; -fx-font-weight: 600; -fx-font-size: 12;"/>
                                <Label text="Développement Web Complet" style="-fx-font-size:18px; -fx-font-weight:700; -fx-text-fill: #1F2937;"/>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Progression" style="-fx-text-fill: #6B7280;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="65%" style="-fx-font-weight:700; -fx-text-fill:#0FB5A9;"/>
                                </HBox>
                                <ProgressBar progress="0.65" maxWidth="1.7976931348623157E308" style="-fx-accent: #0FB5A9;"/>
                            </VBox>
                            <VBox prefWidth="380.0" spacing="12.0"
                                  style="-fx-background-color:#ffffff; -fx-background-radius:15; -fx-padding:20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                                <Label text="Design" style="-fx-background-color:#F3E8FF; -fx-text-fill:#7E22CE; -fx-background-radius:6; -fx-padding:4 10; -fx-font-weight: 600; -fx-font-size: 12;"/>
                                <Label text="Design UX/UI" style="-fx-font-size:18px; -fx-font-weight:700; -fx-text-fill: #1F2937;"/>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Progression" style="-fx-text-fill: #6B7280;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="40%" style="-fx-font-weight:700; -fx-text-fill:#8B5CF6;"/>
                                </HBox>
                                <ProgressBar progress="0.40" maxWidth="1.7976931348623157E308" style="-fx-accent: #8B5CF6;"/>
                            </VBox>
                            <VBox prefWidth="380.0" spacing="12.0"
                                  style="-fx-background-color:#ffffff; -fx-background-radius:15; -fx-padding:20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                                <Label text="Marketing" style="-fx-background-color:#DCFCE7; -fx-text-fill:#166534; -fx-background-radius:6; -fx-padding:4 10; -fx-font-weight: 600; -fx-font-size: 12;"/>
                                <Label text="Marketing Digital" style="-fx-font-size:18px; -fx-font-weight:700; -fx-text-fill: #1F2937;"/>
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="Progression" style="-fx-text-fill: #6B7280;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="85%" style="-fx-font-weight:700; -fx-text-fill:#10B981;"/>
                                </HBox>
                                <ProgressBar progress="0.85" maxWidth="1.7976931348623157E308" style="-fx-accent: #10B981;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <GridPane hgap="20.0" vgap="20.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0"/>
                            <ColumnConstraints percentWidth="50.0"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0" spacing="15.0"
                              style="-fx-background-color:#ffffff; -fx-background-radius:15; -fx-padding:25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <Label text="Badges Récents" style="-fx-font-size:20px; -fx-font-weight:800; -fx-text-fill: #1F2937;"/>
                            <HBox spacing="20.0">
                                <Label text="🏆" style="-fx-font-size:40px; -fx-background-color: #FEF3C7; -fx-padding: 15; -fx-background-radius: 50;"/>
                                <Label text="⭐" style="-fx-font-size:40px; -fx-background-color: #FEF08A; -fx-padding: 15; -fx-background-radius: 50;"/>
                                <Label text="🎯" style="-fx-font-size:40px; -fx-background-color: #E0F2FE; -fx-padding: 15; -fx-background-radius: 50;"/>
                                <Label text="🔥" style="-fx-font-size:40px; -fx-background-color: #FEE2E2; -fx-padding: 15; -fx-background-radius: 50;"/>
                            </HBox>
                        </VBox>

                        <VBox GridPane.columnIndex="1" spacing="12.0"
                              style="-fx-background-color:#ffffff; -fx-background-radius:15; -fx-padding:25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <Label text="Classement" style="-fx-font-size:20px; -fx-font-weight:800; -fx-text-fill: #1F2937;"/>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="#1" style="-fx-font-weight:800; -fx-text-fill:#9CA3AF; -fx-font-size: 16;"/>
                                <Label text="  Sarah K." style="-fx-font-weight:700; -fx-font-size: 16; -fx-text-fill: #374151;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="3,240 pts" style="-fx-font-weight:800; -fx-text-fill:#0FB5A9; -fx-font-size: 16;"/>
                            </HBox>
                            <Separator style="-fx-border-color: #F3F4F6; -fx-border-width: 1 0 0 0; -fx-background-color: transparent;"/>
                            <HBox alignment="CENTER_LEFT" style="-fx-background-color:#F0FDF4; -fx-background-radius:8; -fx-padding:10 12; -fx-border-color: #86EFAC; -fx-border-radius: 8;">
                                <Label text="#12" style="-fx-font-weight:800; -fx-text-fill:#16A34A; -fx-font-size: 16;"/>
                                <Label text="  Vous" style="-fx-font-weight:800; -fx-text-fill:#16A34A; -fx-font-size: 16;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="1,240 pts" style="-fx-font-weight:800; -fx-text-fill:#16A34A; -fx-font-size: 16;"/>
                            </HBox>
                        </VBox>
                    </GridPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
