<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.front.FrontForgotPasswordController"
      prefWidth="1200.0" prefHeight="760.0"
      style="-fx-background-color: #ffffff; -fx-font-family: 'Segoe UI';">

    <!-- LEFT PANEL -->
    <VBox prefWidth="600.0" alignment="CENTER" spacing="18.0"
          style="-fx-background-color: rgba(37, 99, 235, 0.10);">
        <padding>
            <Insets top="28.0" right="40.0" bottom="28.0" left="40.0"/>
        </padding>

        <Label text="Reset Your Password"
               style="-fx-font-size: 32px; -fx-font-weight: 800; -fx-text-fill: #1f2937;"/>
        <Label text="We'll send you a code to reset your password"
               style="-fx-font-size: 15px; -fx-text-fill: #475569;"/>

        <!-- Placeholder for left illustration (02.svg equivalent) -->
        <Region prefWidth="360.0" prefHeight="260.0"
                style="-fx-background-color: #e2e8f0; -fx-background-radius: 16;"/>
    </VBox>

    <!-- RIGHT PANEL -->
    <VBox prefWidth="600.0" alignment="CENTER_LEFT" spacing="12.0">
        <padding>
            <Insets top="36.0" right="90.0" bottom="36.0" left="90.0"/>
        </padding>

        <Label text="🔒" style="-fx-font-size: 34px;"/>
        <Label text="Forgot Password"
               style="-fx-font-size: 34px; -fx-font-weight: 800; -fx-text-fill: #0f172a;"/>
        <Label text="Enter your email address and we'll send you a code to reset your password."
               wrapText="true"
               style="-fx-font-size: 15px; -fx-text-fill: #64748b;"/>

        <!-- Success/Error alerts -->
        <Label fx:id="successMessageLabel" visible="false" managed="false"
               style="-fx-background-color: #dcfce7; -fx-text-fill: #166534; -fx-background-radius: 8; -fx-padding: 10 12;"
               text="Success message"/>
        <Label fx:id="errorMessageLabel" visible="false" managed="false"
               style="-fx-background-color: #fee2e2; -fx-text-fill: #991b1b; -fx-background-radius: 8; -fx-padding: 10 12;"
               text="Error message"/>

        <Label text="Email Address" style="-fx-font-weight: 700; -fx-text-fill: #0f172a;"/>
        <TextField fx:id="emailField" promptText="Enter your email address"
                   style="-fx-background-color: #f1f5f9; -fx-background-radius: 10; -fx-padding: 12; -fx-border-color: transparent;"
                   maxWidth="1.7976931348623157E308"/>

        <Button text="Send Reset Code"
                onAction="#handleSendResetCode"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 10; -fx-padding: 12;"
                maxWidth="1.7976931348623157E308"/>

        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <Label text="Remember your password?" style="-fx-text-fill: #64748b;"/>
            <Hyperlink text="Back to login"
                       onAction="#handleBackToLogin"
                       style="-fx-text-fill: #2563eb; -fx-font-weight: 700; -fx-padding: 0;"/>
        </HBox>
    </VBox>
</HBox>

