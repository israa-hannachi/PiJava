<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
                 fx:controller="tn.esprit.controllers.front.FrontForgotPasswordController"
                 prefWidth="1200" prefHeight="760" style="-fx-background-color: #F3F4F6; -fx-font-family: 'Segoe UI';">

       <HBox alignment="CENTER" maxWidth="1000" maxHeight="600"
                style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
              <VBox prefWidth="500" alignment="CENTER" spacing="25"
                       style="-fx-background-color: linear-gradient(to bottom right, #0FB5A9, #04B6D5); -fx-background-radius: 20 0 0 20;">
                     <padding>
                            <Insets top="40" right="40" bottom="40" left="40"/>
                     </padding>

                     <ImageView fitWidth="350" preserveRatio="true" pickOnBounds="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);">
                            <image><Image url="@/assets/images/logo.png"/></image>
                     </ImageView>
                     <Label text="Reset your password" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white; -fx-wrap-text: true; -fx-alignment: center;"/>
                     <Label text="We’ll email you a verification code to restore access." style="-fx-font-size: 16; -fx-text-fill: rgba(255,255,255,0.9); -fx-wrap-text: true; -fx-alignment: center;"/>

                     <Region VBox.vgrow="ALWAYS"/>

                     <VBox spacing="10" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 15; -fx-padding: 20;">
                            <Label text="🔐 Secure recovery" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="Enter your email, verify the code, and choose a new password." style="-fx-font-size: 14; -fx-text-fill: rgba(255,255,255,0.8); -fx-wrap-text: true; -fx-alignment: center;"/>
                     </VBox>
              </VBox>

              <VBox prefWidth="500" alignment="CENTER_LEFT" spacing="15">
                     <padding>
                            <Insets top="50" right="60" bottom="50" left="60"/>
                     </padding>

                     <VBox spacing="5">
                            <Label text="Forgot Password" style="-fx-font-size: 28; -fx-font-weight: 800; -fx-text-fill: #1F2937;"/>
                            <Label text="Enter your email, then verify the code we send you." style="-fx-font-size: 15; -fx-text-fill: #6B7280;"/>
                     </VBox>

                     <Region prefHeight="10"/>

                     <VBox spacing="8">
                            <Label text="Email address" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <TextField fx:id="emailField" promptText="Enter your email"
                                             style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15; -fx-font-size: 14;"/>
                     </VBox>

                     <Button text="Send Reset Code" maxWidth="1.7976931348623157E308" onAction="#handleSendResetCode"
                                   style="-fx-background-color: #0FB5A9; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;"/>

                     <VBox spacing="8" visible="false" managed="false" fx:id="verifyCodeSection">
                            <Label fx:id="verifyCodeLabel" text="Verification Code" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <TextField fx:id="codeField" promptText="Enter the 6-digit code from your email"
                                             style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15; -fx-font-size: 14;"/>
                            <Button fx:id="verifyCodeButton" text="Verify Code" onAction="#handleVerifyCode"
                                          style="-fx-background-color: #04B6D5; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;"/>
                     </VBox>

                     <Label fx:id="successMessageLabel" visible="false" managed="false" style="-fx-background-color: #DCFCE7; -fx-text-fill: #166534; -fx-background-radius: 8; -fx-padding: 10 12;" text="Success message"/>
                     <Label fx:id="errorMessageLabel" visible="false" managed="false" style="-fx-background-color: #FEE2E2; -fx-text-fill: #991B1B; -fx-background-radius: 8; -fx-padding: 10 12;" text="Error message"/>

                     <HBox alignment="CENTER" spacing="5">
                            <Label text="Remember your password?" style="-fx-text-fill: #4B5563;"/>
                            <Hyperlink text="Back to login" style="-fx-text-fill: #0FB5A9; -fx-font-weight: bold;" onAction="#handleBackToLogin"/>
                     </HBox>
              </VBox>
       </HBox>
</StackPane>
