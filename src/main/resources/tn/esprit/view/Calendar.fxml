<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.front.CalendarController"
            prefHeight="760.0" prefWidth="980.0"
            style="-fx-background-color: linear-gradient(to bottom, #f7fbff, #eefaf7);">

    <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                style="-fx-background-color: transparent;">

        <top>
            <VBox spacing="16.0" style="-fx-padding: 22 24 18 24;">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="6.0">
                        <Label text="CALENDRIER PERSONNALISE"
                               style="-fx-background-color: #dff8f4; -fx-text-fill: #0fb5a9;
                                      -fx-font-size: 10px; -fx-font-weight: 800;
                                      -fx-padding: 6 10; -fx-background-radius: 999;"/>
                        <Label text="Mes evenements et inscriptions"
                               style="-fx-font-size: 28px; -fx-font-weight: 900; -fx-text-fill: #0f172a;"/>
                        <Label text="Reperez les jours occupes, ouvrez un event en un clic et laissez votre avis apres participation."
                               style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="todayBtn" text="Aujourd'hui"
                            style="-fx-background-color: white; -fx-text-fill: #475569;
                                   -fx-font-weight: 800; -fx-background-radius: 12;
                                   -fx-border-color: #d8e3ee; -fx-border-radius: 12;
                                   -fx-padding: 10 14; -fx-cursor: hand;"/>
                </HBox>

                <HBox spacing="12.0" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 20;
                             -fx-padding: 14 16; -fx-border-color: #dbeff0; -fx-border-radius: 20;">
                    <Button fx:id="prevMonthBtn" text="&lt;"
                            style="-fx-background-color: #0f172a; -fx-text-fill: white;
                                   -fx-font-weight: 900; -fx-background-radius: 10;
                                   -fx-padding: 8 14; -fx-cursor: hand;"/>
                    <Label fx:id="monthLabel" text="Avril 2026"
                           style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #0f172a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Vue mensuelle"
                           style="-fx-font-size: 12px; -fx-font-weight: 800; -fx-text-fill: #94a3b8;"/>
                    <Button fx:id="nextMonthBtn" text="&gt;"
                            style="-fx-background-color: #0fb5a9; -fx-text-fill: white;
                                   -fx-font-weight: 900; -fx-background-radius: 10;
                                   -fx-padding: 8 14; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </top>

        <center>
            <VBox spacing="14.0" style="-fx-padding: 0 24 24 24;">
                <HBox spacing="10.0">
                    <Label text="Charge faible"
                           style="-fx-background-color: #f8fafc; -fx-text-fill: #64748b; -fx-font-size: 11px;
                                  -fx-font-weight: 700; -fx-padding: 7 10; -fx-background-radius: 999;"/>
                    <Label text="Jour avec event"
                           style="-fx-background-color: #dff8f4; -fx-text-fill: #0fb5a9; -fx-font-size: 11px;
                                  -fx-font-weight: 800; -fx-padding: 7 10; -fx-background-radius: 999;"/>
                    <Label text="Aujourd'hui"
                           style="-fx-background-color: #eff6ff; -fx-text-fill: #2563eb; -fx-font-size: 11px;
                                  -fx-font-weight: 800; -fx-padding: 7 10; -fx-background-radius: 999;"/>
                </HBox>

                <GridPane fx:id="calendarGrid"
                          style="-fx-background-color: white; -fx-background-radius: 24;
                                 -fx-padding: 16; -fx-border-color: #dbeff0; -fx-border-radius: 24;
                                 -fx-effect: dropshadow(three-pass-box, rgba(15,23,42,0.08), 18, 0, 0, 7);"
                          maxWidth="Infinity" maxHeight="Infinity" VBox.vgrow="ALWAYS"/>
            </VBox>
        </center>

    </BorderPane>

</AnchorPane>
