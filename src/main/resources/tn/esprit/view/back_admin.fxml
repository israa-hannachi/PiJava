<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.front.AdminDashboardController">

    <left>
        <VBox id="sidebar" prefWidth="260" style="-fx-background-color: #0F172A; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 15, 0, 0, 0);">
            <padding><Insets top="0" right="0" bottom="0" left="0"/></padding>

            <!-- Logo Section -->
            <VBox prefHeight="85" alignment="CENTER" style="-fx-background-color: #1E293B; -fx-padding: 20;">
                <HBox alignment="CENTER" spacing="10">
                    <Label text="NAJA7NI" style="-fx-font-size:22; -fx-font-weight:900; -fx-text-fill:#0FB5A9;"/>
                    <Label text="ADMIN" style="-fx-font-size:12; -fx-font-weight:700; -fx-text-fill:white; -fx-background-color:#0FB5A9; -fx-background-radius:5; -fx-padding:2 6;"/>
                </HBox>
            </VBox>

            <!-- Navigation Menu -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <VBox spacing="8" style="-fx-padding: 25 15; -fx-background-color: #0F172A;">

                    <Label text="MAIN MENU" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 800; -fx-padding: 0 0 5 10;" />

                    <!-- Dashboard Menu -->
                    <Button text="🏠 Dashboard" onAction="#handleDashboard" maxWidth="1.7976931348623157E308"
                            style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight:700; -fx-padding: 12 18; -fx-background-color: rgba(15,181,169,0.15); -fx-background-radius: 12; -fx-alignment: CENTER_LEFT; -fx-border-color: #0FB5A9; -fx-border-width: 0 0 0 3;" />

                    <!-- Comptes Menu -->
                    <VBox spacing="2">
                        <Button text="👤 Gestion Comptes" onAction="#toggleComptesMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #94A3B8; -fx-font-size: 14; -fx-font-weight:600; -fx-padding: 12 18; -fx-background-color: transparent; -fx-background-radius: 12; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
                        <VBox fx:id="comptesSubmenu" spacing="2" visible="false" managed="false" style="-fx-padding: 0 0 0 20;">
                            <Button text="• Liste des comptes" onAction="#handleListeComptes" maxWidth="1.7976931348623157E308"
                                    style="-fx-text-fill: #64748B; -fx-font-size: 13; -fx-padding: 8 15; -fx-background-color: transparent; -fx-cursor: hand;" />
                        </VBox>
                    </VBox>

                    <!-- Modules Menu -->
                    <VBox spacing="2">
                        <Button text="📚 Modules &amp; Cours" onAction="#toggleCoursMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #94A3B8; -fx-font-size: 14; -fx-font-weight:600; -fx-padding: 12 18; -fx-background-color: transparent; -fx-background-radius: 12; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
                        <VBox fx:id="coursSubmenu" spacing="2" visible="false" managed="false" style="-fx-padding: 0 0 0 20;">
                            <Button text="• Catégories" onAction="#handleCategories" maxWidth="1.7976931348623157E308"
                                    style="-fx-text-fill: #64748B; -fx-font-size: 13; -fx-padding: 8 15; -fx-background-color: transparent; -fx-cursor: hand;" />
                            <Button text="• Modules" onAction="#handleModules" maxWidth="1.7976931348623157E308"
                                    style="-fx-text-fill: #64748B; -fx-font-size: 13; -fx-padding: 8 15; -fx-background-color: transparent; -fx-cursor: hand;" />
                            <Button text="• Cours" onAction="#handleCours" maxWidth="1.7976931348623157E308"
                                    style="-fx-text-fill: #64748B; -fx-font-size: 13; -fx-padding: 8 15; -fx-background-color: transparent; -fx-cursor: hand;" />
                        </VBox>
                    </VBox>

                    <Button text="🎮 Jeux &amp; Quiz" onAction="#handleBackList" maxWidth="1.7976931348623157E308"
                            style="-fx-text-fill: #94A3B8; -fx-font-size: 14; -fx-font-weight:600; -fx-padding: 12 18; -fx-background-color: transparent; -fx-background-radius: 12; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
                    
                    <Button text="💬 Forums" onAction="#handleForums" maxWidth="1.7976931348623157E308"
                            style="-fx-text-fill: #94A3B8; -fx-font-size: 14; -fx-font-weight:600; -fx-padding: 12 18; -fx-background-color: transparent; -fx-background-radius: 12; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />

                    <Button text="📅 Événements" onAction="#handleEventsList" maxWidth="1.7976931348623157E308"
                            style="-fx-text-fill: #94A3B8; -fx-font-size: 14; -fx-font-weight:600; -fx-padding: 12 18; -fx-background-color: transparent; -fx-background-radius: 12; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />

                    <Button text="📹 Visioconférence" onAction="#handleMeetDashboard" maxWidth="1.7976931348623157E308"
                            style="-fx-text-fill: #94A3B8; -fx-font-size: 14; -fx-font-weight:600; -fx-padding: 12 18; -fx-background-color: transparent; -fx-background-radius: 12; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />

                    <Region prefHeight="40" />
                    
                    <Label text="SYSTEM" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 800; -fx-padding: 0 0 5 10;" />

                    <Button text="🏠 Retour Front" onAction="#handleBackFront" maxWidth="1.7976931348623157E308"
                            style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight:700; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 12; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />

                    <Button text="🚪 Déconnexion" onAction="#handleLogout" maxWidth="1.7976931348623157E308"
                            style="-fx-text-fill: #F87171; -fx-font-size: 13; -fx-font-weight:700; -fx-padding: 12 15; -fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" />
                </VBox>
            </ScrollPane>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4); -fx-padding: 18 35;">
            <VBox spacing="2">
                <Label text="ADMINISTRATION" style="-fx-font-size: 11; -fx-font-weight: 900; -fx-text-fill: #94A3B8;" />
                <Label text="Command Center" style="-fx-font-size: 22; -fx-font-weight: 900; -fx-text-fill: #1E293B;" />
            </VBox>
            
            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="20">
                <VBox alignment="CENTER_RIGHT">
                    <Label fx:id="adminNameLabel" text="Administrator" style="-fx-font-size: 15; -fx-font-weight: 800; -fx-text-fill: #1E293B;" />
                    <Label text="Super Admin" style="-fx-font-size: 12; -fx-text-fill: #0FB5A9; -fx-font-weight:700;" />
                </VBox>
                <Button onAction="#handleProfile" style="-fx-background-color: linear-gradient(to bottom right, #1E293B, #334155); -fx-background-radius: 50; -fx-padding: 8;">
                    <graphic>
                        <Label text="👤" style="-fx-font-size: 24; -fx-text-fill: white;" />
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #F8FAFC; -fx-background: #F8FAFC; -fx-border-color: transparent;">
            <VBox spacing="35" style="-fx-padding: 40; -fx-background-color: #F8FAFC;">

                <!-- Hero Section -->
                <HBox spacing="25">
                    <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: linear-gradient(to right, #1E293B, #334155); -fx-background-radius: 24; -fx-padding: 35; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
                        <Label text="Vue d'ensemble du Système" style="-fx-font-size: 28; -fx-font-weight: 900; -fx-text-fill: white;" />
                        <Label text="Analysez les performances et gérez les ressources de la plateforme en temps réel." 
                               style="-fx-font-size: 14; -fx-text-fill: #94A3B8;" wrapText="true" />
                        <Region prefHeight="15" />
                        <HBox spacing="15">
                            <Button text="Générer Rapport" style="-fx-background-color: #0FB5A9; -fx-text-fill: white; -fx-font-weight: 800; -fx-background-radius: 12; -fx-padding: 12 25;" />
                            <Button text="Logs Système" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 12; -fx-padding: 12 25;" />
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Statistics Grid -->
                <GridPane hgap="25" vgap="25">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                    </columnConstraints>

                    <!-- Total Users -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 15, 0, 0, 5); -fx-border-color: #0FB5A9; -fx-border-width: 0 0 0 5;" GridPane.columnIndex="0">
                        <Label text="UTILISATEURS" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 900;" />
                        <Label fx:id="totalUsersLabel" text="1,284" style="-fx-text-fill: #1E293B; -fx-font-size: 32; -fx-font-weight: 900; -fx-padding: 10 0;" />
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Label text="↑ 12%" style="-fx-text-fill: #10B981; -fx-font-weight: 800; -fx-font-size: 12;" />
                            <Label text="ce mois" style="-fx-text-fill: #94A3B8; -fx-font-size: 12;" />
                        </HBox>
                    </VBox>

                    <!-- Attendance -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 15, 0, 0, 5); -fx-border-color: #3B82F6; -fx-border-width: 0 0 0 5;" GridPane.columnIndex="1">
                        <Label text="PRÉSENCE MEET" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 900;" />
                        <Label text="92.5%" style="-fx-text-fill: #1E293B; -fx-font-size: 32; -fx-font-weight: 900; -fx-padding: 10 0;" />
                        <ProgressBar progress="0.92" maxWidth="Infinity" style="-fx-accent: #3B82F6; -fx-pref-height: 6;" />
                    </VBox>

                    <!-- Events -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 15, 0, 0, 5); -fx-border-color: #F59E0B; -fx-border-width: 0 0 0 5;" GridPane.columnIndex="2">
                        <Label text="ÉVÉNEMENTS" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 900;" />
                        <Label text="24" style="-fx-text-fill: #1E293B; -fx-font-size: 32; -fx-font-weight: 900; -fx-padding: 10 0;" />
                        <Label text="8 programmés" style="-fx-text-fill: #94A3B8; -fx-font-size: 12; -fx-font-weight:700;" />
                    </VBox>

                    <!-- Revenue/Credits -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 15, 0, 0, 5); -fx-border-color: #8B5CF6; -fx-border-width: 0 0 0 5;" GridPane.columnIndex="3">
                        <Label text="CRÉDITS ÉMIS" style="-fx-text-fill: #64748B; -fx-font-size: 11; -fx-font-weight: 900;" />
                        <Label text="14.2K" style="-fx-text-fill: #1E293B; -fx-font-size: 32; -fx-font-weight: 900; -fx-padding: 10 0;" />
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Label text="💰" style="-fx-font-size: 14;" />
                            <Label text="Économie stable" style="-fx-text-fill: #8B5CF6; -fx-font-weight: 700; -fx-font-size: 12;" />
                        </HBox>
                    </VBox>
                </GridPane>

                <!-- AI Insights Section -->
                <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 24; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 20, 0, 0, 10);">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="🤖" style="-fx-font-size: 24;" />
                        <Label text="AI Alerts &amp; Predictive Insights" style="-fx-font-size: 18; -fx-font-weight: 800; -fx-text-fill: #1E293B;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Analyser maintenant" style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-font-weight: 700; -fx-background-radius: 10;" />
                    </HBox>
                    
                    <HBox spacing="20">
                        <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: #ECFDF5; -fx-background-radius: 16; -fx-padding: 20; -fx-border-color: #10B981; -fx-border-width: 0.5; -fx-border-radius: 16;">
                            <Label text="OPPORTUNITÉ" style="-fx-font-weight: 900; -fx-text-fill: #047857; -fx-font-size: 10;" />
                            <Label text="Engagement en hausse sur les forums. Pensez à lancer un nouveau défi !" wrapText="true" style="-fx-text-fill: #065F46; -fx-font-size: 13;" />
                        </VBox>
                        
                        <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: #FFFBEB; -fx-background-radius: 16; -fx-padding: 20; -fx-border-color: #F59E0B; -fx-border-width: 0.5; -fx-border-radius: 16;">
                            <Label text="ATTENTION" style="-fx-font-weight: 900; -fx-text-fill: #B45309; -fx-font-size: 10;" />
                            <Label text="3 réunions Meet dépassent la capacité recommandée demain." wrapText="true" style="-fx-text-fill: #92400E; -fx-font-size: 13;" />
                        </VBox>
                        
                        <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: #FEF2F2; -fx-background-radius: 16; -fx-padding: 20; -fx-border-color: #EF4444; -fx-border-width: 0.5; -fx-border-radius: 16;">
                            <Label text="ALERTE CRITIQUE" style="-fx-font-weight: 900; -fx-text-fill: #B91C1C; -fx-font-size: 10;" />
                            <Label text="Tentatives de connexion suspectes détectées depuis 3 IPs étrangères." wrapText="true" style="-fx-text-fill: #991B1B; -fx-font-size: 13;" />
                        </VBox>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
