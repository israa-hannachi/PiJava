<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.Back.BackForumsDashboardController"
            prefHeight="900.0" prefWidth="1400.0" style="-fx-background-color: #f8fafc;">

    <!-- TOP NAVBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0; -fx-padding: 15;">
            <Label text="NAJA7NI" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
            <Separator orientation="VERTICAL" />
            <Label text="Dashboard Forums" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #64748b;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="🏠 Dashboard" onAction="#handleDashboard" />
            <Button text="🚪 Logout" onAction="#handleLogout" />
        </HBox>
    </top>

    <!-- MAIN CONTENT - Combined Dashboard -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f8fafc;">
            <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: #f8fafc;">

                <!-- Dashboard Title -->
                <Label text="Dashboard Forum" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />

                <!-- Stats Cards (from Photo 1) -->
                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                    </columnConstraints>

                    <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"
                          GridPane.columnIndex="0">
                        <Label text="📁 Catégories" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="totalCategoriesLabel" text="—" style="-fx-text-fill: #0f172a; -fx-font-size: 32; -fx-font-weight: bold;" />
                    </VBox>

                    <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"
                          GridPane.columnIndex="1">
                        <Label text="💬 Forums" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="totalForumsLabel" text="—" style="-fx-text-fill: #0f172a; -fx-font-size: 32; -fx-font-weight: bold;" />
                    </VBox>

                    <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"
                          GridPane.columnIndex="2">
                        <Label text="💬 Messages" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="totalMessagesLabel" text="—" style="-fx-text-fill: #0f172a; -fx-font-size: 32; -fx-font-weight: bold;" />
                    </VBox>

                    <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"
                          GridPane.columnIndex="3">
                        <Label text="✅ Forums Actifs" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="activeForumsLabel" text="—" style="-fx-text-fill: #0f172a; -fx-font-size: 32; -fx-font-weight: bold;" />
                    </VBox>
                </GridPane>

                <!-- Action Buttons (from Photo 2) -->
                <HBox spacing="10">
                    <Button text="➕ Créer un nouveau forum" onAction="#handleCreateForum"
                            style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 12 20; -fx-cursor: hand;" />
                    <Button text="📁 Ajouter une catégorie" onAction="#handleAddCategory"
                            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 12 20; -fx-cursor: hand;" />
                    <Button text="📊 Statistiques" onAction="#handleStatistics"
                            style="-fx-background-color: #06b6d4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 12 20; -fx-cursor: hand;" />
                    <Button text="🔍 Clustering des discussions" onAction="#handleClustering"
                            style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 12 20; -fx-cursor: hand;" />

                    <Button text="🌐 Go to Front" onAction="#handleGoToFront"
                            style="-fx-background-color: #4b5563; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 12 20; -fx-cursor: hand;" />
                </HBox>

                <!-- Secondary Action Buttons (from Photo 1) -->
                <HBox spacing="10">
                    <Button text="📁 Gérer Catégories" onAction="#handleManageCategories"
                            style="-fx-background-color: #0FB5A9; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 15 25; -fx-background-radius: 8;" />
                    <Button text="💬 Gérer Forums" onAction="#handleManageForums"
                            style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 15 25; -fx-background-radius: 8;" />
                    <Button text="💬 Gérer Messages" onAction="#handleManageMessages"
                            style="-fx-background-color: #8b5cf6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 15 25; -fx-background-radius: 8;" />
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
