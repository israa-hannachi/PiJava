<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.effect.*?>


<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.Back.BackForumsGestionController"
            prefHeight="900.0" prefWidth="1400.0" style="-fx-background-color: #f8fafc;">

    <!-- LEFT SIDEBAR NAVIGATION -->
    <left>
        <VBox id="sidebar" prefWidth="260" style="-fx-background-color: #1a202c; -fx-padding: 0;">

            <!-- Logo Section -->
            <VBox prefHeight="70" alignment="TOP_CENTER" style="-fx-background-color: #0f172a; -fx-padding: 15;">
                <Label text="NAJA7NI ADMIN" style="-fx-font-size:18; -fx-font-weight:bold; -fx-text-fill:white;"/>
            </VBox>

            <!-- Navigation Menu -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: #1a202c;">
                <VBox spacing="5" style="-fx-padding: 10; -fx-background-color: #1a202c;">

                    <Label text="Navigation" style="-fx-text-fill: #94a3b8; -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 10 0 5 0;" />

                    <!-- Dashboard Menu -->
                    <Button text="🏠 Dashboard" onAction="#handleDashboard" maxWidth="1.7976931348623157E308"
                            style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />

                    <!-- Comptes Menu -->
                    <VBox spacing="0" style="-fx-background-radius: 8; -fx-background-color: #334155;">
                        <Button text="👤 Comptes" onAction="#toggleComptesMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                        <VBox fx:id="comptesSubmenu" spacing="0" style="-fx-background-color: #1a202c;" visible="false" managed="false">
                            <Button text="   Liste des comptes" maxWidth="1.7976931348623157E308"
                                    onAction="#handleListeComptes"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                        </VBox>
                    </VBox>

                    <!-- Cours Menu -->
                    <VBox spacing="0" style="-fx-background-radius: 8; -fx-background-color: #334155;">
                        <Button text="📚 Cours" onAction="#toggleCoursMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                        <VBox fx:id="coursSubmenu" spacing="0" style="-fx-background-color: #1a202c;" visible="false" managed="false">
                            <Button text="   📂 Catégories" maxWidth="1.7976931348623157E308"
                                    onAction="#handleCategories"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                            <Button text="   📦 Modules" maxWidth="1.7976931348623157E308"
                                    onAction="#handleModules"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                            <Button text="   📖 Cours" maxWidth="1.7976931348623157E308"
                                    onAction="#handleCours"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                        </VBox>
                    </VBox>

                    <!-- Jeux Menu -->
                    <VBox spacing="0" style="-fx-background-radius: 8; -fx-background-color: #334155;">
                        <Button text="🎮 Jeux" onAction="#toggleJeuxMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                        <VBox fx:id="jeuxSubmenu" spacing="0" style="-fx-background-color: #1a202c;" visible="false" managed="false">
                            <Button text="   Jeux" onAction="#handleBackList" maxWidth="1.7976931348623157E308"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                        </VBox>
                    </VBox>

                    <!-- Forums Menu -->
                    <VBox spacing="0" style="-fx-background-radius: 8; -fx-background-color: #334155;">
                        <Button text="💬 Forums" onAction="#toggleForumMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                        <VBox fx:id="forumSubmenu" spacing="0" style="-fx-background-color: #1a202c;" visible="true" managed="true">
                            <Button text="   📋 Liste des Forums" maxWidth="1.7976931348623157E308"
                                    onAction="#handleForums"
                                    style="-fx-text-fill: #0FB5A9; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent; -fx-font-weight: bold;" />
                        </VBox>
                    </VBox>

                    <!-- Events Menu -->
                    <VBox spacing="0" style="-fx-background-radius: 8; -fx-background-color: #334155;">
                        <Button text="📅 Events" onAction="#toggleEventsMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                        <VBox fx:id="eventsSubmenu" spacing="0" style="-fx-background-color: #1a202c;" visible="false" managed="false">
                            <Button text="   Liste des Events" maxWidth="1.7976931348623157E308"
                                    onAction="#handleEventsList"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                            <Button text="   Calendrier" maxWidth="1.7976931348623157E308"
                                    onAction="#handleEventsCalendrier"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                            <Button text="   Sponsors" maxWidth="1.7976931348623157E308"
                                    onAction="#handleEventsSponsors"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                            <Button text="   Inscriptions" maxWidth="1.7976931348623157E308"
                                    onAction="#handleEventsInscriptions"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                        </VBox>
                    </VBox>

                    <!-- Meet Menu -->
                    <VBox spacing="0" style="-fx-background-radius: 8; -fx-background-color: #334155;">
                        <Button text="📹 Meet" onAction="#toggleMeetMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                        <VBox fx:id="meetSubmenu" spacing="0" style="-fx-background-color: #1a202c;" visible="false" managed="false">
                            <Button text="   Participants" maxWidth="1.7976931348623157E308"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                            <Button text="   Réunions" maxWidth="1.7976931348623157E308"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                        </VBox>
                    </VBox>

                    <!-- Mailing Menu -->
                    <VBox spacing="0" style="-fx-background-radius: 8; -fx-background-color: #334155;">
                        <Button text="📧 Mailing" onAction="#toggleMailingMenu" maxWidth="1.7976931348623157E308"
                                style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #334155; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                        <VBox fx:id="mailingSubmenu" spacing="0" style="-fx-background-color: #1a202c;" visible="false" managed="false">
                            <Button text="   Dashboard" maxWidth="1.7976931348623157E308"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                            <Button text="   Email Templates" maxWidth="1.7976931348623157E308"
                                    style="-fx-text-fill: #cbd5e1; -fx-font-size: 12; -fx-padding: 8 15; -fx-background-color: transparent;" />
                        </VBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <!-- Back to Front Button -->
                    <Button text="🏠 Retour Front-Office" onAction="#handleGoToFront" maxWidth="1.7976931348623157E308"
                            style="-fx-text-fill: white; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: #0FB5A9; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />

                    <!-- Logout Button -->
                    <Button text="🚪 Logout" onAction="#handleLogout" maxWidth="1.7976931348623157E308"
                            style="-fx-text-fill: #f87171; -fx-font-size: 13; -fx-padding: 12 15; -fx-background-color: transparent; -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;" />
                </VBox>
            </ScrollPane>
        </VBox>
    </left>

    <!-- TOP NAVBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0; -fx-padding: 15;">
            <Label text="NAJA7NI" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
            <Separator orientation="VERTICAL" />
            <Label text="Back Office" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #64748b;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="adminNameLabel" text="👑 Admin"
                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #0FB5A9;" />
            <Button text="👤 Profile" style="-fx-font-size: 12; -fx-padding: 8 15;" onAction="#handleProfile" />
        </HBox>
    </top>

    <!-- MAIN CONTENT - Matching Photo 1 -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #f8fafc;">
            <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: #f8fafc;">

                <!-- LIST CONTAINER -->
                <VBox fx:id="listContainer" spacing="20">
                    <!-- Top Action Buttons (like photo 1) -->
                    <HBox spacing="10">
                        <Button text="🏠 Retour Dashboard" onAction="#handleBackToDashboard"
                                style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 20; -fx-cursor: hand;" />
                        <Button text="➕ Créer un nouveau forum" onAction="#showCreateForm"
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 20; -fx-cursor: hand;" />
                        <Button text="📁 Ajouter une catégorie" onAction="#handleAjouterCategorie"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 20; -fx-cursor: hand;" />
                        <Button text="📊 Statistiques" onAction="#handleStatistiques"
                                style="-fx-background-color: #06b6d4; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 20; -fx-cursor: hand;" />
                        <Button text="🔍 Clustering des discussions" onAction="#handleClustering"
                                style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 20; -fx-cursor: hand;" />
                        <Button text="🌐 Go to Front" onAction="#handleGoToFront"
                                style="-fx-background-color: #4b5563; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10 20; -fx-cursor: hand;" />
                    </HBox>

                    <!-- Page Title -->
                    <Label text="Liste des Forums" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />

                    <!-- Filters Bar (like photo 1) -->
                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                        <HBox spacing="0">
                            <TextField fx:id="searchEtatField" promptText="Rechercher par état" prefWidth="180"
                                       style="-fx-background-radius: 6 0 0 6; -fx-border-color: #e5e7eb; -fx-border-radius: 6 0 0 6; -fx-border-width: 1 0 1 1;" />
                            <Button text="🔍" onAction="#handleAppliquer" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 1 1 1 0; -fx-background-radius: 0 6 6 0; -fx-cursor: hand;" />
                        </HBox>
                        <TextField fx:id="searchCreatorField" promptText="Rechercher par créateur" prefWidth="200"
                                   style="-fx-background-radius: 6; -fx-border-color: #e5e7eb; -fx-border-radius: 6;" />
                        <ComboBox fx:id="sortByDateCombo" prefWidth="150"
                                  style="-fx-background-radius: 6; -fx-border-color: #e5e7eb; -fx-border-radius: 6;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="APPLIQUER" onAction="#handleAppliquer"
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 20; -fx-cursor: hand;" />
                    </HBox>

                    <!-- Forums Table (like photo 1 - Id, Titre, Créateur, Date, État, Actions) -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
                        <TableView fx:id="forumsTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10;">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colTitre" text="Titre" prefWidth="450" style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-font-weight: bold;" />
                                <TableColumn fx:id="colCreatedBy" text="Créateur" prefWidth="150" style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-font-weight: bold;" />
                                <TableColumn fx:id="colDate" text="Date" prefWidth="120" style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-font-weight: bold;" />
                                <TableColumn fx:id="colEtat" text="État" prefWidth="100" style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-font-weight: bold;" />
                                <TableColumn fx:id="colActions" text="Actions" prefWidth="120" style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-font-weight: bold;" />
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- Result Count -->
                    <HBox alignment="CENTER_RIGHT">
                        <Label fx:id="resultCountLabel" text="0 forum(s)" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                    </HBox>

                    <!-- Pagination -->
                    <HBox alignment="CENTER" spacing="5" style="-fx-padding: 10;">
                        <Button fx:id="btnPrev" text="‹" onAction="#handlePrevPage"
                                style="-fx-background-color: #e5e7eb; -fx-background-radius: 50; -fx-min-width: 35; -fx-min-height: 35; -fx-cursor: hand;" />
                        <Button fx:id="btnPage1" text="1" onAction="#handlePage1"
                                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 35; -fx-min-height: 35; -fx-cursor: hand;" />
                        <Button fx:id="btnPage2" text="2" onAction="#handlePage2"
                                style="-fx-background-color: #e5e7eb; -fx-background-radius: 50; -fx-min-width: 35; -fx-min-height: 35; -fx-cursor: hand;" />
                        <Button fx:id="btnNext" text="›" onAction="#handleNextPage"
                                style="-fx-background-color: #e5e7eb; -fx-background-radius: 50; -fx-min-width: 35; -fx-min-height: 35; -fx-cursor: hand;" />
                    </HBox>
                </VBox>

                <!-- FORM CONTAINER - Enlarged for "toute la page" -->
                <!-- FORM CONTAINER - Modern Design -->
                <AnchorPane fx:id="formContainer" visible="false" managed="false" 
                            prefWidth="1000" prefHeight="720"
                            style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #f0f4ff, #fef3ff, #f0fff4); -fx-background-radius: 24;">

                    <!-- Cercles décoratifs d'arrière-plan -->
                    <Circle radius="110" fill="#c7d2fe33" stroke="transparent"
                             AnchorPane.topAnchor="-60" AnchorPane.rightAnchor="-60"/>
                    <Circle radius="90" fill="#bbf7d033" stroke="transparent"
                             AnchorPane.bottomAnchor="-40" AnchorPane.leftAnchor="-40"/>

                    <!-- Carte principale -->
                    <VBox spacing="0"
                          AnchorPane.topAnchor="40" AnchorPane.bottomAnchor="40"
                          AnchorPane.leftAnchor="60" AnchorPane.rightAnchor="60"
                          style="-fx-background-color: rgba(255,255,255,0.85);
                                 -fx-background-radius: 24;
                                 -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.15), 30, 0, 0, 10);
                                 -fx-padding: 36 45 30 45;">

                        <!-- ═══ HEADER ═══ -->
                        <HBox alignment="CENTER_LEFT" spacing="18">
                            <!-- Badge Rocket -->
                            <StackPane prefWidth="52" prefHeight="52"
                                       style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #6366f1, #8b5cf6);
                                              -fx-background-radius: 15;
                                              -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.35), 15, 0, 0, 5);">
                                <Label text="🚀" style="-fx-font-size: 24;"/>
                            </StackPane>

                            <VBox spacing="2">
                                <Label text="Créer un nouveau forum"
                                       style="-fx-font-family: 'Nunito';
                                              -fx-font-size: 30;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #1e1b4b;"/>
                                <Label text="Remplissez les informations ci-dessous pour lancer une nouvelle discussion."
                                       style="-fx-font-family: 'Poppins';
                                              -fx-font-size: 13;
                                              -fx-text-fill: #6b7280;"/>
                            </VBox>
                        </HBox>

                        <!-- Barre d'accentuation -->
                        <HBox style="-fx-padding: 15 0 0 70;">
                            <Rectangle width="80" height="4" arcWidth="5" arcHeight="4"
                                       fill="linear-gradient(from 0% 0% to 100% 0%, #6366f1, #8b5cf6, #06b6d4)"/>
                        </HBox>

                        <Separator style="-fx-padding: 20 0 0 0; -fx-opacity: 0.3;"/>
                        
                        <!-- Error Label (added for controller compatibility) -->
                        <Label fx:id="errorLabel" visible="false" style="-fx-text-fill: #ef4444; -fx-font-family: 'Poppins'; -fx-font-size: 13; -fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>

                        <!-- ═══ SECTION LABEL ═══ -->
                        <Label text="INFORMATIONS GÉNÉRALES"
                               style="-fx-font-family: 'Poppins';
                                      -fx-font-size: 11;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #a5b4fc;
                                      -fx-letter-spacing: 1.5;
                                      -fx-padding: 15 0 10 0;"/>

                        <!-- ═══ ROW 1: Titre + Catégorie ═══ -->
                        <HBox spacing="25">
                            <!-- Titre du Forum -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="6">
                                    <Label text="✏️" style="-fx-font-size: 12;"/>
                                    <Label text="TITRE DU FORUM"
                                           style="-fx-font-family: 'Poppins';
                                                  -fx-font-size: 11;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #4338ca;"/>
                                    <Label text="*" style="-fx-text-fill: #f43f5e; -fx-font-size: 14;"/>
                                </HBox>
                                <TextField fx:id="titreField" promptText="Entrez le titre du forum..."
                                           style="-fx-font-family: 'Poppins';
                                                  -fx-font-size: 14;
                                                  -fx-background-color: white;
                                                  -fx-border-color: #6366f1;
                                                  -fx-border-radius: 10;
                                                  -fx-background-radius: 10;
                                                  -fx-border-width: 1.5;
                                                  -fx-padding: 12 15;
                                                  -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.1), 10, 0, 0, 3);"/>
                            </VBox>

                            <!-- Catégorie -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="6">
                                    <Label text="🏷️" style="-fx-font-size: 12;"/>
                                    <Label text="CATÉGORIE"
                                           style="-fx-font-family: 'Poppins';
                                                  -fx-font-size: 11;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #4338ca;"/>
                                    <Label text="*" style="-fx-text-fill: #f43f5e; -fx-font-size: 14;"/>
                                </HBox>
                                <ComboBox fx:id="categorieCombo" promptText="Choisir une catégorie..."
                                          maxWidth="Infinity" prefHeight="46"
                                          style="-fx-font-family: 'Poppins';
                                                 -fx-font-size: 14;
                                                 -fx-background-color: white;
                                                 -fx-border-color: #e0e7ff;
                                                 -fx-border-radius: 10;
                                                 -fx-background-radius: 10;
                                                 -fx-border-width: 1.5;
                                                 -fx-padding: 5 10;"/>
                            </VBox>
                        </HBox>

                        <!-- ═══ ROW 2: Description ═══ -->
                        <VBox spacing="8" style="-fx-padding: 20 0 0 0;">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="📝" style="-fx-font-size: 12;"/>
                                <Label text="DESCRIPTION DÉTAILLÉE"
                                       style="-fx-font-family: 'Poppins';
                                              -fx-font-size: 11;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #4338ca;"/>
                            </HBox>
                            <TextArea fx:id="descriptionField" promptText="Expliquez l'objectif de ce forum..."
                                      prefHeight="110" wrapText="true"
                                      style="-fx-font-family: 'Poppins';
                                             -fx-font-size: 14;
                                             -fx-background-color: white;
                                             -fx-border-color: #e0e7ff;
                                             -fx-border-radius: 10;
                                             -fx-background-radius: 10;
                                             -fx-border-width: 1.5;
                                             -fx-padding: 12 15;
                                             -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.05), 8, 0, 0, 2);"/>
                        </VBox>

                        <!-- ═══ ROW 3: Nom du Créateur + État de publication ═══ -->
                        <HBox spacing="25" style="-fx-padding: 20 0 0 0;">
                            <!-- Nom du Créateur -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="6">
                                    <Label text="👤" style="-fx-font-size: 12;"/>
                                    <Label text="NOM DU CRÉATEUR"
                                           style="-fx-font-family: 'Poppins';
                                                  -fx-font-size: 11;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #4338ca;"/>
                                    <Label text="*" style="-fx-text-fill: #f43f5e; -fx-font-size: 14;"/>
                                </HBox>
                                <TextField fx:id="createdByField" promptText="Votre nom d'utilisateur"
                                           style="-fx-font-family: 'Poppins';
                                                  -fx-font-size: 14;
                                                  -fx-background-color: white;
                                                  -fx-border-color: #e0e7ff;
                                                  -fx-border-radius: 10;
                                                  -fx-background-radius: 10;
                                                  -fx-border-width: 1.5;
                                                  -fx-padding: 12 15;"/>
                            </VBox>

                            <!-- État de publication -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="6">
                                    <Label text="📡" style="-fx-font-size: 12;"/>
                                    <Label text="ÉTAT DE PUBLICATION"
                                           style="-fx-font-family: 'Poppins';
                                                  -fx-font-size: 11;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #4338ca;"/>
                                </HBox>
                                <ComboBox fx:id="etatCombo" value="actif"
                                          maxWidth="Infinity" prefHeight="46"
                                          style="-fx-font-family: 'Poppins';
                                                 -fx-font-size: 14;
                                                 -fx-background-color: #ecfdf5;
                                                 -fx-border-color: #10b981;
                                                 -fx-border-radius: 10;
                                                 -fx-background-radius: 10;
                                                 -fx-border-width: 1.5;
                                                 -fx-padding: 5 10;
                                                 -fx-text-fill: #065f46;">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="actif"/>
                                            <String fx:value="inactif"/>
                                            <String fx:value="archivé"/>
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                            </VBox>
                        </HBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <!-- ═══ ACTION BUTTONS ═══ -->
                        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 25 0 0 0; -fx-border-color: #e0e7ff; -fx-border-width: 1 0 0 0;">

                            <!-- Retour -->
                            <Button text="← Retour" onAction="#handleBackToDashboard"
                                    style="-fx-font-family: 'Poppins';
                                           -fx-font-size: 14;
                                           -fx-font-weight: 500;
                                           -fx-background-color: white;
                                           -fx-border-color: #cbd5e1;
                                           -fx-border-radius: 12;
                                           -fx-background-radius: 12;
                                           -fx-border-width: 1.5;
                                           -fx-text-fill: #64748b;
                                           -fx-padding: 12 25;
                                           -fx-cursor: hand;"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <!-- Annuler -->
                            <Button text="✕  Annuler" onAction="#showList"
                                    style="-fx-font-family: 'Poppins';
                                           -fx-font-size: 14;
                                           -fx-font-weight: 500;
                                           -fx-background-color: #fff1f2;
                                           -fx-border-color: #fda4af;
                                           -fx-border-radius: 12;
                                           -fx-background-radius: 12;
                                           -fx-border-width: 1.5;
                                           -fx-text-fill: #e11d48;
                                           -fx-padding: 12 22;
                                           -fx-cursor: hand;"/>

                            <!-- Créer le Forum -->
                            <Button text="+  Créer le Forum" onAction="#handleSaveForum"
                                    style="-fx-font-family: 'Poppins';
                                           -fx-font-size: 14;
                                           -fx-font-weight: bold;
                                           -fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #6366f1, #8b5cf6);
                                           -fx-background-radius: 12;
                                           -fx-border-radius: 12;
                                           -fx-text-fill: white;
                                           -fx-padding: 12 35;
                                           -fx-cursor: hand;
                                           -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.45), 20, 0, 0, 6);"/>
                        </HBox>

                    </VBox>
                </AnchorPane>

            </VBox>

        </ScrollPane>
    </center>

</BorderPane>
