<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.Back.StatsController">

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f8fafc;">
            <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: #f8fafc;">

                <!-- Header -->
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Statistiques des Jeux"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                        <Label text="Analysez les performances et l engagement des joueurs."
                               style="-fx-text-fill: #64748b; -fx-font-size: 14;" />
                    </VBox>
                    <HBox spacing="10">
                        <Button text="Retour a la liste" onAction="#handleRetour"
                                style="-fx-background-color: #334155; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-padding: 10 25;
                       -fx-background-radius: 8; -fx-font-weight: bold;"/>
                        <Button text="Exporter PDF Jeux" onAction="#exportGamesPdf"
                                style="-fx-background-color: #0FB5A9; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-padding: 10 25;
                       -fx-background-radius: 8; -fx-font-weight: bold;"/>
                        <Button text="Exporter PDF Questions" onAction="#exportQuestionsPdf"
                                style="-fx-background-color: #dc2626; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-padding: 10 25;
                       -fx-background-radius: 8; -fx-font-weight: bold;"/>
                    </HBox>
                </HBox>

                <!-- KPI Cards -->
                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                    </columnConstraints>

                    <!-- Total Jeux -->
                    <VBox style="-fx-border-color: #e2e8f0; -fx-background-color: white;
                                 -fx-background-radius: 6; -fx-border-radius: 6;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.04),4,0,0,1);"
                          GridPane.columnIndex="0">
                        <Label text="Total Jeux"
                               style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="kpiTotalGames" text="—"
                               style="-fx-text-fill: #1e293b; -fx-font-size: 28;
                                      -fx-font-weight: bold;" />
                        <Label text="jeux enregistres"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 10;" />
                    </VBox>

                    <!-- Total QCM -->
                    <VBox style="-fx-border-color: #e2e8f0; -fx-background-color: white;
                                 -fx-background-radius: 6; -fx-border-radius: 6;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.04),4,0,0,1);"
                          GridPane.columnIndex="1">
                        <Label text="QCM"
                               style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="kpiQcm" text="—"
                               style="-fx-text-fill: #2563eb; -fx-font-size: 28;
                                      -fx-font-weight: bold;" />
                        <ProgressBar fx:id="qcmProgress" progress="0"
                                     maxWidth="1.7976931348623157E308"
                                     style="-fx-accent: #2563eb;" />
                    </VBox>

                    <!-- Vrai/Faux -->
                    <VBox style="-fx-border-color: #e2e8f0; -fx-background-color: white;
                                 -fx-background-radius: 6; -fx-border-radius: 6;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.04),4,0,0,1);"
                          GridPane.columnIndex="2">
                        <Label text="Vrai / Faux"
                               style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="kpiVf" text="—"
                               style="-fx-text-fill: #0FB5A9; -fx-font-size: 28;
                                      -fx-font-weight: bold;" />
                        <ProgressBar fx:id="vfProgress" progress="0"
                                     maxWidth="1.7976931348623157E308"
                                     style="-fx-accent: #0FB5A9;" />
                    </VBox>

                    <!-- Libres -->
                    <VBox style="-fx-border-color: #e2e8f0; -fx-background-color: white;
                                 -fx-background-radius: 6; -fx-border-radius: 6;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.04),4,0,0,1);"
                          GridPane.columnIndex="3">
                        <Label text="Libres"
                               style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="kpiLibre" text="—"
                               style="-fx-text-fill: #dc2626; -fx-font-size: 28;
                                      -fx-font-weight: bold;" />
                        <ProgressBar fx:id="libreProgress" progress="0"
                                     maxWidth="1.7976931348623157E308"
                                     style="-fx-accent: #dc2626;" />
                    </VBox>
                </GridPane>

                <!-- Graphiques : PieChart + BarChart -->
                <HBox spacing="20">

                    <!-- PieChart -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-border-color: #e2e8f0; -fx-background-color: white;
                                 -fx-background-radius: 6; -fx-border-radius: 6;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.04),4,0,0,1);">
                        <Label text="Repartition des Jeux"
                               style="-fx-font-size: 14; -fx-font-weight: bold;
                                      -fx-text-fill: #1e293b;" />
                        <PieChart fx:id="gamesPieChart" prefHeight="280" />
                    </VBox>

                    <!-- BarChart -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-border-color: #e2e8f0; -fx-background-color: white;
                                 -fx-background-radius: 6; -fx-border-radius: 6;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.04),4,0,0,1);">
                        <Label text="Score moyen par jeu"
                               style="-fx-font-size: 14; -fx-font-weight: bold;
                                      -fx-text-fill: #1e293b;" />
                        <BarChart fx:id="scoreBarChart" prefHeight="280" VBox.vgrow="ALWAYS">
                            <xAxis><CategoryAxis /></xAxis>
                            <yAxis><NumberAxis /></yAxis>
                        </BarChart>
                    </VBox>

                </HBox>

                <!-- LineChart -->
                <VBox spacing="10"
                      style="-fx-border-color: #e2e8f0; -fx-background-color: white;
                             -fx-background-radius: 6; -fx-border-radius: 6;
                             -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.04),4,0,0,1);">
                    <Label text="Nombre de tentatives par jeu"
                           style="-fx-font-size: 14; -fx-font-weight: bold;
                                  -fx-text-fill: #1e293b;" />
                    <LineChart fx:id="attemptLineChart" prefHeight="250">
                        <xAxis><CategoryAxis /></xAxis>
                        <yAxis><NumberAxis /></yAxis>
                    </LineChart>
                </VBox>

                <!-- Analyse intelligente -->
                <HBox spacing="20">

                    <!-- Performances -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-border-color: #93c5fd; -fx-background-color: #eff6ff;
                                 -fx-background-radius: 10; -fx-border-radius: 10;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.04),4,0,0,1);">
                        <Label text="Analyse des performances"
                               style="-fx-font-size: 14; -fx-font-weight: bold;
                                      -fx-text-fill: #1e40af;" />
                        <Separator />
                        <Label fx:id="perfAnalysisLabel" wrapText="true"
                               style="-fx-text-fill: #1e3a8a; -fx-font-size: 13;" />
                    </VBox>

                    <!-- Engagement -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-border-color: #fcd34d; -fx-background-color: #fffbeb;
                                 -fx-background-radius: 10; -fx-border-radius: 10;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.04),4,0,0,1);">
                        <Label text="Analyse de l engagement"
                               style="-fx-font-size: 14; -fx-font-weight: bold;
                                      -fx-text-fill: #92400e;" />
                        <Separator />
                        <Label fx:id="engagementLabel" wrapText="true"
                               style="-fx-text-fill: #78350f; -fx-font-size: 13;" />
                    </VBox>

                </HBox>

                <!-- Footer -->
                <HBox alignment="CENTER" style="-fx-padding: 10 0;">
                    <Label text="Les jeux sans score ni tentatives sont exclus de l analyse."
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" />
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>