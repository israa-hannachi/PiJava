<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.controllers.front.FrontRegisterController"
           prefWidth="1280" prefHeight="800" style="-fx-background-color: #F3F4F6; -fx-font-family: 'Segoe UI';">

    <HBox alignment="CENTER" maxWidth="1100" maxHeight="700" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
        <!-- Left Side: Hero Section -->
        <VBox prefWidth="450" alignment="CENTER" spacing="25"
              style="-fx-background-color: linear-gradient(to bottom right, #04B6D5, #0FB5A9); -fx-background-radius: 20 0 0 20;">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <ImageView fitWidth="180" preserveRatio="true" pickOnBounds="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 3);">
                <image><Image url="@/assets/images/logo.png"/></image>
            </ImageView>
            <Label text="Join Our Community" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: white; -fx-wrap-text: true; -fx-alignment: center;"/>
            <Label text="Unlock your potential with premium courses and interactive sessions." style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.9); -fx-wrap-text: true; -fx-alignment: center;"/>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <VBox spacing="10" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 15; -fx-padding: 20;">
                <Label text="🚀 Start learning today" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Join 4k+ successful students." style="-fx-font-size: 14; -fx-text-fill: rgba(255,255,255,0.8);"/>
            </VBox>
        </VBox>

        <!-- Right Side: Register Form -->
        <ScrollPane fitToWidth="true" prefWidth="650" style="-fx-background: #FFFFFF; -fx-background-color: transparent; -fx-border-color: transparent;" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <content>
                <VBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #FFFFFF;">
                    <padding>
                        <Insets top="40" right="60" bottom="40" left="60"/>
                    </padding>

                    <VBox spacing="5">
                        <Label text="Create an Account ✨" style="-fx-font-size: 28; -fx-font-weight: 800; -fx-text-fill: #1F2937;"/>
                        <Label text="Fill in the details below to get started." style="-fx-font-size: 15; -fx-text-fill: #6B7280;"/>
                    </VBox>

                    <Region prefHeight="10"/>

                    <HBox spacing="15">
                        <VBox HBox.hgrow="ALWAYS" spacing="8">
                            <Label text="First Name" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <TextField fx:id="firstNameField" promptText="e.g. John"
                                       style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="8">
                            <Label text="Last Name" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <TextField fx:id="lastNameField" promptText="e.g. Doe"
                                       style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15;"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="8">
                        <Label text="Email address" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                        <TextField fx:id="emailField" promptText="john.doe@example.com"
                                   style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15;"/>
                    </VBox>

                    <VBox spacing="8">
                        <Label text="Role" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                        <ComboBox fx:id="roleCombo" promptText="Select your role" maxWidth="1.7976931348623157E308"
                                  style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 6 10;">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Student"/>
                                    <String fx:value="Enseignant"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>

                    <HBox spacing="15">
                        <VBox HBox.hgrow="ALWAYS" spacing="8">
                            <Label text="Password" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <PasswordField fx:id="passwordField" promptText="••••••••"
                                           style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="8">
                            <Label text="Confirm Password" style="-fx-font-weight: 600; -fx-text-fill: #374151;"/>
                            <PasswordField fx:id="confirmPasswordField" promptText="••••••••"
                                           style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 15;"/>
                        </VBox>
                    </HBox>

                    <CheckBox fx:id="termsCheck" text="I agree to the Terms of Service and Privacy Policy" style="-fx-text-fill: #4B5563; -fx-padding: 5 0;"/>

                    <VBox spacing="8" style="-fx-background-color: #F8FAFC; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #E5E7EB; -fx-border-radius: 10;">
                        <Label text="Security Verification" style="-fx-font-weight: 700; -fx-text-fill: #374151;"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <StackPane style="-fx-background-color: #fff; -fx-padding: 5; -fx-border-color: #D1D5DB; -fx-border-radius: 5; -fx-background-radius: 5;">
                                <javafx.scene.canvas.Canvas fx:id="captchaCanvas" width="150" height="50" />
                            </StackPane>
                            <Button text="🔄" onAction="#generateCaptcha" style="-fx-background-color: transparent; -fx-font-size: 18; -fx-cursor: hand;"/>
                            <TextField fx:id="captchaField" promptText="Enter code" HBox.hgrow="ALWAYS"
                                       style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;"/>
                        </HBox>
                    </VBox>

                    <Button text="Create Account" maxWidth="1.7976931348623157E308" onAction="#handleRegister"
                            style="-fx-background-color: #0FB5A9; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;"/>

                    <HBox alignment="CENTER" spacing="10">
                        <Separator HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;"/>
                        <Label text="or register with" style="-fx-text-fill: #6B7280; -fx-font-size: 13;"/>
                        <Separator HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;"/>
                    </HBox>

                    <HBox spacing="15">
                        <Button text="Google" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #374151; -fx-font-weight: 600; -fx-padding: 10; -fx-cursor: hand;"/>
                        <Button text="Facebook" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: white; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #374151; -fx-font-weight: 600; -fx-padding: 10; -fx-cursor: hand;"/>
                    </HBox>

                    <Region prefHeight="5"/>

                    <HBox alignment="CENTER" spacing="5">
                        <Label text="Already have an account?" style="-fx-text-fill: #4B5563;"/>
                        <Hyperlink text="Sign in here" style="-fx-text-fill: #04B6D5; -fx-font-weight: bold;" onAction="#handleSignInLink"/>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </HBox>
</StackPane>
