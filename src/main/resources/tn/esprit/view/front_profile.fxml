<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.front.FrontProfileController"
            prefWidth="1200.0" prefHeight="880.0"
            style="-fx-background-color:#FFFFFF; -fx-font-family:'Segoe UI';">

    <left>
        <VBox prefWidth="250.0" spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 2, 0);">
            <padding><Insets top="20.0" right="15.0" bottom="20.0" left="15.0"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <ImageView fitWidth="180.0" preserveRatio="true" pickOnBounds="true">
                    <image><Image url="@/assets/images/logo.png"/></image>
                </ImageView>
            </HBox>
            
            <Region prefHeight="20"/>

            <Button text="🏠 Accueil" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleHome"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>
            
            <Button text="👤 Profil" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT"
                    style="-fx-background-color: linear-gradient(to right, rgba(15,181,169,0.1), rgba(15,181,169,0.05)); -fx-text-fill:#0FB5A9; -fx-font-weight:700; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-border-color: #0FB5A9; -fx-border-width: 0 0 0 4; -fx-border-radius: 10;"/>
            
            <Button text="📚 Cours" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleCours"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>
            <Button text="🎥 Meet" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleMeets"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>
            <Button text="🎮 Jeux" onAction="#handleGameList" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>
            <Button text="📅 Events" onAction="#handleEvents" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>
            <Button text="💬 Forums" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleForums"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>
            
            <VBox spacing="10" style="-fx-background-color: linear-gradient(to bottom right, #0FB5A9, #04B6D5); -fx-background-radius: 15; -fx-padding: 20;">
                <Label text="Need Help?" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 16;"/>
                <Label text="Check our docs or contact support." style="-fx-text-fill: rgba(255,255,255,0.9); -fx-wrap-text: true;"/>
                <Button text="Support" style="-fx-background-color: white; -fx-text-fill: #0FB5A9; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox spacing="15.0" alignment="CENTER_LEFT"
              style="-fx-background-color:#FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
            <padding><Insets top="15.0" right="30.0" bottom="15.0" left="30.0"/></padding>

            <Label text="Mon Profil" style="-fx-font-size:22px; -fx-font-weight:700; -fx-text-fill:#1F2937;" />

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="searchField" promptText="Rechercher des cours, modules..." prefWidth="350.0"
                       style="-fx-background-color:white; -fx-background-radius:12; -fx-border-color:#E2E8F0; -fx-border-radius:12; -fx-padding:10 20; -fx-font-size: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 2);" />

            <Region HBox.hgrow="ALWAYS"/>
                
            <HBox spacing="18.0" alignment="CENTER_RIGHT">
                <Button text="🔔"
                        style="-fx-background-color:white; -fx-background-radius:12; -fx-padding:10; -fx-font-size:16px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 10, 0, 0, 2); -fx-border-color:#E2E8F0; -fx-border-radius:12;" />

                <Button onAction="#handleProfile" 
                        style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
                    <graphic>
                        <StackPane style="-fx-padding: 2; -fx-background-color: linear-gradient(to bottom right, #0FB5A9, #04B6D5); -fx-background-radius: 999;">
                             <ImageView fx:id="navProfileImage" fitWidth="40" fitHeight="40" preserveRatio="false" />
                        </StackPane>
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background:#F0FFFE;">
            <content>
                <VBox spacing="18.0" style="-fx-background-color:#F0FFFE;">
                    <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>

                    <VBox spacing="6.0">
                        <Label text="Mon Profil" style="-fx-font-size:30px; -fx-font-weight:800; -fx-text-fill:#0f172a;"/>
                        <Label text="Gérez vos informations personnelles" style="-fx-text-fill:#64748b;"/>
                    </VBox>

                    <!-- PROFILE CARD -->
                    <VBox spacing="0.0" style="-fx-background-color:#ffffff; -fx-background-radius:16; -fx-border-color:#E5E7EB; -fx-border-radius:16;">
                        <!-- Cover -->
                        <StackPane prefHeight="130.0" style="-fx-background-color:linear-gradient(to right,#0FB5A9,#04B6D5); -fx-background-radius:16 16 0 0;">
                            <ImageView fx:id="coverImage" fitHeight="130.0" preserveRatio="false" pickOnBounds="true" visible="false"/>
                            <Button text="📷 Modifier la couverture" StackPane.alignment="TOP_RIGHT" onAction="#handleChangeCoverPhoto"
                                    style="-fx-background-color:rgba(255,255,255,0.22); -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10;">
                                <StackPane.margin><Insets top="12.0" right="12.0" bottom="0.0" left="0.0"/></StackPane.margin>
                            </Button>
                        </StackPane>

                        <VBox spacing="12.0" style="-fx-padding:20;">
                            <HBox spacing="16.0" alignment="CENTER_LEFT">
                                <StackPane>
                                    <Circle radius="64.0" style="-fx-fill:linear-gradient(to bottom right,#0FB5A9,#04B6D5);" />
                                    <ImageView fx:id="profileImage" fitWidth="128.0" fitHeight="128.0" preserveRatio="false" pickOnBounds="true"/>
                                        <Button text="📷" StackPane.alignment="BOTTOM_RIGHT" onAction="#handleChangeProfilePhoto"
                                            style="-fx-background-color:#FFFFFF; -fx-background-radius:999; -fx-border-color:#E5E7EB; -fx-border-radius:999;"/>
                                </StackPane>

                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label fx:id="fullNameLabel" text="FirstName LastName" style="-fx-font-size:24px; -fx-font-weight:800;"/>
                                    <Label fx:id="roleLabel" text="ROLE_USER" style="-fx-text-fill:#64748b;"/>
                                </VBox>

                                <Button text="💾 Enregistrer"
                                        style="-fx-background-color:#0FB5A9; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10;"
                                        onAction="#handleSaveProfile"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- INFO + CONTACT -->
                    <GridPane hgap="14.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0"/>
                            <ColumnConstraints percentWidth="50.0"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0" spacing="12.0"
                               style="-fx-background-color:#ffffff; -fx-background-radius:16; -fx-border-color:#E5E7EB; -fx-border-radius:16; -fx-padding:16;">
                            <Label text="👤 Informations Personnelles" style="-fx-font-size:18px; -fx-font-weight:700;"/>

                            <VBox spacing="6.0">
                                <Label text="Prénom" style="-fx-text-fill:#64748b; -fx-font-weight:700;"/>
                                <TextField fx:id="firstNameField" promptText="Prénom"
                                           style="-fx-background-color:#F7FFFE; -fx-background-radius:10; -fx-border-color:transparent; -fx-padding:10;"/>
                            </VBox>

                            <VBox spacing="6.0">
                                <Label text="Nom" style="-fx-text-fill:#64748b; -fx-font-weight:700;"/>
                                <TextField fx:id="lastNameField" promptText="Nom"
                                           style="-fx-background-color:#F7FFFE; -fx-background-radius:10; -fx-border-color:transparent; -fx-padding:10;"/>
                            </VBox>

                            <VBox spacing="6.0">
                                <Label text="Email" style="-fx-text-fill:#64748b; -fx-font-weight:700;"/>
                                <Label fx:id="emailLabel" text="email@example.com" style="-fx-text-fill:#475569;"/>
                            </VBox>

                            <VBox spacing="6.0">
                                <Label text="Role" style="-fx-text-fill:#64748b; -fx-font-weight:700;"/>
                                <Label fx:id="roleLabel2" text="ROLE_USER" style="-fx-text-fill:#475569;"/>
                            </VBox>
                        </VBox>

                        <VBox GridPane.columnIndex="1" spacing="12.0"
                               style="-fx-background-color:#ffffff; -fx-background-radius:16; -fx-border-color:#E5E7EB; -fx-border-radius:16; -fx-padding:16;">
                            <Label text="✉ Coordonnées" style="-fx-font-size:18px; -fx-font-weight:700;"/>

                            <HBox spacing="10.0" alignment="CENTER_LEFT"
                                  style="-fx-background-color:#F8FAFC; -fx-background-radius:10; -fx-padding:10;">
                                <Label text="✉" style="-fx-font-size:16px;"/>
                                <VBox>
                                    <Label text="Email" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
                                    <Label fx:id="emailLabel2" text="email@example.com"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </GridPane>

                    <!-- 2FA -->
                    <VBox spacing="10.0"
                          style="-fx-background-color:#ffffff; -fx-background-radius:16; -fx-border-color:#E5E7EB; -fx-border-radius:16;">
                        <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding:16; -fx-border-color:#E5E7EB; -fx-border-width:0 0 1 0;">
                            <Label text="🛡" style="-fx-font-size:20px;"/>
                            <VBox>
                                <Label text="Two-Factor Authentication" style="-fx-font-size:17px; -fx-font-weight:700;"/>
                                <Label text="Add an extra layer of security to your account" style="-fx-text-fill:#64748b;"/>
                            </VBox>
                        </HBox>
                        <VBox spacing="10.0" style="-fx-padding:16;">
                            <Label fx:id="twoFaStatusLabel" text="Your account is not protected with 2FA"
                                   style="-fx-text-fill:#854d0e; -fx-background-color:#FEF9C3; -fx-background-radius:10; -fx-padding:10;"/>
                            <Button fx:id="twoFaButton" text="Enable Two-Factor Authentication"
                                    style="-fx-background-color:#0FB5A9; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10;"
                                    onAction="#handleEnable2FA"/>
                        </VBox>
                    </VBox>

                    <!-- FACE AUTH -->
                    <VBox spacing="10.0"
                          style="-fx-background-color:#ffffff; -fx-background-radius:16; -fx-border-color:#E5E7EB; -fx-border-radius:16;">
                        <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding:16; -fx-border-color:#E5E7EB; -fx-border-width:0 0 1 0;">
                            <Label text="🧬" style="-fx-font-size:20px;"/>
                            <VBox>
                                <Label text="Face Authentication" style="-fx-font-size:17px; -fx-font-weight:700;"/>
                                <Label text="Login using your face instead of password" style="-fx-text-fill:#64748b;"/>
                            </VBox>
                        </HBox>
                        <VBox spacing="10.0" style="-fx-padding:16;">
                            <Label fx:id="faceAuthStatusLabel" text="Face ID is not set up"
                                style="-fx-text-fill:#854d0e; -fx-background-color:#FEF9C3; -fx-background-radius:10; -fx-padding:10;"/>
                            <Button fx:id="faceAuthButton" text="Register Face"
                                 style="-fx-background-color:#0FB5A9; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10;"
                                 onAction="#handleRegisterFace"/>
                        </VBox>
                    </VBox>

                    <!-- PASSWORD -->
                    <VBox spacing="10.0"
                          style="-fx-background-color:#ffffff; -fx-background-radius:16; -fx-border-color:#E5E7EB; -fx-border-radius:16;">
                        <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding:16; -fx-border-color:#E5E7EB; -fx-border-width:0 0 1 0;">
                            <Label text="🔑" style="-fx-font-size:20px;"/>
                            <VBox>
                                <Label text="Password" style="-fx-font-size:17px; -fx-font-weight:700;"/>
                                <Label text="Update your account password" style="-fx-text-fill:#64748b;"/>
                            </VBox>
                        </HBox>
                        <VBox spacing="10.0" style="-fx-padding:16;">
                            <Label text="Use a strong, unique password to keep your account secure."
                                   style="-fx-text-fill:#64748b;"/>
                            <Button text="Change Password"
                                    style="-fx-background-color:#dbeafe; -fx-text-fill:#1d4ed8; -fx-font-weight:700; -fx-background-radius:10;"
                                    onAction="#handleChangePassword"/>
                        </VBox>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
