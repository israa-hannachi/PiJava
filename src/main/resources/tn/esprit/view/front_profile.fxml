<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.front.FrontProfileController"
            prefWidth="1200.0" prefHeight="880.0"
            style="-fx-background-color:#FFFFFF; -fx-font-family:'Segoe UI';">

    <center>
        <StackPane>
            <VBox spacing="20.0" alignment="CENTER" maxWidth="1080.0" maxHeight="800.0">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <!-- Contenu principal ici -->
            </VBox>
        </StackPane>
    </center>

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="120.0" spacing="8.0"
              style="-fx-background-color:#F7FFFE; -fx-border-color:rgba(15,181,169,0.10); -fx-border-width:0 1 0 0;">
            <padding><Insets top="14.0" right="8.0" bottom="14.0" left="8.0"/></padding>

            <ImageView fitHeight="62.0" preserveRatio="true" pickOnBounds="true">
                <image><Image url="@/assets/images/logo.png"/></image>
            </ImageView>

            <Button text="🏠 Accueil" maxWidth="1.7976931348623157E308" onAction="#handleHome"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>
            <Button text="👤 Profil" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color:rgba(15,181,169,0.14); -fx-text-fill:#0FB5A9; -fx-font-weight:700; -fx-background-radius:10;"/>
            <Button text="📚 Cours" maxWidth="1.7976931348623157E308" onAction="#handleCours"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>
            <Button text="🎥 Meet" maxWidth="1.7976931348623157E308" onAction="#handleMeets"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>
            <Button text="🎮 Jeux" maxWidth="1.7976931348623157E308" onAction="#handleJeux"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>
            <Button text="📅 Events" maxWidth="1.7976931348623157E308" onAction="#handleEvents"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>
            <Button text="💬 Forums" maxWidth="1.7976931348623157E308" onAction="#handleForums"
                    style="-fx-background-color:transparent; -fx-text-fill:#64748b; -fx-background-radius:10;"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Logout" maxWidth="1.7976931348623157E308"
                    style="-fx-background-color:transparent; -fx-text-fill:#EF4444; -fx-font-weight:700; -fx-background-radius:10;"
                    onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- TOP NAV -->
    <top>
        <HBox spacing="12.0" alignment="CENTER_LEFT"
              style="-fx-background-color:#FFFFFF; -fx-border-color:rgba(15,181,169,0.12); -fx-border-width:0 0 1 0;">
            <padding><Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/></padding>

            <Label text="Naja7ni" style="-fx-font-size:24px; -fx-font-weight:800; -fx-text-fill:#0FB5A9;"/>
            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="searchField" promptText="Rechercher des cours, modules..." prefWidth="420.0"
                       style="-fx-background-color:#F7FFFE; -fx-background-radius:12; -fx-border-color:transparent; -fx-padding:10 14;"/>

            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🔔" style="-fx-background-color:#F1F5F9; -fx-background-radius:10;"/>
            <Button text="📅" style="-fx-background-color:#F1F5F9; -fx-background-radius:10;"/>
            <Button text="⚙" style="-fx-background-color:#F1F5F9; -fx-background-radius:10;"/>
            <Button text="Profile"
                    style="-fx-background-color:linear-gradient(to bottom right, #0FB5A9, #04B6D5); -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:999;"/>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background:#F0FFFE;">
            <content>
                <VBox spacing="18.0" style="-fx-background-color:#F0FFFE;">
                    <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>

                    <VBox spacing="6.0">
                        <Label text="Mon Profil" style="-fx-font-size:30px; -fx-font-weight:800; -fx-text-fill:#0f172a;"/>
                        <Label text="Gérez vos informations personnelles" style="-fx-text-fill:#64748b;"/>
                    </VBox>

                    <!-- PROFILE CARD -->
                    <VBox spacing="0.0" style="-fx-background-color:#ffffff; -fx-background-radius:16; -fx-border-color:#E5E7EB; -fx-border-radius:16;">
                        <!-- Cover -->
                        <StackPane prefHeight="130.0" style="-fx-background-color:linear-gradient(to right,#0FB5A9,#04B6D5); -fx-background-radius:16 16 0 0;">
                            <ImageView fx:id="coverImage" fitHeight="130.0" preserveRatio="false" pickOnBounds="true" visible="false"/>
                            <Button text="📷 Modifier la couverture" StackPane.alignment="TOP_RIGHT"
                                    style="-fx-background-color:rgba(255,255,255,0.22); -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10;">
                                <StackPane.margin><Insets top="12.0" right="12.0" bottom="0.0" left="0.0"/></StackPane.margin>
                            </Button>
                        </StackPane>

                        <VBox spacing="12.0" style="-fx-padding:20;">
                            <HBox spacing="16.0" alignment="CENTER_LEFT">
                                <StackPane>
                                    <Circle radius="64.0" style="-fx-fill:linear-gradient(to bottom right,#0FB5A9,#04B6D5);" />
                                    <ImageView fx:id="profileImage" fitWidth="128.0" fitHeight="128.0" preserveRatio="false" pickOnBounds="true"/>
                                    <Button text="📷" StackPane.alignment="BOTTOM_RIGHT"
                                            style="-fx-background-color:#FFFFFF; -fx-background-radius:999; -fx-border-color:#E5E7EB; -fx-border-radius:999;"/>
                                </StackPane>

                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label fx:id="fullNameLabel" text="FirstName LastName" style="-fx-font-size:24px; -fx-font-weight:800;"/>
                                    <Label fx:id="roleLabel" text="ROLE_USER" style="-fx-text-fill:#64748b;"/>
                                </VBox>

                                <Button text="💾 Enregistrer"
                                        style="-fx-background-color:#0FB5A9; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10;"
                                        onAction="#handleSaveProfile"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- INFO + CONTACT -->
                    <GridPane hgap="14.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0"/>
                            <ColumnConstraints percentWidth="50.0"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0" spacing="12.0"
                              style="-fx-background-color:#ffffff; -fx-background-radius:16; -fx-border-color:#E5E7EB; -fx-border-radius:16; -fx-padding:16;">
                            <Label text="👤 Informations Personnelles" style="-fx-font-size:18px; -fx-font-weight:700;"/>

                            <VBox spacing="6.0">
                                <Label text="Prénom" style="-fx-text-fill:#64748b; -fx-font-weight:700;"/>
                                <TextField fx:id="firstNameField" promptText="Prénom"
                                           style="-fx-background-color:#F7FFFE; -fx-background-radius:10; -fx-border-color:transparent; -fx-padding:10;"/>
                            </VBox>

                            <VBox spacing="6.0">
                                <Label text="Nom" style="-fx-text-fill:#64748b; -fx-font-weight:700;"/>
                                <TextField fx:id="lastNameField" promptText="Nom"
                                           style="-fx-background-color:#F7FFFE; -fx-background-radius:10; -fx-border-color:transparent; -fx-padding:10;"/>
                            </VBox>

                            <VBox spacing="6.0">
                                <Label text="Email" style="-fx-text-fill:#64748b; -fx-font-weight:700;"/>
                                <Label fx:id="emailLabel" text="email@example.com" style="-fx-text-fill:#475569;"/>
                            </VBox>

                            <VBox spacing="6.0">
                                <Label text="Role" style="-fx-text-fill:#64748b; -fx-font-weight:700;"/>
                                <Label fx:id="roleLabel2" text="ROLE_USER" style="-fx-text-fill:#475569;"/>
                            </VBox>
                        </VBox>

                        <VBox GridPane.columnIndex="1" spacing="12.0"
                              style="-fx-background-color:#ffffff; -fx-background-radius:16; -fx-border-color:#E5E7EB; -fx-border-radius:16; -fx-padding:16;">
                            <Label text="✉ Coordonnées" style="-fx-font-size:18px; -fx-font-weight:700;"/>

                            <HBox spacing="10.0" alignment="CENTER_LEFT"
                                  style="-fx-background-color:#F8FAFC; -fx-background-radius:10; -fx-padding:10;">
                                <Label text="✉" style="-fx-font-size:16px;"/>
                                <VBox>
                                    <Label text="Email" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
                                    <Label fx:id="emailLabel2" text="email@example.com"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </GridPane>

                    <!-- 2FA -->
                    <VBox spacing="10.0"
                          style="-fx-background-color:#ffffff; -fx-background-radius:16; -fx-border-color:#E5E7EB; -fx-border-radius:16;">
                        <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding:16; -fx-border-color:#E5E7EB; -fx-border-width:0 0 1 0;">
                            <Label text="🛡" style="-fx-font-size:20px;"/>
                            <VBox>
                                <Label text="Two-Factor Authentication" style="-fx-font-size:17px; -fx-font-weight:700;"/>
                                <Label text="Add an extra layer of security to your account" style="-fx-text-fill:#64748b;"/>
                            </VBox>
                        </HBox>
                        <VBox spacing="10.0" style="-fx-padding:16;">
                            <Label text="Your account is not protected with 2FA"
                                   style="-fx-text-fill:#854d0e; -fx-background-color:#FEF9C3; -fx-background-radius:10; -fx-padding:10;"/>
                            <Button text="Enable Two-Factor Authentication"
                                    style="-fx-background-color:#0FB5A9; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10;"
                                    onAction="#handleEnable2FA"/>
                        </VBox>
                    </VBox>

                    <!-- FACE AUTH -->
                    <VBox spacing="10.0"
                          style="-fx-background-color:#ffffff; -fx-background-radius:16; -fx-border-color:#E5E7EB; -fx-border-radius:16;">
                        <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding:16; -fx-border-color:#E5E7EB; -fx-border-width:0 0 1 0;">
                            <Label text="🧬" style="-fx-font-size:20px;"/>
                            <VBox>
                                <Label text="Face Authentication" style="-fx-font-size:17px; -fx-font-weight:700;"/>
                                <Label text="Login using your face instead of password" style="-fx-text-fill:#64748b;"/>
                            </VBox>
                        </HBox>
                        <VBox spacing="10.0" style="-fx-padding:16;">
                            <Label text="Face ID is not set up"
                                   style="-fx-text-fill:#854d0e; -fx-background-color:#FEF9C3; -fx-background-radius:10; -fx-padding:10;"/>
                            <Button text="Register Face"
                                    style="-fx-background-color:#0FB5A9; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10;"
                                    onAction="#handleRegisterFace"/>
                        </VBox>
                    </VBox>

                    <!-- PASSWORD -->
                    <VBox spacing="10.0"
                          style="-fx-background-color:#ffffff; -fx-background-radius:16; -fx-border-color:#E5E7EB; -fx-border-radius:16;">
                        <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding:16; -fx-border-color:#E5E7EB; -fx-border-width:0 0 1 0;">
                            <Label text="🔑" style="-fx-font-size:20px;"/>
                            <VBox>
                                <Label text="Password" style="-fx-font-size:17px; -fx-font-weight:700;"/>
                                <Label text="Update your account password" style="-fx-text-fill:#64748b;"/>
                            </VBox>
                        </HBox>
                        <VBox spacing="10.0" style="-fx-padding:16;">
                            <Label text="Use a strong, unique password to keep your account secure."
                                   style="-fx-text-fill:#64748b;"/>
                            <Button text="Change Password"
                                    style="-fx-background-color:#dbeafe; -fx-text-fill:#1d4ed8; -fx-font-weight:700; -fx-background-radius:10;"
                                    onAction="#handleChangePassword"/>
                        </VBox>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>

