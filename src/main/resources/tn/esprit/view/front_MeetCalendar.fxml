<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.front.FrontMeetCalendarController"
            prefWidth="1440.0" prefHeight="980.0"
            style="-fx-background-color:#FFFFFF; -fx-font-family:'Segoe UI';">

    <left>
        <VBox prefWidth="250.0" spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 2, 0);">
            <padding><Insets top="20.0" right="15.0" bottom="20.0" left="15.0"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <ImageView fitWidth="180.0" preserveRatio="true" pickOnBounds="true">
                    <image><Image url="@/assets/images/logo.png"/></image>
                </ImageView>
            </HBox>

            <Region prefHeight="20"/>

            <Button text="🏠 Accueil" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleHome"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight:600; -fx-background-radius:10; -fx-padding:12 15; -fx-font-size:15; -fx-cursor:hand;"/>
            <Button text="👤 Profil" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleProfile"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight:600; -fx-background-radius:10; -fx-padding:12 15; -fx-font-size:15; -fx-cursor:hand;"/>
            <Button text="📚 Cours" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleCours"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight:600; -fx-background-radius:10; -fx-padding:12 15; -fx-font-size:15; -fx-cursor:hand;"/>
            <Button text="🎥 Meet" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleMeets"
                    style="-fx-background-color:linear-gradient(to right, rgba(15,181,169,0.1), rgba(15,181,169,0.05)); -fx-text-fill:#0FB5A9; -fx-font-weight:700; -fx-background-radius:10; -fx-padding:12 15; -fx-font-size:15; -fx-border-color:#0FB5A9; -fx-border-width:0 0 0 4; -fx-border-radius:10;"/>
            <Button text="🎮 Jeux" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleJeux"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight:600; -fx-background-radius:10; -fx-padding:12 15; -fx-font-size:15; -fx-cursor:hand;"/>
            <Button text="📅 Events" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleEvents"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight:600; -fx-background-radius:10; -fx-padding:12 15; -fx-font-size:15; -fx-cursor:hand;"/>
            <Button text="💬 Forums" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleForums"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight:600; -fx-background-radius:10; -fx-padding:12 15; -fx-font-size:15; -fx-cursor:hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="10" style="-fx-background-color:linear-gradient(to bottom right, #0FB5A9, #04B6D5); -fx-background-radius:15; -fx-padding:20;">
                <Label text="Need Help?" style="-fx-font-weight:bold; -fx-text-fill:white; -fx-font-size:16;"/>
                <Label text="Check our docs or contact support." style="-fx-text-fill:rgba(255,255,255,0.9); -fx-wrap-text:true;"/>
                <Button text="Support" style="-fx-background-color:white; -fx-text-fill:#0FB5A9; -fx-font-weight:bold; -fx-background-radius:8; -fx-padding:8 15; -fx-cursor:hand;"/>
            </VBox>

            <Button text="🚪 Logout" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT"
                    style="-fx-background-color:#FEF2F2; -fx-text-fill:#EF4444; -fx-font-weight:700; -fx-background-radius:10; -fx-padding:10 15; -fx-font-size:14; -fx-cursor:hand;"
                    onAction="#handleLogout"/>
        </VBox>
    </left>

    <top>
        <HBox spacing="12.0" alignment="CENTER_LEFT"
              style="-fx-background-color:#FFFFFF; -fx-border-color:rgba(15,181,169,0.12); -fx-border-width:0 0 1 0;">
            <padding><Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/></padding>

            <Label text="Calendrier des Meets"
                   style="-fx-font-size:24px; -fx-font-weight:800; -fx-text-fill:#0FB5A9;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="◀" onAction="#handlePrevMonth"
                    style="-fx-background-color:white; -fx-border-color:#e2e8f0; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:8 16; -fx-font-size:16; -fx-cursor:hand;"/>
            <Label fx:id="monthYearLabel" text=""
                   style="-fx-font-size:18px; -fx-font-weight:800; -fx-text-fill:#1f2937; -fx-min-width:180; -fx-alignment:CENTER;"/>
            <Button text="▶" onAction="#handleNextMonth"
                    style="-fx-background-color:white; -fx-border-color:#e2e8f0; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:8 16; -fx-font-size:16; -fx-cursor:hand;"/>
            <Button text="Aujourd'hui" onAction="#handleToday"
                    style="-fx-background-color:rgba(15,181,169,0.1); -fx-text-fill:#0FB5A9; -fx-font-weight:700; -fx-background-radius:10; -fx-border-color:#0FB5A9; -fx-border-radius:10; -fx-padding:8 18; -fx-cursor:hand;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="📋 Vue Liste" onAction="#handleMeetList"
                    style="-fx-background-color:white; -fx-border-color:#e2e8f0; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:8 16; -fx-font-weight:700; -fx-text-fill:#334155; -fx-cursor:hand;"/>

            <Button fx:id="addMeetBtn" text="✨ Nouveau Meet" onAction="#handleAddMeet" visible="false" managed="false"
                    style="-fx-background-color:#0FB5A9; -fx-text-fill:white; -fx-font-weight:800; -fx-background-radius:12; -fx-padding:10 20; -fx-cursor:hand; -fx-effect: dropshadow(gaussian, rgba(15,181,169,0.3), 10, 0, 0, 4);"/>

            <Button fx:id="profileButton" text="Profil" onAction="#handleProfile"
                    style="-fx-background-color:linear-gradient(to bottom right, #0FB5A9, #04B6D5); -fx-text-fill:white; -fx-font-weight:800; -fx-background-radius:999; -fx-padding:10 20; -fx-cursor:hand; -fx-effect: dropshadow(gaussian, rgba(15,181,169,0.3), 10, 0, 0, 4);"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="0" style="-fx-background-color:#F0FFFE;">

            <HBox spacing="16" style="-fx-padding:16 28 0 28;">
                <VBox spacing="4" prefWidth="180"
                      style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:16 20; -fx-border-color:rgba(15,181,169,0.15); -fx-border-radius:16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <Label text="Ce mois" style="-fx-text-fill:#64748b; -fx-font-size:12; -fx-font-weight:600;"/>
                    <Label fx:id="statsMoisLabel" text="0 session(s)"
                           style="-fx-font-size:20; -fx-font-weight:900; -fx-text-fill:#0FB5A9;"/>
                </VBox>
                <VBox spacing="4" prefWidth="180"
                      style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:16 20; -fx-border-color:rgba(15,181,169,0.15); -fx-border-radius:16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <Label text="À venir" style="-fx-text-fill:#64748b; -fx-font-size:12; -fx-font-weight:600;"/>
                    <Label fx:id="statsAVenirLabel" text="0 session(s)"
                           style="-fx-font-size:20; -fx-font-weight:900; -fx-text-fill:#6366f1;"/>
                </VBox>
                <VBox spacing="4" prefWidth="180"
                      style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:16 20; -fx-border-color:rgba(15,181,169,0.15); -fx-border-radius:16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <Label text="Sélectionné" style="-fx-text-fill:#64748b; -fx-font-size:12; -fx-font-weight:600;"/>
                    <Label fx:id="statsSelectedLabel" text="Aucun jour"
                           style="-fx-font-size:16; -fx-font-weight:800; -fx-text-fill:#1f2937;"/>
                </VBox>
                <Label fx:id="profBadge" text="👨‍🏫 Mode Enseignant" visible="false" managed="false"
                       style="-fx-background-color:rgba(99,102,241,0.1); -fx-text-fill:#6366f1; -fx-font-weight:800; -fx-background-radius:12; -fx-padding:12 20; -fx-font-size:13; -fx-border-color:rgba(99,102,241,0.3); -fx-border-radius:12;"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox spacing="16" VBox.vgrow="ALWAYS" style="-fx-padding:16 28 28 28;">

                <VBox spacing="0" HBox.hgrow="ALWAYS"
                      style="-fx-background-color:white; -fx-background-radius:20; -fx-border-color:rgba(15,181,169,0.15); -fx-border-radius:20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 18, 0, 0, 8);">

                    <GridPane style="-fx-background-color:linear-gradient(to right, #0FB5A9, #04B6D5); -fx-background-radius:20 20 0 0; -fx-padding:14 10;">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                            <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                            <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                            <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                            <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                            <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                            <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                        </columnConstraints>
                        <Label text="Lun" GridPane.columnIndex="0" style="-fx-font-weight:800; -fx-text-fill:white; -fx-font-size:13;"/>
                        <Label text="Mar" GridPane.columnIndex="1" style="-fx-font-weight:800; -fx-text-fill:white; -fx-font-size:13;"/>
                        <Label text="Mer" GridPane.columnIndex="2" style="-fx-font-weight:800; -fx-text-fill:white; -fx-font-size:13;"/>
                        <Label text="Jeu" GridPane.columnIndex="3" style="-fx-font-weight:800; -fx-text-fill:white; -fx-font-size:13;"/>
                        <Label text="Ven" GridPane.columnIndex="4" style="-fx-font-weight:800; -fx-text-fill:white; -fx-font-size:13;"/>
                        <Label text="Sam" GridPane.columnIndex="5" style="-fx-font-weight:800; -fx-text-fill:rgba(255,255,255,0.7); -fx-font-size:13;"/>
                        <Label text="Dim" GridPane.columnIndex="6" style="-fx-font-weight:800; -fx-text-fill:rgba(255,255,255,0.7); -fx-font-size:13;"/>
                    </GridPane>

                    <GridPane fx:id="calendarGrid" VBox.vgrow="ALWAYS" style="-fx-padding:8; -fx-hgap:4; -fx-vgap:4;">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                            <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                            <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                            <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                            <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                            <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                            <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                        </columnConstraints>
                    </GridPane>
                </VBox>

                <VBox prefWidth="340" spacing="14"
                      style="-fx-background-color:white; -fx-background-radius:20; -fx-padding:24; -fx-border-color:rgba(15,181,169,0.15); -fx-border-radius:20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 18, 0, 0, 8);">

                    <Label fx:id="detailDayLabel" text="Sélectionnez un jour" style="-fx-font-size:17px; -fx-font-weight:900; -fx-text-fill:#1f2937;"/>
                    <Label text="Sessions prévues :" style="-fx-text-fill:#64748b; -fx-font-size:13; -fx-font-weight:600;"/>

                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background-color:transparent; -fx-background:#F0FFFE; -fx-border-color:transparent;">
                        <VBox fx:id="detailContainer" spacing="12"/>
                    </ScrollPane>

                    <VBox fx:id="detailEmpty" alignment="CENTER" spacing="8" style="-fx-padding:20 0;">
                        <Label text="📅" style="-fx-font-size:36;"/>
                        <Label text="Aucune session ce jour." style="-fx-text-fill:#94a3b8; -fx-font-size:14; -fx-font-weight:600;"/>
                        <Button fx:id="addFromDetailBtn" text="+ Planifier ici" onAction="#handleAddMeet" visible="false" managed="false"
                                style="-fx-background-color:#0FB5A9; -fx-text-fill:white; -fx-font-weight:700; -fx-background-radius:10; -fx-padding:8 20; -fx-cursor:hand;"/>
                    </VBox>
                </VBox>

            </HBox>
        </VBox>
    </center>

</BorderPane>
