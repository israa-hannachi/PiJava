<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.front.FrontMeetRoomController"
            prefWidth="1440.0" prefHeight="980.0"
            style="-fx-background-color:#FFFFFF; -fx-font-family:'Segoe UI';">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="250.0" spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 2, 0);">
            <padding><Insets top="20.0" right="15.0" bottom="20.0" left="15.0"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <ImageView fitWidth="180.0" preserveRatio="true" pickOnBounds="true">
                    <image><Image url="@/assets/images/logo.png"/></image>
                </ImageView>
            </HBox>

            <Region prefHeight="20"/>

            <Button text="🏠 Accueil" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleHome"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight:600; -fx-background-radius:10; -fx-padding:12 15; -fx-font-size:15; -fx-cursor:hand;"/>
            <Button text="👤 Profil" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleProfile"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight:600; -fx-background-radius:10; -fx-padding:12 15; -fx-font-size:15; -fx-cursor:hand;"/>
            <Button text="📚 Cours" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleCours"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight:600; -fx-background-radius:10; -fx-padding:12 15; -fx-font-size:15; -fx-cursor:hand;"/>
            <Button text="🎥 Meet" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleMeets"
                    style="-fx-background-color:linear-gradient(to right, rgba(15,181,169,0.1), rgba(15,181,169,0.05)); -fx-text-fill:#0FB5A9; -fx-font-weight:700; -fx-background-radius:10; -fx-padding:12 15; -fx-font-size:15; -fx-border-color:#0FB5A9; -fx-border-width:0 0 0 4; -fx-border-radius:10;"/>
            <Button text="🎮 Jeux" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleJeux"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight:600; -fx-background-radius:10; -fx-padding:12 15; -fx-font-size:15; -fx-cursor:hand;"/>
            <Button text="📅 Events" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleEvents"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight:600; -fx-background-radius:10; -fx-padding:12 15; -fx-font-size:15; -fx-cursor:hand;"/>
            <Button text="💬 Forums" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleForums"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight:600; -fx-background-radius:10; -fx-padding:12 15; -fx-font-size:15; -fx-cursor:hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="10" style="-fx-background-color:linear-gradient(to bottom right, #0FB5A9, #04B6D5); -fx-background-radius:15; -fx-padding:20;">
                <Label text="Need Help?" style="-fx-font-weight:bold; -fx-text-fill:white; -fx-font-size:16;"/>
                <Label text="Check our docs or contact support." style="-fx-text-fill:rgba(255,255,255,0.9); -fx-wrap-text:true;"/>
                <Button text="Support" style="-fx-background-color:white; -fx-text-fill:#0FB5A9; -fx-font-weight:bold; -fx-background-radius:8; -fx-padding:8 15; -fx-cursor:hand;"/>
            </VBox>
        </VBox>
    </left>

    <!-- TOP BAR -->
    <top>
        <HBox spacing="12.0" alignment="CENTER_LEFT"
              style="-fx-background-color:#FFFFFF; -fx-border-color:rgba(15,181,169,0.12); -fx-border-width:0 0 1 0;">
            <padding><Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/></padding>
            <Button text="← Retour aux Meets" onAction="#handleBackToList"
                    style="-fx-background-color:white; -fx-border-color:#e2e8f0; -fx-border-radius:12; -fx-background-radius:12; -fx-padding:8 16; -fx-font-weight:700; -fx-text-fill:#475569; -fx-cursor:hand;"/>
            <Label fx:id="meetTitleLabel" text="Réunion"
                   style="-fx-font-size:20px; -fx-font-weight:800; -fx-text-fill:#0FB5A9;"/>
            <Label fx:id="meetStatusLabel" text=""
                   style="-fx-background-color:#dcfce7; -fx-text-fill:#166534; -fx-background-radius:12; -fx-padding:4 14; -fx-font-weight:800; -fx-font-size:12;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="connectedAsLabel" text=""
                   style="-fx-text-fill:#0FB5A9; -fx-font-weight:700; -fx-font-size:12;
                          -fx-background-color:rgba(15,181,169,0.08); -fx-background-radius:20; -fx-padding:6 14;"/>
            <Button text="🔴 Quitter" onAction="#handleBackToList"
                    style="-fx-background-color:#fee2e2; -fx-text-fill:#dc2626; -fx-background-radius:12; -fx-padding:8 16; -fx-font-weight:700; -fx-cursor:hand;"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <HBox>
            <!-- CENTER : Placeholder for the JCEF overlay window -->
            <StackPane fx:id="browserContainer" HBox.hgrow="ALWAYS"
                       style="-fx-background-color:#1a1a2e;">
                <VBox fx:id="loadingOverlay" alignment="CENTER" spacing="16"
                      style="-fx-background-color: linear-gradient(to bottom, #0f172a, #1e293b);">
                    <Label text="⏳" style="-fx-font-size:48;"/>
                    <Label text="Chargement du Meet..."
                           style="-fx-font-size:20; -fx-font-weight:800; -fx-text-fill:white;"/>
                    <Label fx:id="loadingStatusLabel" text="Initialisation..."
                           style="-fx-font-size:12; -fx-text-fill:#64748b;"/>
                    <ProgressIndicator prefWidth="40" prefHeight="40"/>
                </VBox>
            </StackPane>

            <!-- Right Info Panel -->
            <VBox prefWidth="260" spacing="14"
                  style="-fx-background-color:#F8FAFC; -fx-border-color:rgba(15,181,169,0.12); -fx-border-width:0 0 0 1;">
                <padding><Insets top="18" right="14" bottom="18" left="14"/></padding>

                <VBox spacing="10"
                      style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:14;
                             -fx-border-color:rgba(15,181,169,0.15); -fx-border-radius:16;">
                    <Label text="📋 Détails" style="-fx-font-size:13; -fx-font-weight:800; -fx-text-fill:#1f2937;"/>
                    <Label fx:id="infoTitleLabel" text="" wrapText="true"
                           style="-fx-font-size:15; -fx-font-weight:900; -fx-text-fill:#0FB5A9;"/>
                    <Label fx:id="infoDescLabel" text="" wrapText="true"
                           style="-fx-font-size:11; -fx-text-fill:#64748b;"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="🕐" style="-fx-font-size:13;"/>
                        <Label fx:id="infoTimeLabel" text=""
                               style="-fx-font-size:11; -fx-font-weight:700; -fx-text-fill:#475569;"/>
                    </HBox>
                </VBox>

                <!-- Concentration Panel -->
                <VBox spacing="10"
                      style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:14;
                             -fx-border-color:rgba(15,181,169,0.15); -fx-border-radius:16;">
                    <Label text="🧠 Concentration (IA)" style="-fx-font-size:13; -fx-font-weight:800; -fx-text-fill:#1f2937;"/>
                    <ProgressBar fx:id="concentrationBar" progress="0.0" maxWidth="Infinity" prefHeight="10"
                                 style="-fx-accent: #0FB5A9;"/>
                    <Label fx:id="concentrationStatusLabel" text="Analyse en attente..."
                           style="-fx-font-size:10; -fx-text-fill:#64748b; -fx-font-weight:600;"/>
                </VBox>

                <VBox spacing="8" VBox.vgrow="ALWAYS"
                      style="-fx-background-color:white; -fx-background-radius:16; -fx-padding:14;
                             -fx-border-color:rgba(15,181,169,0.15); -fx-border-radius:16;">
                    <Label text="👥 Participants" style="-fx-font-size:13; -fx-font-weight:800; -fx-text-fill:#1f2937;"/>
                    <Label fx:id="participantCountLabel" text="0 participant(s)"
                           style="-fx-font-size:10; -fx-text-fill:#94a3b8; -fx-font-weight:600;"/>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background-color:transparent; -fx-background:transparent; -fx-border-color:transparent;">
                        <VBox fx:id="participantListBox" spacing="6"/>
                    </ScrollPane>
                </VBox>

                <Button text="📋 Copier le lien" onAction="#handleCopyLink" maxWidth="Infinity"
                        style="-fx-background-color:white; -fx-text-fill:#475569; -fx-font-weight:600;
                               -fx-background-radius:8; -fx-padding:6 12; -fx-font-size:10;
                               -fx-border-color:#e2e8f0; -fx-border-radius:8; -fx-cursor:hand;"/>
            </VBox>
        </HBox>
    </center>

</BorderPane>
