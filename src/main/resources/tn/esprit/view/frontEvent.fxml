<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.front.EventFrontController"
            prefWidth="1440.0" prefHeight="980.0"
            style="-fx-background-color: #FFFFFF; -fx-font-family: 'Segoe UI';"
            stylesheets="@/tn/esprit/css/front-home.css">

    <left>
        <VBox prefWidth="250.0" spacing="12.0"
              style="-fx-background-color: #FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 2, 0);">
            <padding><Insets top="20.0" right="15.0" bottom="20.0" left="15.0"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <ImageView fitWidth="180.0" preserveRatio="true" pickOnBounds="true">
                    <image><Image url="@/assets/images/logo.png"/></image>
                </ImageView>
            </HBox>
            
            <Region prefHeight="20"/>

            <Button text="🏠 Accueil" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleHome"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>
            
            <Button text="👤 Profil" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleProfile"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>
            
            <Button text="📚 Cours" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleCours"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>
            
            <Button text="🎥 Meet" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleMeets"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>
            <Button text="🎮 Jeux" onAction="#handleGameList" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>
            
            <Button text="📅 Events" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT"
                    style="-fx-background-color: linear-gradient(to right, rgba(15,181,169,0.1), rgba(15,181,169,0.05)); -fx-text-fill:#0FB5A9; -fx-font-weight:700; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-border-color: #0FB5A9; -fx-border-width: 0 0 0 4; -fx-border-radius: 10;"/>

            <Button text="💬 Forums" maxWidth="1.7976931348623157E308" alignment="BASELINE_LEFT" onAction="#handleForums"
                    style="-fx-background-color:transparent; -fx-text-fill:#4B5563; -fx-font-weight: 600; -fx-background-radius:10; -fx-padding: 12 15; -fx-font-size: 15; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>
            
            <VBox spacing="10" style="-fx-background-color: linear-gradient(to bottom right, #0FB5A9, #04B6D5); -fx-background-radius: 15; -fx-padding: 20;">
                <Label text="Need Help?" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 16;"/>
                <Label text="Check our docs or contact support." style="-fx-text-fill: rgba(255,255,255,0.9); -fx-wrap-text: true;"/>
                <Button text="Support" style="-fx-background-color: white; -fx-text-fill: #0FB5A9; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 15; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox spacing="15.0" alignment="CENTER_LEFT"
              style="-fx-background-color:#FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
            <padding><Insets top="15.0" right="30.0" bottom="15.0" left="30.0"/></padding>

            <Label text="Événements &amp; Ateliers" style="-fx-font-size:22px; -fx-font-weight:700; -fx-text-fill:#1F2937;" />

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="searchBar" promptText="Rechercher des événements..." prefWidth="350.0"
                       style="-fx-background-color:white; -fx-background-radius:12; -fx-border-color:#E2E8F0; -fx-border-radius:12; -fx-padding:10 20; -fx-font-size: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 2);" />

            <Region HBox.hgrow="ALWAYS"/>
                
            <HBox spacing="18.0" alignment="CENTER_RIGHT">
                <Button fx:id="adminButton" text="⚙ Back Office" onAction="#handleBackOffice"
                        visible="false" managed="false"
                        style="-fx-background-color:#1E293B; -fx-text-fill:#F87171; -fx-font-weight:700; -fx-background-radius:10; -fx-padding:10 18; -fx-font-size: 13; -fx-cursor: hand;" />

                <Button onAction="#handleProfile" 
                        style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
                    <graphic>
                        <StackPane style="-fx-padding: 2; -fx-background-color: linear-gradient(to bottom right, #0FB5A9, #04B6D5); -fx-background-radius: 999;">
                             <ImageView fx:id="profileImageView" fitWidth="40" fitHeight="40" preserveRatio="false" />
                        </StackPane>
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <center>
        <AnchorPane style="-fx-background-color: #F0FFFE;">
            <children>
                <!-- Bloc réservation à gauche -->
                <VBox layoutX="25.0" layoutY="25.0" prefWidth="350.0" spacing="15.0" 
                      style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 10);">
                    
                    <Label text="🎟️ Réservation" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #1e293b;" />
                    
                    <!-- Sélection Preview Area -->
                    <VBox fx:id="selectedEventPreview" spacing="10" 
                          style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                        <Label text="Aucun événement sélectionné" style="-fx-text-fill: #64748b; -fx-font-style: italic;" />
                    </VBox>

                    <VBox spacing="12">
                        <VBox spacing="5">
                            <Label text="Nom Complet" style="-fx-font-weight: 700; -fx-text-fill: #475569;" />
                            <TextField fx:id="visitorName" promptText="Ex: Jean Dupont" styleClass="modern-textfield" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Email Professionnel" style="-fx-font-weight: 700; -fx-text-fill: #475569;" />
                            <TextField fx:id="visitorEmail" promptText="exemple@domain.com" styleClass="modern-textfield" />
                        </VBox>
                        <HBox spacing="10">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Tickets" style="-fx-font-weight: 700; -fx-text-fill: #475569;" />
                                <TextField fx:id="nbrTickets" promptText="0" styleClass="modern-textfield" />
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Téléphone" style="-fx-font-weight: 700; -fx-text-fill: #475569;" />
                                <TextField fx:id="numTel" promptText="XXXXXXXX" styleClass="modern-textfield" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <Button onAction="#reserver" maxWidth="1.7976931348623157E308" 
                            style="-fx-background-color: linear-gradient(to right, #0FB5A9, #0891b2); -fx-text-fill: white; -fx-font-weight: 800; -fx-padding: 14; -fx-background-radius: 12; -fx-cursor: hand;" 
                            text="Confirmer la Réservation" />
                    
                    <Label fx:id="feedbackLabel" style="-fx-font-size: 13px; -fx-font-weight: 500;" wrapText="true" />
                    
                    <Separator style="-fx-opacity: 0.5;" />
                    
                    <Label style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #1e293b;" text="🤝 Partenaires Officiels" />
                    <FlowPane fx:id="sponsorContainer" hgap="8.0" prefWrapLength="280.0" vgap="8.0" />
                    
                    <Button onAction="#openWebPageCit" maxWidth="1.7976931348623157E308" 
                            style="-fx-background-color: #f5f3ff; -fx-text-fill: #7c3aed; -fx-font-weight: 700; -fx-background-radius: 10; -fx-border-color: #ddd6fe; -fx-border-radius: 10;" 
                            text="📅 Ajouter au Calendrier">
                    </Button>
                </VBox>

                <!-- Zone principale : Events -->
                <VBox layoutX="400.0" layoutY="25.0" prefWidth="990.0" spacing="20">
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox spacing="5">
                            <Label text="🎉 Explorez nos événements" style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-text-fill: #0f172a;" />
                            <Label text="Ne manquez pas les opportunités d'apprendre avec nos experts." style="-fx-font-size: 16px; -fx-text-fill: #64748b;" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#voirTickets" style="-fx-background-color: white; -fx-border-color: #0FB5A9; -fx-border-radius: 20; -fx-background-radius: 20; -fx-text-fill: #0FB5A9; -fx-font-weight: bold; -fx-padding: 8 20;" text="🎫 Mes Tickets" />
                    </HBox>

                    <!-- Section Recommandations (Collapsible) -->
                    <VBox fx:id="forYouBox" managed="false" spacing="15" 
                          style="-fx-background-color: linear-gradient(to right, #ffffff, #f0f9ff); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: #0FB5A9; -fx-border-width: 1; -fx-border-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(15,181,169,0.1), 15, 0, 0, 5);" 
                          visible="false">
                        <Label fx:id="labelForYou" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #0FB5A9;" text="✨ Recommandations personnalisées" />
                        <FlowPane fx:id="recommendedEventContainer" hgap="20.0" prefWrapLength="930.0" vgap="20.0" />
                    </VBox>

                    <!-- Events Loader & Pagination -->
                    <VBox spacing="30" VBox.vgrow="ALWAYS">
                        <FlowPane fx:id="eventContainer" hgap="25.0" prefWrapLength="950.0" vgap="25.0" />
                        
                        <HBox alignment="CENTER" style="-fx-padding: 20 0;">
                            <Pagination fx:id="pagination" maxPageIndicatorCount="5" pageCount="1" />
                        </HBox>
                    </VBox>
                </VBox>
            </children>
        </AnchorPane>
    </center>

</BorderPane>